// `PanelComponent`: one complete view (tab strip, navigation, columns,
// rows, footer). Instantiated once per view by `MainWindow`.

import { PanelView, Strings } from "structs.slint";
import { Dismiss, Note, Theme, Tokens, WindowFocus } from "theme.slint";
import { DragEdgeScroller, VTabBar } from "widgets/tabs.slint";
import { ColumnHeader, FileRowView, FileTileView, SectionHeaderView } from "widgets/rows.slint";
import { FilterBar } from "widgets/inputs.slint";
import { PanelTabsBar } from "panel/tabs_bar.slint";
import { PanelNavBar } from "panel/nav_bar.slint";
import { PanelSelection } from "panel/selection.slint";

export component PanelComponent inherits Rectangle {
    // IMPORTANT: `preferred-width: 0` is necessary for the splitter
    // to move pixel-perfectly with the mouse. Without it, Slint reserves the
    // "natural" preferred-width (tab strip + breadcrumb + etc.) for each
    // panel BEFORE distributing the rest via stretch, and dragging the
    // splitter only changes the "rest", which makes the movement
    // ~50% slower than the mouse.
    preferred-width: 0px;
    min-width: 0px;
    max-width: 99999px;

    in property <PanelView> view;
    // Footer text ("N selected / M items") DECOUPLED from
    // `view`: the selection count changes on every rubber-band step;
    // if it lived in `PanelView`, updating it would rewrite the whole struct
    // (via `set_row_data` on the panels model) and invalidate the Repeater's
    // `rendered-rows` model property → selection changes would no longer be
    // rendered in place until a re-list happens (hence the "skipped"
    // entries until a scroll). Driven separately via
    // `panel-footers[idx]`, it never invalidates the list anymore.
    in property <string> footer-text;
    in property <bool> active;
    in property <bool> can-close: false;
    in property <Strings> strings;
    // Column widths SPECIFIC to this panel: initialized from the model
    // (`view`), mutated locally by the header grips. On resize end,
    // `column-resized(id, width)` reports it to the bridge (which stores it per panel
    // to survive model rebuilds). GENERIC callback per column
    // → no tuple that needs to grow with every new column.
    in-out property <length> col-name-width: root.view.col-name-w;
    in-out property <length> col-path-width: root.view.col-path-w;
    in-out property <length> col-size-width: root.view.col-size-w;
    in-out property <length> col-modified-width: root.view.col-modified-w;
    in-out property <length> col-ext-width: root.view.col-ext-w;
    in-out property <length> col-resolution-width: root.view.col-resolution-w;
    in-out property <length> col-depth-width: root.view.col-depth-w;
    in-out property <length> col-age-width: root.view.col-age-w;
    callback column-resized(string /*id*/, length /*width*/);
    // check/uncheck a column (id, visible) + right-click header.
    callback column-toggle(string, bool);
    callback open-columns-menu(length, length);   // absolute position
    // Reordering: column identifier and signed delta in pixels.
    callback column-moved(string, int);
    // type-ahead filter — current text (shown if view is active) + reset.
    in property <string> filter-text: "";
    callback filter-clear();
    // Exact vertical viewport (content coordinate + visible height). The
    // bridge adjusts the small rendered window and thumbnail priority.
    callback rows-viewport-changed(length /*top*/, length /*height*/);
    // Vertical hit-test in the rows' variable geometry. The bridge does
    // a binary search in `FileRow.visual-y/visual-h`.
    callback row-at-content-y(length /*content y*/) -> int;
    // extension filter — bar's close button (disables the mode). TYPING
    // goes through filter-type/backspace (shared with type-ahead), not here.
    callback ext-filter-toggle();
    // current tab bar scroll (viewport-x, plain) —
    // reported to the bridge via `panel-tabs-scrolled(idx, vx)`.
    callback tabs-scrolled(length);
    property <bool> col-drag-active: false;
    property <length> col-drag-center: 0px;   // center of the dragged column (plain)
    property <length> col-drag-delta: 0px;
    property <int> col-drop-idx: -1;
    property <string> col-drag-id: "";

    // Width of a column by its id. All resizable.
    function width-of(id: string) -> length {
        id == "path" ? root.col-path-width
            : id == "size" ? root.col-size-width
            : id == "modified" ? root.col-modified-width
            : id == "ext" ? root.col-ext-width
            : id == "resolution" ? root.col-resolution-width
            : id == "depth" ? root.col-depth-width
            : id == "age" ? root.col-age-width
            : root.col-name-width;
    }
    // Applies a width to the right property (live resize, `for`-compatible).
    function set-col-width(id: string, w: length) {
        if (id == "path") { root.col-path-width = w; }
        else if (id == "size") { root.col-size-width = w; }
        else if (id == "modified") { root.col-modified-width = w; }
        else if (id == "ext") { root.col-ext-width = w; }
        else if (id == "resolution") { root.col-resolution-width = w; }
        else if (id == "depth") { root.col-depth-width = w; }
        else if (id == "age") { root.col-age-width = w; }
        else { root.col-name-width = w; }
    }

    // Path bar edit mode: false = clickable breadcrumbs,
    // true = TextInput. Local to the panel, toggled by clicking empty area / Enter / Escape.
    in-out property <bool> path-edit-mode: false;
    // Ctrl+L: counter propagated from MainWindow. On its change, the
    // ACTIVE panel enters edit mode (the TextInput auto-focuses via its `init`),
    // exactly like clicking the breadcrumb's empty area.
    in property <int> address-focus-gen;
    changed address-focus-gen => {
        if (root.active) {
            root.url-edit-text = root.view.current-path;
            root.path-edit-mode = true;
        }
    }

    // === Tab drag: preview handled locally in Slint ===
    /// Global "a drag is in progress" flag propagated from MainWindow to
    /// **all** PanelComponents — lets each panel compute
    /// ITS OWN preview, and thus display the line in the cross-view
    /// target panel.
    in property <bool> drag-active: false;
    // A real tab and a directory location can target panel zones. A favorite
    // pointing to a file remains limited to tab gaps.
    in property <bool> drag-panel-zones: true;
    // Center remains an append target even when no new panel can be created;
    // edge previews must reflect the actual split capacity.
    in property <bool> drag-panel-split-edges: true;
    /// Absolute X position of the mouse during the drag (propagated from
    /// MainWindow). Each panel compares it with its tabs-row to know
    /// whether the mouse is within its tab zone.
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;
    /// "Full path" tooltip on tab hover — opt-in
    /// (global setting), propagated to tabs of both orientations.
    in property <bool> tab-tooltip-enabled: false;

    // ===== Dragging this VIEW, to swap it with another =====
    // Its own channel, parallel to the tab drag: the two gestures start from
    // different pixels — a tab, versus the grip in the nav bar — so they never
    // overlap and neither has to arbitrate for the other.
    callback view-drag-progress(/* abs_x */ length, /* abs_y */ length);
    callback view-drag-completed(/* abs_x */ length, /* abs_y */ length);
    in property <bool> view-drag-active: false;
    in property <length> view-drag-abs-x;
    in property <length> view-drag-abs-y;
    /// This view is the one being carried.
    in property <bool> view-drag-is-source: false;
    /// This view is the one under the cursor.
    in property <bool> view-drag-is-target: false;
    /// SOME view is under the cursor, so releasing now would swap.
    in property <bool> view-drag-armed: false;
    /// This view is on its way to its new place.
    in property <bool> view-swap-flying: false;
    /// This view is being carried out of the window.
    in property <bool> view-drag-leaving: false;
    // Cursor inside this view, and this view is not the one being carried.
    // The "is a drag running" test comes FIRST: at rest the expression stops on
    // one boolean and never reads the position that moves with the pointer.
    out property <bool> view-drag-over: root.view-drag-active
        && !root.view-drag-is-source
        && root.view-drag-abs-x - root.absolute-position.x >= 0px
        && root.view-drag-abs-x - root.absolute-position.x <= root.width
        && root.view-drag-abs-y - root.absolute-position.y >= 0px
        && root.view-drag-abs-y - root.absolute-position.y <= root.height;
    // The pair lights up together or not at all. A swap concerns TWO views;
    // marking only one would read as "this one replaces that one".
    // Held for the whole travel as well: two outlined rectangles crossing
    // read as two cards being exchanged, where two bare tiles overlapping read
    // as a glitch — the z-order between tiles is not something to rely on.
    property <bool> swap-lit: root.view-swap-flying
        || (root.view-drag-armed
            && (root.view-drag-is-source || root.view-drag-is-target));

    // Directional drop zones -----
    // Drag cursor position in THIS panel's frame.
    property <length> dl-x: root.drag-abs-x - root.absolute-position.x;
    property <length> dl-y: root.drag-abs-y - root.absolute-position.y;
    // Is the drag cursor over this panel?
    out property <bool> drag-over: root.drag-active
        && root.dl-x >= 0px && root.dl-x <= root.width
        && root.dl-y >= 0px && root.dl-y <= root.height;

    // FILE drag'n'drop between views -----
    // (Same principles as the tab drag: absolute position propagated from
    // MainWindow; each panel computes whether it is hovered. `absolute-position`
    // is safe here because panels are positioned with an explicit `x:`.)
    in property <bool> file-drag-active: false;
    in property <length> file-drag-abs-x: 0px;
    in property <length> file-drag-abs-y: 0px;
    in property <bool> is-file-drag-source: false;
    out property <bool> file-drag-over: root.file-drag-active
        && root.file-drag-abs-x >= root.absolute-position.x
        && root.file-drag-abs-x <= root.absolute-position.x + root.width
        && root.file-drag-abs-y >= root.absolute-position.y
        && root.file-drag-abs-y <= root.absolute-position.y + root.height;
    // Emitted by `sel-touch` (see below) to MainWindow.
    callback file-drag-started(int /*row_idx*/, length /*abs_x*/, length /*abs_y*/);
    callback file-drag-progress(length, length);
    callback file-drag-dropped(length, length);
    // Top of the body (below the tabs + nav header) = list-area position.
    property <length> body-top: list-area.absolute-position.y - root.absolute-position.y;
    // Actual LEFT inset of list-area within the panel: root row's
    // padding (`Tokens.panel-pad`) + 6px spacing consumed by `vbar-left`, which
    // stays in the tree at zero width when the vertical tab bar is
    // inactive — i.e. 13px in the common case. Not to be confused with
    // `body-left` (body bounds excluding the vertical bar, zero if tab-mode != 1).
    // Measured rather than hardcoded, to stay accurate if the layout changes.
    // Same read as `body-top` (panel absolute-position = proven safe):
    // used only to place `gutter-strip`, which takes part in no layout →
    // no cycle.
    property <length> list-inset-x: list-area.absolute-position.x - root.absolute-position.x;
    // (FOLDER) row hovered during a file-drag → allows dropping the
    // selection INTO this subfolder. Same reads as `file-drag-over` /
    // `body-top` (panel absolute-position = proven safe); the hit-test consults
    // the precomputed geometry, no reentrant layout read. -1 = no
    // folder-row under the cursor (falls back to the panel's current folder).
    property <length> drag-y-in-body: root.file-drag-abs-y - root.absolute-position.y - root.body-top;
    // Exact X position of the row area (accounts for vertical bar,
    // padding, and horizontal scroll). It shares the same dead bounds as
    // normal hover/click: gutter on the left, end of columns on the right.
    property <length> fd-x-in-list: root.file-drag-abs-x - list-area.absolute-position.x;
    property <int> drag-hover-row: -1;
    function update-drag-hover-row() {
        root.drag-hover-row =
            (root.file-drag-active && root.file-drag-over && root.drag-y-in-body >= 0px
                && root.fd-x-in-list >= Tokens.gutter
                && root.fd-x-in-list <= root.content-right)
            ? root.row-idx-at-y(root.drag-y-in-body)
            : -1;
    }
    changed file-drag-active => { root.update-drag-hover-row(); }
    changed file-drag-over => { root.update-drag-hover-row(); }
    changed file-drag-abs-x => { root.update-drag-hover-row(); }
    changed file-drag-abs-y => { root.update-drag-hover-row(); }
    out property <int> drag-target-row: root.drag-hover-row;
    out property <bool> drag-target-exec:
        root.drag-hover-row >= 0 && root.drag-hover-row < root.view.rows.length
        && !root.view.rows[root.drag-hover-row].is-dir
        && root.view.rows[root.drag-hover-row].drop-runnable;
    out property <int> drag-folder-row:
        (root.drag-hover-row >= 0 && root.drag-hover-row < root.view.rows.length
            && root.view.rows[root.drag-hover-row].is-dir)
        ? root.drag-hover-row
        : -1;
    // Normalized [0,1] coordinates WITHIN the body — X renormalized OUTSIDE the
    // vertical bar: otherwise the "west/east" zone and the 30/70%
    // thresholds would be offset by the bar's width.
    property <float> body-nx:
        (root.dl-x - root.body-left) / max(1px, root.body-right - root.body-left);
    property <float> body-ny: (root.dl-y - root.body-top) / max(1px, root.height - root.body-top);
    // Drop zone: 0 none · 1 center (move) · 2 west · 3 east · 4 north · 5 south.
    // Central 40%x40% band = move; otherwise the nearest edge (diagonals).
    // The TAB BAR (top band OR side column) and the nav bar
    // count as "center" (move zone, no split).
    out property <int> drag-zone:
        !root.drag-over ? 0
        : (root.drag-in-bar || root.dl-y < root.body-top) ? 1
        : (root.body-nx >= 0.30 && root.body-nx <= 0.70
                && root.body-ny >= 0.30 && root.body-ny <= 0.70) ? 1
        : (min(root.body-nx, 1 - root.body-nx) < min(root.body-ny, 1 - root.body-ny))
            ? (root.body-nx < 0.5 ? 2 : 3)
            : (root.body-ny < 0.5 ? 4 : 5);
    /// Absolute X start of `tabs-row` = `root.absolute-position.x` (PanelComponent
    /// position, STABLE, independent of internal layout) + cumulative inset
    /// up to the tabs: root VerticalLayout padding (7px) + toolbar
    /// padding (6px) = 13px. No dependency on tabs-row's layout.
    property <length> tabs-row-x: root.absolute-position.x + 13px;

    // Vertical tab bar -----
    // THIS panel's bar position: 0 top · 1 left · 2 right.
    property <int> tab-mode: root.view.tab-bar-mode;
    // USER width of the bar (0 = automatic). Initialized from the model,
    // mutated locally by the grip (LIVE resize), reported to the bridge at the
    // end of the drag (`vbar-resized`) — same pattern as column widths.
    in-out property <length> vbar-live-w: root.view.vbar-user-w;
    // EFFECTIVE bar width — MUST == `vbar_width` (bridge): user
    // width if set, otherwise 40% of the panel capped at 180; the whole thing bounded
    // between 110px and 60% of the panel to preserve content width.
    property <length> vbar-w:
        max(110px, min(
            root.vbar-live-w > 0px ? root.vbar-live-w : min(180px, root.width * 0.4),
            max(110px, root.width * 0.6)));
    /// End of the bar's resize (grip released): effective width to
    /// persist per view.
    callback vbar-resized(length);
    // ABSOLUTE Y origin of the vertical tab list: panel + content
    // padding (7) + bar padding (4) + "+" header (24) + spacing (4) +
    // thread (1) + spacing (4) = 44px — FIXED insets from the
    // PanelComponent's position, never layout-cache (same pattern as `tabs-row-x`).
    // MUST == the vertical inset of `locate_tab_drop` (bridge, 48 with panel-gap).
    property <length> vtabs-col-y: root.absolute-position.y + 44px;
    // Is the tab drag cursor within THIS panel's BAR? Common
    // gate: gap claiming, insertion preview, split drop's "center"
    // zone — regardless of mode (top band OR side column).
    property <bool> drag-in-bar: root.tab-mode == 0
        ? root.dl-y < root.body-top
        : (root.tab-mode == 1
            ? root.dl-x <= 7px + root.vbar-w + 4px
            : root.dl-x >= root.width - 7px - root.vbar-w - 4px);
    // Body X bounds, excluding the vertical bar. They normalize the split
    // zones and limit row hover during a file drag.
    property <length> body-left: root.tab-mode == 1 ? 7px + root.vbar-w + 6px : 0px;
    property <length> body-right: root.tab-mode == 2
        ? root.width - 7px - root.vbar-w - 6px
        : root.width;
    /// Scroll target computed by the BRIDGE (exact `TabInfo` widths). Consumed
    /// by the tab strip, declared here because MainWindow implements it.
    callback scroll-target(int, bool, length, length) -> length;
    /// Tab reordering: gaps are claimed BY the TabItems
    /// from 100% PLAIN geometries (width/offset provided by the bridge
    /// in the `TabInfo` model) — no layout observation, no cycle. The
    /// claimed gap is stored here (local preview) AND reported to MainWindow
    /// (`tab-gap-claimed`) for cross-view drop (TARGET panel's gap).
    property <int> tab-drop-idx: -1;
    property <length> tab-drop-x;
    /// Emitted (synchronously) on every gap claim — MainWindow stores
    /// (gap, panel) for cross-view drop.
    callback tab-gap-claimed(int);
    callback tab-gap-cleared();
    function report-tab-drop(i: int, x: length) {
        root.tab-drop-idx = i;
        root.tab-drop-x = x;
        root.tab-gap-claimed(i);
    }
    // New drag → starts over from an undefined gap (avoids a leftover from the previous drag).
    changed drag-active => { if (root.drag-active) { root.tab-drop-idx = -1; } }
    /// Drop preview line index. `-1` = no drag, or cursor outside
    /// **THIS panel's bar** (gate `drag-in-bar`: top band OR side
    /// column depending on mode — prevents neighboring views from displaying it).
    property <int> drag-preview-idx:
        (!root.drag-active || !root.drag-over || !root.drag-in-bar)
        ? -1
        : root.tab-drop-idx;
    changed drag-preview-idx => {
        if (root.drag-preview-idx < 0) { root.tab-gap-cleared(); }
    }

    // Callbacks emitted to MainWindow (which dispatches to the active panel).
    callback activate();
    callback go-back();
    callback go-forward();
    callback go-parent();
    callback go-home();
    callback refresh();
    callback sort-clicked(string);
    callback row-activated(int);
    callback row-clicked(int) -> bool;
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    // Slow second click on the single selected entry: reuses the
    // global rename route (same popup as F2 / context menu).
    callback rename-selected();
    callback right-clicked(int, length, length);
    callback select-all();
    callback deselect-all();
    callback rubber-band-begin(int /*mode: 0 replace, 1 add, 2 subtract*/);
    callback rubber-band-update(length, length, length, length);
    callback tab-new();
    callback tab-clicked(int);
    callback tab-closed(int);
    callback tab-context(int, length, length);   // tab right-click
    callback tab-bar-context(length, length);    // right-click on the bar's dead zone
    /// Tab drag completed: (src_idx, target_intra_idx, abs_x, abs_y).
    /// `target_intra_idx` is computed locally in Slint (insertion position
    /// BEFORE removal), or `-1` if the mouse left the tab zone
    /// (the bridge will then try a cross-view target via `abs_x`).
    callback tab-drag-completed(int, int, length, length);
    /// Drag progress: (src_idx, abs_x, abs_y). Used by the bridge for
    /// possible global decisions (no preview here — handled in Slint).
    callback tab-drag-progress(int, length, length);
    callback request-focus();
    /// Emitted when the user submits a path typed in the URL bar.
    callback navigate-to(string);
    /// Emitted on right-click in the empty area (below the rows) — the bridge
    /// opens the context menu on the current folder.
    callback empty-right-clicked(/* abs_x */ length, /* abs_y */ length);
    /// Emitted when the user clicks the header's "x" to close this panel.
    callback close-panel();
    /// Emitted on click of the split token — requests opening the
    /// "Split" menu at position (abs_x, abs_y) below the token.
    callback open-split-menu(length, length);
    /// Emitted on click of the "tab bar position" button —
    /// requests opening the 3-option menu at (abs_x, abs_y) below the button.
    callback open-tabbar-menu(length, length);
    /// Sets the display mode of the active tab (mode menu of the view button):
    /// "list", "previews" (thumbnails) or "grid" (tiles).
    callback set-view-mode(string /*mode code*/);
    /// Cycles the display mode (Ctrl+P): list → previews → grid.
    callback cycle-view-mode();
    /// Opens the display-mode menu at (abs_x, abs_y).
    callback open-view-menu(length, length);
    /// Shows / hides the contents of the direct subfolders ("show subfolder
    /// contents"): one section per direct subfolder.
    callback toggle-subfolder-contents();
    /// Folds / unfolds a section from its header (by section key).
    callback toggle-section(string /*key*/);
    /// Width of this view's list area, in logical px: what the grid packs
    /// its tiles with.
    callback rows-area-width(length /*width*/);
    /// Entry zoom (Ctrl+wheel): +1 enlarges, -1 shrinks. The bridge maps
    /// the level to a row height, then returns the new `viewport-top`
    /// that keeps the anchor entry at the same visual position.
    callback zoom-step(int /*delta*/, length /*top*/, length /*height*/,
        length /*pointer-y*/) -> length;
    /// Global keystroke counter. Any keystroke cancels a deferred
    /// second-click: keyboard input/navigation takes priority over slow rename.
    in property <int> keyboard-interaction-gen;
    /// A modal overlay (menu / popup / dialog) is open → the wheel must
    /// NOT scroll/zoom the view (otherwise the view "moves" under the focused popup).
    in property <bool> overlay-open;
    /// Shows / hides hidden files in the active tab.
    callback toggle-show-hidden();
    /// Right-click in the URL bar → Paste/Copy path menu, at (x, y).
    callback open-url-menu(length, length);
    /// Closes the context menu (left-click in a panel's content).
    callback close-ctx-menu();
    // Editable text of the URL bar (bound to MainWindow's shared property).
    in-out property <string> url-edit-text;
    // URL menu open? → prevents exiting edit mode on focus loss.
    in property <bool> url-menu-open;
    /// Bumped by the URL menu's "Copy". The field itself watches this and
    /// copies, because only IT knows what is selected — see `url-input`.
    in property <int> url-copy-serial;
    in property <int> url-paste-serial;

    // Rubber-band (selection rectangle).
    // To stay correct while the list is scrolled, the anchor and the current
    // point are stored in **content coordinates** (= visible − scroll).
    // The bridge compares them against the exact `visual-y/visual-h` bands; the
    // drawn rectangle converts back to visible (+ viewport-y).
    property <bool> rb-active: false;
    property <length> rb-anchor-x;    // visible x at the start
    property <length> rb-anchor-cy;   // CONTENT y at the start (anchor)
    property <length> rb-cur-x;       // current visible x
    property <length> rb-cur-vy;      // current VISIBLE y (mouse)
    // current content y — reactive to scroll (key to edge auto-scroll).
    property <length> rb-cur-cy: root.rb-cur-vy - rows-scroll.viewport-y;
    // Lower (negative) bound of viewport-y; 0 if the content fits without scrolling.
    property <length> rb-min-vy: rows-scroll.viewport-height > rows-scroll.height
        ? -(rows-scroll.viewport-height - rows-scroll.height)
        : 0px;

    // Hovered row index (-1 = none) — driven by `sel-touch`.
    property <int> hovered-idx: selection.hovered-idx;
    // Which row's note the pointer is asking for, or -1. The badge is drawn on
    // the ICON, so that is where the reader points; the rest of the line must
    // not pop a bubble on the way past.
    //
    // Decided ONCE for the view rather than by a property on every rendered
    // row. A `changed` handler forces its property to be evaluated eagerly, so
    // one per row means a hundred evaluations where one per view means one —
    // and the pointer moves far more often than the rows do. The hover test
    // comes first, so while a separator is being dragged this stops at a single
    // boolean and never even looks at the column widths that are moving.
    property <int> note-row: (selection.has-hover && !selection.pressed
            && root.hovered-idx >= 0
            && root.hovered-idx < root.view.rows.length
            && root.view.rows[root.hovered-idx].comment != ""
            && selection.mouse-x >= Tokens.gutter-content
            && selection.mouse-x <= Tokens.gutter-content
                + Tokens.row-icon-slot(root.view.preview-mode,
                    root.view.rows[root.hovered-idx].visual-h,
                    root.col-name-width))
        ? root.hovered-idx : -1;
    // Menu key (the context-menu key of a PC keyboard). The window bumps a
    // counter, every view watches it, and only the active one answers — the
    // same idiom as `Dismiss.serial`, and the only one that reaches a single
    // instance of a repeated component.
    in property <int> menu-key-serial;
    // Row the menu should target, or -1 for the background menu. Resolved by
    // the bridge, which owns the selection; the geometry stays here, where the
    // pixels are.
    callback keyboard-context-row() -> int;
    property <int> menu-key-watch: root.menu-key-serial;
    changed menu-key-watch => {
        if (root.active) {
            // Top-left of the entries area: where a menu opens when nothing is
            // targeted, and the fallback when the target cannot be pointed at.
            let fx: length = rows-scroll.absolute-position.x + Tokens.gutter;
            let fy: length = rows-scroll.absolute-position.y;
            let idx: int = root.keyboard-context-row();
            if (idx < 0 || idx >= root.view.rows.length) {
                root.empty-right-clicked(fx, fy);
            } else {
                // Same geometry as the note bubble: the frame's own position,
                // plus the scroll offset, plus the row's place in the viewport.
                let rtop: length = rows-scroll.absolute-position.y + rows-scroll.viewport-y
                    + root.view.rows[idx].visual-y;
                let rbot: length = rtop + root.view.rows[idx].visual-h;
                // A row scrolled out of sight would drag the menu off the view.
                // The selection still owns the menu; only its position falls
                // back to the corner.
                let on-screen: bool = rtop >= rows-scroll.absolute-position.y
                    && rbot <= rows-scroll.absolute-position.y + rows-scroll.height;
                root.right-clicked(idx, fx, on-screen ? rbot : fy);
            }
        }
    }

    // Claim held on the shared bubble. Leaving one view as the pointer enters
    // another fires both handlers in an order nothing guarantees, so a view
    // only clears what it put there itself. Same idiom as `Dismiss.serial`.
    property <int> note-claim: -1;
    changed note-row => {
        if (root.note-row >= 0) {
            Note.owner += 1;
            root.note-claim = Note.owner;
            Note.pending = root.view.rows[root.note-row].comment;
            // Edges of the row in WINDOW coordinates: the frame's own position,
            // plus the scroll offset (negative when scrolled down), plus the
            // row's place in the viewport. Both travel, so the bubble can flip
            // above the row when there is no room beneath it. On x, the gutter
            // is added: a row spans the whole viewport, but the entry the user
            // sees starts at the gutter, the same inset as its selection pill.
            Note.pending-x = rows-scroll.absolute-position.x + Tokens.gutter;
            Note.row-top = rows-scroll.absolute-position.y + rows-scroll.viewport-y
                + root.view.rows[root.note-row].visual-y;
            Note.row-bottom = Note.row-top + root.view.rows[root.note-row].visual-h;
        } else if (root.note-claim == Note.owner) {
            Note.pending = "";
        }
    }

    // Close / merge previews -----
    // `is-drag-source` = this panel is the source of the ongoing tab drag.
    in property <bool> is-drag-source: false;
    // (A) Hovering the "x" button = explicit CLOSE → danger red (actual loss
    // of the layout + tabs). Driven by close-panel-touch.
    property <bool> close-hover: false;
    // (B) Dragging the last tab = the view is about to be ABSORBED via merge. This
    // is an ALLOWED, non-destructive action (the tab migrates) → definitely NOT red:
    // treated as a neutral "dissolution" (grey veil + faded content).
    property <bool> will-merge: root.is-drag-source && root.view.tabs.length <= 1;
    // The absorption register: this view is about to stop existing HERE — its
    // last tab carried into another view, or the whole view carried out of the
    // window. The same word for the same meaning, content faded included,
    // because it really does leave. Which is exactly what must NOT happen on a
    // swap, where nothing is lost.
    property <bool> leaving: root.will-merge || root.view-drag-leaving;

    // ACTUAL content height. Unlike Slint's standard ListView,
    // no average-height computation is involved: scrollbar and hit-tests
    // share exactly the same cumulative reference.
    property <length> rows-content-height:
        root.view.rows.length > 0
            ? root.view.rows[root.view.rows.length - 1].visual-y
                + root.view.rows[root.view.rows.length - 1].visual-h
            : 0px;

    function report-rows-viewport() {
        root.rows-viewport-changed(max(0px, -rows-scroll.viewport-y), rows-scroll.height);
    }
    property <int> rows-revision-watch: root.view.rows-revision;
    property <int> viewport-reset-watch: root.view.viewport-reset-gen;
    property <length> rows-viewport-height-watch: list-area.height;
    // The grid packs its tiles from the list area's width.
    property <length> rows-width-watch: list-area.width;
    changed rows-width-watch => {
        root.rows-area-width(list-area.width);
    }
    changed rows-revision-watch => {
        if (!selection.zoom-adjusting) {
            rows-scroll.viewport-y = clamp(rows-scroll.viewport-y, root.rb-min-vy, 0px);
            root.report-rows-viewport();
            root.update-drag-hover-row();
            selection.update-pointer-hover();
        }
    }
    changed rows-viewport-height-watch => {
        rows-scroll.viewport-y = clamp(rows-scroll.viewport-y, root.rb-min-vy, 0px);
        root.report-rows-viewport();
        selection.update-pointer-hover();
    }
    changed viewport-reset-watch => {
        rows-scroll.viewport-y = 0px;
        root.report-rows-viewport();
        root.update-drag-hover-row();
        selection.update-pointer-hover();
    }

    // Index of the row under the ordinate `y` (list-area frame), accounting
    // for scrolling. `-1` if outside the list.
    function row-idx-at-y(y: length) -> int {
        if (y < 0px) {
            return -1;
        }
        return root.row-at-content-y(y - rows-scroll.viewport-y);
    }
    // RIGHT edge of the columns (Flickable content position): beyond it is a
    // DEAD ZONE (like the left gutter) → click/hover/drag there start a
    // rubber-band, not a row action. Columns run from `gutter-content`
    // to `gutter-content + content-width`.
    property <length> content-right: Tokens.gutter-content + root.view.content-width;
    // Row index under `(x, y)`. In list mode the left gutter and the area
    // beyond the columns are DEAD ZONES (they start a rubber-band, not a row
    // action). In grid mode a tile owns exactly its own x range, and a section
    // header — which spans the whole band — owns all of it.
    function row-idx-at-xy(x: length, y: length) -> int {
        let idx: int = root.row-idx-at-y(y);
        if (idx < 0) {
            return -1;
        }
        if (root.view.grid-mode) {
            let row = root.view.rows[idx];
            return (row.role != 0
                || (x >= row.visual-x && x < row.visual-x + row.visual-w)) ? idx : -1;
        }
        return (x < Tokens.gutter || x > root.content-right) ? -1 : idx;
    }

    // Keyboard navigation: brings row `idx` into the visible area by
    // adjusting the exact vertical scroll (viewport-y ≤ 0). Only moves if the
    // row overflows top or bottom. Bounded by `rb-min-vy`.
    function scroll-row-into-view(idx: int) {
        if (idx < 0) {
            return;
        }
        if (idx >= root.view.rows.length) {
            return;
        }
        let top: length = root.view.rows[idx].visual-y;
        let height: length = root.view.rows[idx].visual-h;
        let row-top-in-view: length = top + rows-scroll.viewport-y;
        if (row-top-in-view < 0px) {
            rows-scroll.viewport-y = clamp(-top, root.rb-min-vy, 0px);
        } else if (row-top-in-view + height > rows-scroll.height) {
            rows-scroll.viewport-y = clamp(rows-scroll.height - top - height, root.rb-min-vy, 0px);
        }
    }

    // We ONLY observe `scroll-gen` (bumped on every keyboard cursor
    // move) → scrolls only on keyboard navigation, not on other
    // PanelView refreshes.
    property <int> scroll-gen-watch: root.view.scroll-gen;
    changed scroll-gen-watch => { root.scroll-row-into-view(root.view.cursor-row); }

    // The active state reads as a crisp accent outline (2px); inactive panels
    // carry a discreet thread. (No drop shadow: `panels-container` clips
    // and the z-order between tiles would make it inconsistent from one side to the other.)
    border-width: root.close-hover ? 2px
        : (root.swap-lit ? 2px
            : (root.leaving ? 1.5px
                : (root.active ? 2px : 1px)));
    border-color: root.close-hover
        ? Tokens.danger                              // (A) close = red
        : (root.swap-lit
            ? Theme.accent-background               // (C) swap = accent, both of the pair
            : (root.leaving
                ? Theme.border.with-alpha(0.6)     // (B) absorption = neutral
                : (root.active
                    ? Theme.accent-background       // active = accent outline
                    : Tokens.hairline)));             // inactive = discreet thread
    border-radius: Tokens.radius-panel;
    // Card surface (slightly detached from the channel/groove = Theme.background).
    background: Theme.surface;
    // NO `clip` HERE: a `clip` combined with a `border-radius` forces Slint to
    // render the whole subtree into an offscreen layer (rounded mask), a layer
    // allocated/recomposed at a fractional size → the WHOLE panel (URL
    // bar, entries) becomes BLURRY, and inconsistently from one panel
    // to another. The clip is carried by `content-clip` (rectangular = scissor,
    // no layer, hence crisp). The rounded corner remains purely visual here.

    // Activates this panel on click of any "dead" zone (empty tab
    // strip, footer, nav bar gaps). Placed BEHIND the content:
    // interactive elements (tabs, buttons, rows…) are on top and
    // keep their clicks; only clicks on empty area land here. Slint
    // dispatches to the topmost TouchArea under the pointer.
    activate-bg := TouchArea {
        clicked => { root.activate(); root.close-ctx-menu(); }
    }

    // Wrapper that CLIPS the content — rectangular, WITHOUT border-radius → clip
    // via scissor (no offscreen layer, hence NO blur). Confines the
    // header buttons to a narrow view (otherwise they'd overflow into the
    // neighboring view). The rounded corner is still carried by the root Rectangle.
    content-clip := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
    // Root row: [left vertical tab bar] · content ·
    // [right vertical bar]. BOTH bars stay in the tree (zero width
    // and invisible when inactive): a conditional `if` element would not be
    // referenceable (reveal, viewport-y, drag cursor).
    HorizontalLayout {
        padding: Tokens.panel-pad;
        spacing: 6px;
        // "Dissolution" fade when the view is about to be absorbed via merge
        // (dragging its last tab) — main signal, neutral (not red).
        opacity: root.leaving ? 0.55 : 1.0;
        animate opacity { duration: 200ms; easing: ease-out; }

        vbar-left := VTabBar {
            width: root.tab-mode == 1 ? root.vbar-w : 0px;
            visible: root.tab-mode == 1;
            on-left: true;
            tabs: root.view.tabs;
            active-tab-idx: root.view.active-tab-idx;
            overlay-open: root.overlay-open;
            tab-drag-active: root.drag-active;
            new-tab-tooltip: root.strings.tab-new-tooltip;
            show-tooltip: root.tab-tooltip-enabled;
            reorder-here: root.tab-mode == 1 && root.drag-active
                && root.drag-over && root.drag-in-bar;
            // Drag cursor in the list's CONTENT position (plain values only:
            // fixed origin `vtabs-col-y` + viewport reported by the bar).
            reorder-cur: root.drag-abs-y - root.vtabs-col-y - self.vp-y;
            cursor-in-bar-y: root.drag-abs-y - root.vtabs-col-y;
            preview-idx: root.tab-mode == 1 ? root.drag-preview-idx : -1;
            preview-pos: root.tab-drop-x;
            claim-drop(g, gy) => { root.report-tab-drop(g, gy); }
            tab-clicked(i) => { root.activate(); root.tab-clicked(i); }
            tab-closed(i) => { root.activate(); root.tab-closed(i); }
            tab-context(i, x, y) => { root.activate(); root.tab-context(i, x, y); }
            // NO `activate()` during the drag (would rebuild the model →
            // lost grab; activation on drop, bridge side) — strip parity.
            tab-drag-progress(i, ax, ay) => { root.tab-drag-progress(i, ax, ay); }
            tab-drag-completed(i, ax, ay) => {
                root.tab-drag-completed(i, root.drag-preview-idx, ax, ay);
            }
            tab-new => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
            bar-clicked => { root.activate(); root.close-ctx-menu(); }
            bar-context(x, y) => { root.activate(); root.tab-bar-context(x, y); }
            wheel(fwd) => { tabsbar.tab-wheel(fwd); }
            scrolled(vy) => { root.tabs-scrolled(vy); }
            scroll-target(ti, fwd, vp, vw) => {
                return root.scroll-target(ti, fwd, vp, vw);
            }
            // Resize via the inner grip: width = mouse −
            // bar's left edge (panel + padding 7). Shared clamp
            // via `vbar-w` (the raw live-w is bounded by the formula).
            grip-moved(ax) => {
                root.vbar-live-w = ax - root.absolute-position.x - 7px;
            }
            grip-done => { root.vbar-resized(root.vbar-w); }
        }

    VerticalLayout {
        spacing: 6px;

        // ===== Top toolbar (tabs + nav) =====
        // `Theme.toolbar` background (one notch darker than the surface) to clearly
        // set apart the top part (tabs + URL + buttons) from the bottom part
        // (list). Inset rounded block (the card's border/corner remain
        // visible around it).
        Rectangle {
            // Washed while this view is the one being carried: the header is
            // what the hand is holding, and saying it there costs nothing
            // anywhere else.
            background: root.view-drag-is-source
                ? Theme.accent-background.with-alpha(0.18)
                : Theme.toolbar;
            border-radius: Tokens.radius-row;
            VerticalLayout {
                padding: 6px;
                // Vertical bar: the strip's row is COLLAPSED (height
                // 0) → no spacing above the nav bar.
                spacing: root.tab-mode == 0 ? 6px : 0px;

        // ===== Tab strip =====
        // The scrollable row of tabs with its "+" button lives in
        // `panel/tabs_bar.slint` and keeps its Flickable private (the panel
        // never reads the strip's geometry). COLLAPSED (height 0, invisible)
        // when the tab bar is VERTICAL, but the element stays in the tree —
        // its TabItems keep claiming the drop gaps (an `if` would break them).
        tabsbar := PanelTabsBar {
            view: root.view;
            strings: root.strings;
            overlay-open: root.overlay-open;
            drag-active: root.drag-active;
            drag-over: root.drag-over;
            drag-in-bar: root.drag-in-bar;
            drag-abs-x: root.drag-abs-x;
            tabs-row-x: root.tabs-row-x;
            dl-y: root.dl-y;
            body-top: root.body-top;
            tab-mode: root.tab-mode;
            tab-tooltip-enabled: root.tab-tooltip-enabled;
            drag-preview-idx: root.drag-preview-idx;
            tab-drop-x: root.tab-drop-x;
            activate => { root.activate(); }
            close-ctx-menu => { root.close-ctx-menu(); }
            tab-new => { root.tab-new(); }
            tab-clicked(i) => { root.tab-clicked(i); }
            tab-closed(i) => { root.tab-closed(i); }
            tab-context(i, x, y) => { root.tab-context(i, x, y); }
            tab-bar-context(x, y) => { root.tab-bar-context(x, y); }
            tab-drag-progress(i, ax, ay) => { root.tab-drag-progress(i, ax, ay); }
            tab-drag-completed(i, ti, ax, ay) => {
                root.tab-drag-completed(i, ti, ax, ay);
            }
            tabs-scrolled(vx) => { root.tabs-scrolled(vx); }
            scroll-target(ti, fwd, vp, vw) => {
                return root.scroll-target(ti, fwd, vp, vw);
            }
            report-tab-drop(g, x) => { root.report-tab-drop(g, x); }
            reveal-in-bar(idx) => {
                if (root.tab-mode == 1) { vbar-left.reveal(idx); }
                else if (root.tab-mode == 2) { vbar-right.reveal(idx); }
            }
        }

        // ===== Nav bar + breadcrumb =====
        // ===== Nav bar + breadcrumb =====
        // History / view-mode / path bar / grip / split / close live in
        // `panel/nav_bar.slint`; the two-way bindings are the edit mode, the
        // URL field's text and the close-hover preview.
        navbar := PanelNavBar {
            view: root.view;
            strings: root.strings;
            can-close: root.can-close;
            tab-mode: root.tab-mode;
            path-edit-mode <=> root.path-edit-mode;
            url-edit-text <=> root.url-edit-text;
            url-menu-open: root.url-menu-open;
            url-copy-serial: root.url-copy-serial;
            url-paste-serial: root.url-paste-serial;
            close-hover <=> root.close-hover;
            activate => { root.activate(); }
            go-back => { root.go-back(); }
            go-forward => { root.go-forward(); }
            go-parent => { root.go-parent(); }
            refresh => { root.refresh(); }
            request-focus => { root.request-focus(); }
            navigate-to(p) => { root.navigate-to(p); }
            close-panel => { root.close-panel(); }
            open-split-menu(x, y) => { root.open-split-menu(x, y); }
            open-tabbar-menu(x, y) => { root.open-tabbar-menu(x, y); }
            open-view-menu(x, y) => { root.open-view-menu(x, y); }
            toggle-subfolder-contents => { root.toggle-subfolder-contents(); }
            toggle-show-hidden => { root.toggle-show-hidden(); }
            open-url-menu(x, y) => { root.open-url-menu(x, y); }
            close-ctx-menu => { root.close-ctx-menu(); }
            view-drag-progress(x, y) => { root.view-drag-progress(x, y); }
            view-drag-completed(x, y) => { root.view-drag-completed(x, y); }
        }
            } // closes the toolbar's inner VerticalLayout
        } // closes the toolbar (Theme.toolbar)

        // ===== View filter bar — SHARED component =====
        // By-NAME type-ahead filter: magnifying glass + typed text; shows as soon as
        // text is entered. "x" / Escape = reset (see key-scope).
        if root.active && root.filter-text != "" && !root.view.ext-filter-on : FilterBar {
            icon: @image-url("../../assets/icons/search.svg");
            text: root.filter-text;
            close => { root.close-ctx-menu(); root.filter-clear(); }
        }
        // By-EXTENSION filter: funnel + text (hint "jpg, png" if empty).
        // Activated from the columns menu; driven by keyboard like the
        // type-ahead (input routed bridge-side). "x" = disables it.
        if root.view.ext-filter-on : FilterBar {
            icon: @image-url("../../assets/icons/filter.svg");
            text: root.view.ext-filter;
            hint: root.strings.ext-filter-placeholder;
            close => { root.ext-filter-toggle(); }
        }

        // ===== Flickable wrapper: headers + list scroll TOGETHER horizontally =====
        // If the sum of column widths exceeds the available width,
        // a custom scrollbar appears at the bottom of the panel (see below).
        Rectangle {
            vertical-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            max-width: 99999px;

            // Actual row width: left gutter (`gutter-content`) +
            // visible columns (`content-width`) + right padding. It must
            // match the rows' and header's indents so the
            // viewport doesn't add spurious horizontal overflow.
            property <length> total-col-w:
                root.view.content-width + Tokens.gutter-content + 8px;
            // A 6px threshold absorbs residual rounding and spacing to
            // avoid a scrollbar almost as wide as the viewport.
            property <bool> needs-hscroll: total-col-w > self.width + 6px;

            flickable := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height - (parent.needs-hscroll ? 10px : 0px);
                viewport-width: max(self.width, parent.total-col-w);
                viewport-height: self.height;
                // `interactive: false`: otherwise the Flickable captures the
                // drags and the rubber-band no longer receives anything. Horizontal
                // scrolling happens via the custom scrollbar at the bottom + via
                // shift+wheel within the list.
                interactive: false;

                VerticalLayout {
                    spacing: 2px;

                    // === Column header (inside the Flickable
                    //     to scroll along with the rows) ===
                    // "Pro table" look: no filled rounded chip, just
                    // a flat header topping a thin hairline.
                    Rectangle {
                        background: transparent;
                        height: 30px;
                        // Thin hairline separating header / list.
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Tokens.hairline;
                        }
                        HorizontalLayout {
                            // Aligned with the rows' content (see FileRowView).
                            padding-left: Tokens.gutter-content;
                            padding-right: 8px;
                            spacing: Tokens.col-gap;
                            alignment: start;

                            // Headers rendered dynamically based on their order and
                            // visibility. The width is resolved via `width-of`, then
                            // applied via `set-col-width` and persisted.
                            for col[ci] in root.view.columns : ColumnHeader {
                                column-width: root.width-of(col.id);
                                label: col.label;
                                column-id: col.id;
                                active: root.view.sort-column == col.id;
                                asc: root.view.sort-asc;
                                index: ci;
                                count: root.view.columns.length;
                                offset: col.offset;
                                col-drag-active: root.col-drag-active;
                                col-drag-new-center: root.col-drag-center + root.col-drag-delta;
                                col-drop-idx: root.col-drop-idx;
                                clicked => { root.activate(); root.sort-clicked(col.id); }
                                resized(w) => { root.set-col-width(col.id, w); }
                                resize-finished => { root.column-resized(col.id, root.width-of(col.id)); }
                                right-clicked(x, y) => { root.activate(); root.open-columns-menu(x, y); }
                                reorder-start(center) => {
                                    root.col-drag-active = true;
                                    root.col-drag-id = col.id;
                                    root.col-drag-center = center;
                                    root.col-drag-delta = 0px;
                                    root.col-drop-idx = -1;
                                }
                                reorder-move(delta) => { root.col-drag-delta = delta; }
                                report-drop-target(t) => { root.col-drop-idx = t; }
                                reorder-end(delta) => {
                                    if (root.col-drag-active && root.col-drag-id != "") {
                                        root.column-moved(root.col-drag-id, delta / 1px);
                                    }
                                    root.col-drag-active = false;
                                    root.col-drag-id = "";
                                    root.col-drag-delta = 0px;
                                    root.col-drop-idx = -1;
                                }
                            }
                        }
                    }

                    // === List + empty area + rubber-band overlay ===
                    list-area := Rectangle {
            vertical-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            max-width: 99999px;
            // Confines the selection rectangle (and the rows) to the list
            // area: without this, a negative rubber-band `y` would make it overflow
            // OVER the column header (list-area draws afterward).
            clip: true;

            // Vertical Flickable with EXACT content. The standard `ListView` estimates
            // its anchor via the delegates' average height, which is not
            // compatible with a mix of 28/76/… px. `rendered-rows` stays a
            // sub-model bounded to the viewport + overscan: virtualization is
            // preserved without ever approximating the geometry.
            rows-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, root.rows-content-height);
                interactive: false;
                changed viewport-y => {
                    if (!selection.zoom-adjusting) {
                        root.report-rows-viewport();
                        root.update-drag-hover-row();
                        selection.update-pointer-hover();
                    }
                }
                // One wrapper per row carrying the bridge-computed geometry;
                // the visual that goes inside depends on the role (entry vs
                // section header) and the display mode (list row vs grid tile).
                for entry[visible-idx] in root.view.rendered-rows : Rectangle {
                    x: 0px;
                    y: entry.visual-y;
                    width: rows-scroll.viewport-width;
                    height: entry.visual-h;

                    if entry.role == 1 : SectionHeaderView {
                        width: parent.width;
                        strings: root.strings;
                        label: entry.section-label;
                        count-text: entry.section-count-text;
                        pending: entry.section-pending;
                        collapsed: false;   // the caret follows the entries below
                        is-folder: entry.is-dir;
                        icon: entry.is-dir
                            ? @image-url("../../assets/icons/folder.svg")
                            : @image-url("../../assets/icons/file.svg");
                        icon-color: entry.is-dir
                            ? Tokens.folder-color(entry.folder-slot)
                            : Theme.foreground.with-alpha(0.6);
                        indent: entry.visual-x;
                        hovered: root.hovered-idx == entry.model-index;
                    }
                    if entry.role == 0 && root.view.grid-mode : FileTileView {
                        x: entry.visual-x;
                        width: entry.visual-w;
                        name-base: entry.name-base;
                        name-ext: entry.name-ext;
                        is-dir: entry.is-dir;
                        is-symlink: entry.is-symlink;
                        folder-slot: entry.folder-slot;
                        kind: entry.kind;
                        selected: entry.selected;
                        cut: entry.cut;
                        hovered: entry.model-index == root.hovered-idx
                            || (root.file-drag-over && entry.model-index == root.drag-hover-row
                                && (entry.is-dir || entry.drop-runnable));
                        hidden: entry.hidden;
                        comment: entry.comment;
                        thumbnail: entry.thumbnail;
                        app-icon: entry.app-icon;
                        link-folder: entry.link-folder;
                        preview-mode: root.view.preview-mode;
                        row-h: entry.visual-h;
                    }
                    if entry.role == 0 && !root.view.grid-mode : FileRowView {
                        width: parent.width;
                        name: entry.name;
                        name-base: entry.name-base;
                        name-ext: entry.name-ext;
                        hidden: entry.hidden;
                        age: entry.age;
                        age-bucket: entry.age-bucket;
                        path: entry.path;
                        size: entry.size;
                        modified: entry.modified;
                        is-dir: entry.is-dir;
                        is-symlink: entry.is-symlink;
                        folder-slot: entry.folder-slot;
                        comment: entry.comment;
                        kind: entry.kind;
                        selected: entry.selected;
                        cut: entry.cut;
                        // A drag target receives the same hover as mouse
                        // hover, including from another Favnyr view/instance.
                        hovered: entry.model-index == root.hovered-idx
                            || (root.file-drag-over && entry.model-index == root.drag-hover-row
                                && (entry.is-dir || entry.drop-runnable));
                        preview-mode: root.view.preview-mode;
                        row-h: entry.visual-h;
                        resolution: entry.resolution;
                        depth: entry.depth;
                        ext: entry.ext;
                        thumbnail: entry.thumbnail;
                        app-icon: entry.app-icon;
                        link-folder: entry.link-folder;
                        col-name-width: root.col-name-width;
                        col-path-width: root.col-path-width;
                        col-size-width: root.col-size-width;
                        col-modified-width: root.col-modified-width;
                        col-ext-width: root.col-ext-width;
                        col-resolution-width: root.col-resolution-width;
                        col-depth-width: root.col-depth-width;
                        col-age-width: root.col-age-width;
                        content-width: root.view.content-width;
                        columns: root.view.columns;
                    }
                }
            }

            // "Folder not found" banner: inaccessible folder (network
            // drive not started, missing mount). We KEEP the tab + this message
            // PERSISTENT; it disappears on its own once the folder becomes
            // accessible again (automatic recheck, see `recheck-unavailable`).
            if root.view.unavailable : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                background: Theme.background;
                // LEFT-ALIGNED block — on a narrow/cramped view, a
                // centered warning can "fall" outside the visible area or get
                // clipped; anchored on the left, it always stays legible. Centered
                // vertically only.
                VerticalLayout {
                    alignment: center;              // centers the block VERTICALLY
                    spacing: 7px;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    // Icon wrapped in a LEFT-aligned HorizontalLayout: a
                    // fixed-size Image is NOT stretched by the VerticalLayout.
                    HorizontalLayout {
                        alignment: start;
                        Image {
                            source: @image-url("../../assets/icons/network.svg");
                            width: 24px;
                            height: 24px;
                            colorize: Tokens.danger;
                        }
                    }
                    Text {
                        text: root.strings.tab-unavailable;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.foreground;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.view.current-path;
                        font-size: 12px;
                        color: Theme.foreground.with-alpha(0.65);
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    Text {
                        text: root.strings.tab-unavailable-hint;
                        font-size: 11px;
                        color: Theme.foreground.with-alpha(0.5);
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                }
            }

            // ===== Selection layer =====
            // Pointer gestures over the list (hover, clicks, rubber-band,
            // middle-click auto-scroll, deferred rename, drag edge auto-scroll)
            // live in `panel/selection.slint`, in the same frame. The
            // rubber-band state is shared with `gutter-strip` below and the
            // scroll positions are two-way; `update-pointer-hover` stays public
            // for the relayout watches above.
            selection := PanelSelection {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                view: root.view;
                active: root.active;
                overlay-open: root.overlay-open;
                file-drag-active: root.file-drag-active;
                file-drag-over: root.file-drag-over;
                file-drag-abs-y: root.file-drag-abs-y;
                keyboard-interaction-gen: root.keyboard-interaction-gen;
                rows-vh: rows-scroll.viewport-height;
                rows-h: rows-scroll.height;
                flick-vw: flickable.viewport-width;
                flick-w: flickable.width;
                rb-cur-cy: root.rb-cur-cy;
                rb-min-vy: root.rb-min-vy;
                rows-vy <=> rows-scroll.viewport-y;
                flick-vx <=> flickable.viewport-x;
                rb-active <=> root.rb-active;
                rb-anchor-x <=> root.rb-anchor-x;
                rb-anchor-cy <=> root.rb-anchor-cy;
                rb-cur-x <=> root.rb-cur-x;
                rb-cur-vy <=> root.rb-cur-vy;
                activate => { root.activate(); }
                close-ctx-menu => { root.close-ctx-menu(); }
                deselect-all => { root.deselect-all(); }
                empty-right-clicked(x, y) => { root.empty-right-clicked(x, y); }
                file-drag-started(i, x, y) => { root.file-drag-started(i, x, y); }
                file-drag-progress(x, y) => { root.file-drag-progress(x, y); }
                file-drag-dropped(x, y) => { root.file-drag-dropped(x, y); }
                go-back => { root.go-back(); }
                go-forward => { root.go-forward(); }
                rename-selected => { root.rename-selected(); }
                request-focus => { root.request-focus(); }
                right-clicked(i, x, y) => { root.right-clicked(i, x, y); }
                row-activated(i) => { root.row-activated(i); }
                row-clicked(i) => { return root.row-clicked(i); }
                row-ctrl-clicked(i) => { root.row-ctrl-clicked(i); }
                row-shift-clicked(i) => { root.row-shift-clicked(i); }
                rubber-band-begin(m) => { root.rubber-band-begin(m); }
                rubber-band-update(x0, y0, x1, y1) => { root.rubber-band-update(x0, y0, x1, y1); }
                toggle-section(k) => { root.toggle-section(k); }
                zoom-step(d, t, h, y) => { return root.zoom-step(d, t, h, y); }
                hit-test(x, y) => { return root.row-idx-at-xy(x, y); }
                cancel-column-drag => {
                    if (root.col-drag-active) {
                        root.col-drag-active = false;
                        root.col-drag-id = "";
                        root.col-drop-idx = -1;
                    }
                }
                report-rows-viewport => { root.report-rows-viewport(); }
                update-drag-hover-row => { root.update-drag-hover-row(); }
            }
        }
                } // closes the VerticalLayout inside the Flickable
            } // closes Flickable

            // ===== Custom horizontal scrollbar (visible on overflow) =====
            if needs-hscroll : hscrollbar := Rectangle {
                x: 0;
                y: parent.height - 7px;
                width: parent.width;
                height: 5px;
                // TRANSPARENT track (no more background band): discreet, can
                // no longer read as a dark line.
                background: transparent;
                border-radius: 2.5px;

                property <length> thumb-w:
                    max(30px, self.width * flickable.width / max(1px, flickable.viewport-width));

                // Thumb: position driven by the Flickable's viewport-x.
                Rectangle {
                    x: -flickable.viewport-x
                        / max(1px, flickable.viewport-width - flickable.width)
                        * (hscrollbar.width - hscrollbar.thumb-w);
                    y: 0;
                    width: hscrollbar.thumb-w;
                    height: parent.height;
                    // Dimmed (0.22 at rest, formerly 0.4) → light indicator, not a
                    // dark bar; crisp accent on hover/drag.
                    background: thumb-touch.has-hover || thumb-touch.pressed
                        ? Theme.accent-background.with-alpha(0.7)
                        : Theme.foreground.with-alpha(0.22);
                    border-radius: parent.border-radius;

                    property <length> drag-start-x;
                    property <length> drag-start-viewport-x;
                    thumb-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left
                                    && ev.kind == PointerEventKind.down) {
                                root.close-ctx-menu();
                                parent.drag-start-x = self.absolute-position.x + self.mouse-x;
                                parent.drag-start-viewport-x = flickable.viewport-x;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                flickable.viewport-x = parent.drag-start-viewport-x
                                    - (self.absolute-position.x + self.mouse-x - parent.drag-start-x)
                                        / max(1px, hscrollbar.width - hscrollbar.thumb-w)
                                        * (flickable.viewport-width - flickable.width);
                            }
                        }
                    }
                }
            }

            // ===== Custom VERTICAL scrollbar (visible on vertical overflow) =====
            // Pinned to the RIGHT edge of the VIEW (not the content) → ALWAYS visible,
            // even when the columns overflow horizontally. Same
            // style/logic as the
            // custom horizontal scrollbar.
            if root.rb-min-vy < 0px : vscrollbar := Rectangle {
                x: parent.width - 7px;
                y: 32px;                              // below the header (30px + 2px spacing)
                width: 5px;
                height: flickable.height - 32px;      // stops above the hscrollbar
                background: transparent;
                border-radius: 2.5px;

                property <length> thumb-h:
                    max(30px, self.height * rows-scroll.height / max(1px, rows-scroll.viewport-height));

                Rectangle {
                    x: 0;
                    // Position driven by viewport-y (∈ [rb-min-vy, 0]).
                    y: -rows-scroll.viewport-y
                        / max(1px, rows-scroll.viewport-height - rows-scroll.height)
                        * (vscrollbar.height - vscrollbar.thumb-h);
                    width: parent.width;
                    height: vscrollbar.thumb-h;
                    background: vthumb-touch.has-hover || vthumb-touch.pressed
                        ? Theme.accent-background.with-alpha(0.7)
                        : Theme.foreground.with-alpha(0.22);
                    border-radius: parent.border-radius;

                    property <length> drag-start-y;
                    property <length> drag-start-viewport-y;
                    vthumb-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left
                                    && ev.kind == PointerEventKind.down) {
                                root.close-ctx-menu();
                                parent.drag-start-y = self.absolute-position.y + self.mouse-y;
                                parent.drag-start-viewport-y = rows-scroll.viewport-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                rows-scroll.viewport-y = clamp(
                                    parent.drag-start-viewport-y
                                        - (self.absolute-position.y + self.mouse-y - parent.drag-start-y)
                                            / max(1px, vscrollbar.height - vscrollbar.thumb-h)
                                            * (rows-scroll.viewport-height - rows-scroll.height),
                                    root.rb-min-vy, 0px);
                            }
                        }
                    }
                }
            }
        } // closes the wrapper Rectangle (Flickable + scrollbar)

        // ===== Footer =====
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 18px;
            Text {
                text: root.footer-text;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.6);
            }
        }
    }

        vbar-right := VTabBar {
            width: root.tab-mode == 2 ? root.vbar-w : 0px;
            visible: root.tab-mode == 2;
            on-left: false;
            tabs: root.view.tabs;
            active-tab-idx: root.view.active-tab-idx;
            overlay-open: root.overlay-open;
            tab-drag-active: root.drag-active;
            new-tab-tooltip: root.strings.tab-new-tooltip;
            show-tooltip: root.tab-tooltip-enabled;
            reorder-here: root.tab-mode == 2 && root.drag-active
                && root.drag-over && root.drag-in-bar;
            reorder-cur: root.drag-abs-y - root.vtabs-col-y - self.vp-y;
            cursor-in-bar-y: root.drag-abs-y - root.vtabs-col-y;
            preview-idx: root.tab-mode == 2 ? root.drag-preview-idx : -1;
            preview-pos: root.tab-drop-x;
            claim-drop(g, gy) => { root.report-tab-drop(g, gy); }
            tab-clicked(i) => { root.activate(); root.tab-clicked(i); }
            tab-closed(i) => { root.activate(); root.tab-closed(i); }
            tab-context(i, x, y) => { root.activate(); root.tab-context(i, x, y); }
            tab-drag-progress(i, ax, ay) => { root.tab-drag-progress(i, ax, ay); }
            tab-drag-completed(i, ax, ay) => {
                root.tab-drag-completed(i, root.drag-preview-idx, ax, ay);
            }
            tab-new => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
            bar-clicked => { root.activate(); root.close-ctx-menu(); }
            bar-context(x, y) => { root.activate(); root.tab-bar-context(x, y); }
            wheel(fwd) => { tabsbar.tab-wheel(fwd); }
            scrolled(vy) => { root.tabs-scrolled(vy); }
            scroll-target(ti, fwd, vp, vw) => {
                return root.scroll-target(ti, fwd, vp, vw);
            }
            // Resize (bar on the RIGHT): width = bar's right edge
            // (panel + width − padding 7) − mouse.
            grip-moved(ax) => {
                root.vbar-live-w = root.absolute-position.x + root.width - 7px - ax;
            }
            grip-done => { root.vbar-resized(root.vbar-w); }
        }
    } // closes the root row [left bar · content · right bar]

    // ===== Left gutter: draggable strip =====
    // The `body-left` inset is VISUALLY part of the gutter, but no
    // TouchArea in the body can cover it: `list-area` has `clip: true` and the
    // Flickable also clips — and a clip bounds the HIT-TEST just as much as the rendering.
    // (Trying to extend `sel-touch` toward negative x's therefore fails, and on
    // top of that shifts all its local coordinates.) We place here, as the last child of
    // content-clip — so above the root row and `activate-bg`, but
    // BELOW the panel's overlays (context menu, drop targets) — a
    // strip that drives the SAME rubber-band: same `rb-*` properties, same
    // callbacks, same auto-scroll (the Timer only reads root properties).
    // Coordinates converted into `list-area`'s frame (`x - body-left`, hence
    // always negative): consistent with `row-idx-at-xy`, which sees it as a dead
    // zone there. Zero width when the LEFT vertical tab bar is
    // displayed: that space then belongs to it.
    gutter-strip := TouchArea {
        x: 0;
        y: root.body-top;
        width: root.tab-mode == 1 ? 0px : root.list-inset-x;
        height: list-area.height;

        property <length> down-x;   // list-area position (negative)
        property <length> down-y;
        property <bool> dragging;
        // Modifiers stored on press (event = authoritative source) →
        // rubber-band mode robust to a keyboard focus loss.
        property <bool> down-ctrl: false;
        property <bool> down-shift: false;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down
                    && ev.button == PointerEventButton.left) {
                root.activate();
                root.close-ctx-menu();
                self.down-x = self.mouse-x - root.list-inset-x;
                self.down-y = self.mouse-y;
                self.down-ctrl = ev.modifiers.control;
                self.down-shift = ev.modifiers.shift;
                self.dragging = false;
            }
            if (ev.kind == PointerEventKind.up
                    && ev.button == PointerEventButton.left) {
                if (self.dragging) {
                    root.rb-active = false;   // clean end of the rubber-band
                } else {
                    // Plain click on the blank area → deselection, like the
                    // inner gutter (see `sel-touch`).
                    root.deselect-all();
                }
                self.dragging = false;
            }
        }

        moved => {
            if (self.pressed) {
                if (!self.dragging
                        && (abs(self.mouse-x - root.list-inset-x - self.down-x) > 4px
                            || abs(self.mouse-y - self.down-y) > 4px)) {
                    self.dragging = true;
                    root.rb-active = true;
                    root.rubber-band-begin(self.down-ctrl ? 2 : (self.down-shift ? 1 : 0));
                    root.rb-anchor-x = self.down-x;
                    root.rb-anchor-cy = self.down-y - rows-scroll.viewport-y;
                }
                if (self.dragging) {
                    root.rb-cur-x = self.mouse-x - root.list-inset-x;
                    root.rb-cur-vy = self.mouse-y;
                    root.rubber-band-update(
                        min(root.rb-anchor-x, root.rb-cur-x),
                        min(root.rb-anchor-cy, root.rb-cur-cy),
                        max(root.rb-anchor-x, root.rb-cur-x),
                        max(root.rb-anchor-cy, root.rb-cur-cy),
                    );
                }
            }
        }
    }
    } // closes content-clip (rectangular clip wrapper = crisp)

    // ===== File drop target =====
    // Veil + accent outline on the hovered view during a file drag
    // (except the source view). Purely visual (no TouchArea).
    if root.file-drag-over && !root.is-file-drag-source : Rectangle {
        background: Theme.accent-background.with-alpha(0.10);
        border-width: 2px;
        border-color: Theme.accent-background;
        border-radius: Tokens.radius-panel;
    }

    // ===== Close / merge previews =====
    // (A) Hovering the "x" → RED veil (explicit close = destruction).
    if root.close-hover : Rectangle {
        background: Tokens.danger.with-alpha(0.10);
    }
    // (B) Dragging the last tab → NEUTRAL grey veil (absorption, not danger).
    // The content is additionally faded to 55% (see the VerticalLayout's opacity).
    if root.leaving : Rectangle {
        background: Theme.foreground.with-alpha(0.05);
    }
    // (C) Swap: both views of the pair carry the SAME mark, at the same
    // instant. Two scales of one signal — the veil carries far, and is what
    // makes the far end of the pair noticed across the screen; the inner filet
    // says the verb up close.
    //
    // A filet was chosen over a fill because it is one pixel whatever the
    // tile's area: the two members of a pair weigh the same to the eye even
    // when their sizes do not. And the accent outline alone could not carry
    // the message — the view being carried is almost always the ACTIVE one,
    // which already wears it.
    //
    // Nothing fades here. Fading to 55% is the word for "this view dissolves",
    // which is true of an absorption and false of a swap: nothing is lost, it
    // comes back elsewhere.
    //
    // These two are NOT conditional, unlike the veils above: they fade rather
    // than cut, and an element that comes and goes cannot fade. The colour
    // itself is animated, so no layer is forced on the subtree. At rest both
    // are fully transparent.
    Rectangle {
        background: root.swap-lit
            ? Theme.accent-background.with-alpha(0.08)
            : Theme.accent-background.with-alpha(0.0);
        animate background { duration: 110ms; easing: ease-out; }
    }
    // Inset by 3px, so the filet runs on the bare surface ring that
    // `Tokens.panel-pad` leaves all around the content: no listing, no
    // thumbnail, however colourful, ever reaches it.
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        background: transparent;
        border-width: 1px;
        border-color: root.swap-lit
            ? Theme.accent-background.with-alpha(0.45)
            : Theme.accent-background.with-alpha(0.0);
        border-radius: Tokens.radius-panel - 3px;
        animate border-color { duration: 110ms; easing: ease-out; }
    }

    // ===== Drop zone overlay =====
    // During a tab drag, the hovered panel shows the candidate zone:
    // the accent plate occupies the half the new panel would take (or
    // the whole panel in the center = move), + an oriented cut line.
    // Only one zone visible at a time (by design): only the panel under the
    // cursor has `drag-over`. Purely visual (no TouchArea → intercepts
    // nothing; the drag stays driven by the tab).
    // No plate when the tab insertion line is active (header):
    // strip → insertion line; body → zone plate. Clean separation.
    if root.drag-panel-zones && root.drag-over
            && (root.drag-zone == 1 || root.drag-panel-split-edges)
            && root.drag-zone > 0 && root.drag-preview-idx < 0 : Rectangle {
        // Candidate plate.
        Rectangle {
            x: root.drag-zone == 3 ? root.width / 2 : 0px;
            y: root.drag-zone == 5 ? root.height / 2 : 0px;
            width: (root.drag-zone == 2 || root.drag-zone == 3) ? root.width / 2 : root.width;
            height: (root.drag-zone == 4 || root.drag-zone == 5) ? root.height / 2 : root.height;
            background: Theme.accent-background.with-alpha(0.16);
            border-width: 2px;
            border-color: Theme.accent-background.with-alpha(0.9);
            border-radius: Tokens.radius-overlay;
        }
        // Cut line — vertical (side by side) or horizontal (stacked).
        if root.drag-zone == 2 || root.drag-zone == 3 : Rectangle {
            x: root.width / 2 - 1px;
            width: 2px;
            height: root.height;
            background: Theme.accent-background;
        }
        if root.drag-zone == 4 || root.drag-zone == 5 : Rectangle {
            y: root.height / 2 - 1px;
            width: root.width;
            height: 2px;
            background: Theme.accent-background;
        }
    }
}

