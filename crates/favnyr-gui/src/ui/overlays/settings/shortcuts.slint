// The "Shortcuts" tab of the Settings dialog: the search field, the
// per-group rows (capture, reset, conflict resolution) and the click that
// raises the "unassign" menu.
//
// Extracted from overlays/settings.slint. The dialog shell keeps the tab
// strip and the shortcut context menu — declared there so it renders above
// the panel — and this page owns the tab content only.

import { ShortcutGroup, Strings } from "../../structs.slint";
import { Dismiss, Theme, Tokens } from "../../theme.slint";
import { SearchField } from "../../widgets/inputs.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsShortcuts inherits ScrollView {
    in property <Strings> strings;
    in property <[ShortcutGroup]> shortcut-groups;
    in property <bool> shortcut-has-overrides;
    in property <string> shortcut-conflict-action;
    in property <string> shortcut-conflict-message;
    in-out property <string> shortcut-capturing: "";
    in-out property <string> shortcut-search-text: "";

    callback shortcut-search(string);
    callback shortcut-reset(string);
    callback shortcut-reset-all();
    callback shortcut-resolve-conflict(bool);
    callback open-shortcut-menu(string, length, length);
    // Clicking a shortcut row starts a capture, and the chord has to reach
    // the window focus scope; the shell forwards this to the window.
    callback return-focus();

    VerticalLayout {
        padding: 20px;
        spacing: 18px;
        sc-box := VerticalLayout {
            spacing: 10px;
            property <bool> reset-all-armed: false;

            // Header: search + reset all
            HorizontalLayout {
                spacing: 8px;
                SearchField {
                    horizontal-stretch: 1;
                    placeholder-text: root.strings.shortcut-search-placeholder;
                    text <=> root.shortcut-search-text;
                    edited(value) => { root.shortcut-search(value); }
                }
                if root.shortcut-has-overrides : Rectangle {
                    height: 32px;
                    width: rall-text.preferred-width + 24px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: rall-touch.has-hover ? Theme.accent-background : Theme.border;
                    background: rall-touch.has-hover ? Theme.alternate-background : transparent;
                    rall-text := Text {
                        text: sc-box.reset-all-armed
                            ? root.strings.shortcut-reset-all-confirm
                            : root.strings.shortcut-reset-all;
                        font-size: 12px;
                        color: sc-box.reset-all-armed ? Tokens.danger : Theme.foreground;
                        x: (parent.width - self.width) / 2;
                        vertical-alignment: center;
                    }
                    rall-touch := TouchArea {
                        pointer-event(ev) => {
                            // Same rule as the rows: consumed here, so reported here.
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.left) {
                                Dismiss.serial += 1;
                            }
                        }
                        clicked => {
                            if (sc-box.reset-all-armed) {
                                root.shortcut-reset-all();
                                sc-box.reset-all-armed = false;
                            } else {
                                sc-box.reset-all-armed = true;
                            }
                        }
                    }
                }
            }

            // Grouped list
            for grp[gi] in root.shortcut-groups : VerticalLayout {
                spacing: 0px;
                Text {
                    text: grp.name;
                    font-weight: 600;
                    font-size: 11px;
                    color: Theme.foreground.with-alpha(0.5);
                    letter-spacing: 0.5px;
                    height: 28px;
                    vertical-alignment: bottom;
                }
                Rectangle {
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 0px;
                        for row[ri] in grp.rows : VerticalLayout {
                            spacing: 0px;
                            // Main row
                            Rectangle {
                                height: 36px;
                                border-radius: 5px;
                                background: row-hover.has-hover ? Theme.alternate-background : transparent;
                                row-hover := TouchArea {
                                    pointer-event(ev) => {
                                        // Reported like every other click inside this
                                        // tab: a touch area consumes what it receives,
                                        // so the panel's catch-all underneath never
                                        // hears it and the floating menu would survive.
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.left) {
                                            Dismiss.serial += 1;
                                        }
                                        if (ev.kind == PointerEventKind.down
                                                && ev.button == PointerEventButton.right) {
                                            root.open-shortcut-menu(row.action-id,
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: row.name;
                                        font-size: 13px;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    if row.overridden : Rectangle {
                                        width: 22px;
                                        Image {
                                            width: 13px;
                                            height: 13px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../../../assets/icons/refresh.svg");
                                            colorize: rst-touch.has-hover ? Theme.accent-background : Theme.foreground.with-alpha(0.55);
                                        }
                                        rst-touch := TouchArea {
                                            clicked => { root.shortcut-reset(row.action-id); }
                                            pointer-event(ev) => {
                                                // Same rule as the rows: consumed here, so reported here.
                                                if (ev.kind == PointerEventKind.down
                                                        && ev.button == PointerEventButton.left) {
                                                    Dismiss.serial += 1;
                                                }
                                            }
                                        }
                                    }
                                    // Clickable cluster: capture pill / caps / unassigned
                                    Rectangle {
                                        width: sc-cluster.preferred-width;
                                        sc-cluster := HorizontalLayout {
                                            spacing: 3px;
                                            if root.shortcut-capturing == row.action-id : Rectangle {
                                                height: 24px;
                                                width: 168px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: Theme.accent-background;
                                                background: Theme.accent-background.with-alpha(0.10);
                                                Text {
                                                    text: root.strings.shortcut-listening;
                                                    font-size: 11px;
                                                    color: Theme.accent-background;
                                                    x: (parent.width - self.width) / 2;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if root.shortcut-capturing != row.action-id && row.assigned : HorizontalLayout {
                                                spacing: 3px;
                                                for cap[ci] in row.caps : HorizontalLayout {
                                                    spacing: 3px;
                                                    if ci > 0 : Text {
                                                        text: "+";
                                                        font-size: 11px;
                                                        color: Theme.foreground.with-alpha(0.45);
                                                        vertical-alignment: center;
                                                    }
                                                    Rectangle {
                                                        height: 22px;
                                                        width: cap.kind == 0 ? max(24px, cap-lbl.preferred-width + 14px) : 24px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                        background: Theme.surface;
                                                        cap-lbl := Text {
                                                            visible: cap.kind == 0;
                                                            text: cap.label;
                                                            font-size: 11px;
                                                            font-weight: 600;
                                                            color: Theme.foreground;
                                                            x: (parent.width - self.width) / 2;
                                                            vertical-alignment: center;
                                                        }
                                                        if cap.kind != 0 : Image {
                                                            width: 11px;
                                                            height: 11px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            colorize: Theme.foreground;
                                                            source: cap.kind == 1 ? @image-url("../../../../assets/icons/arrow-up.svg")
                                                                : cap.kind == 2 ? @image-url("../../../../assets/icons/arrow-down.svg")
                                                                : cap.kind == 3 ? @image-url("../../../../assets/icons/chevron-left.svg")
                                                                : @image-url("../../../../assets/icons/chevron-right.svg");
                                                        }
                                                    }
                                                }
                                            }
                                            if root.shortcut-capturing != row.action-id && !row.assigned : Text {
                                                text: root.strings.shortcut-unassigned;
                                                font-size: 11px;
                                                font-italic: true;
                                                color: Theme.foreground.with-alpha(0.4);
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.shortcut-capturing = row.action-id;
                                                root.return-focus();
                                            }
                                            pointer-event(ev) => {
                                                // Above the panel's catch-all, so this
                                                // row reports its own left click: without
                                                // it, the menu opened on one row survived
                                                // a click on the next.
                                                if (ev.kind == PointerEventKind.down
                                                        && ev.button == PointerEventButton.left) {
                                                    Dismiss.serial += 1;
                                                }
                                                if (ev.kind == PointerEventKind.down
                                                        && ev.button == PointerEventButton.right) {
                                                    root.open-shortcut-menu(row.action-id,
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // Conflict band
                            if row.action-id == root.shortcut-conflict-action : Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: Tokens.danger.with-alpha(0.12);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: root.shortcut-conflict-message;
                                        font-size: 11px;
                                        color: Tokens.danger;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: ra-text.preferred-width + 18px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: Theme.accent-background;
                                        background: ra-touch.has-hover ? Theme.accent-background.with-alpha(0.12) : transparent;
                                        ra-text := Text {
                                            text: root.strings.shortcut-conflict-reassign;
                                            font-size: 11px;
                                            color: Theme.accent-background;
                                            x: (parent.width - self.width) / 2;
                                            vertical-alignment: center;
                                        }
                                        ra-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(true); } }
                                    }
                                    Rectangle {
                                        width: rk-text.preferred-width + 18px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        background: rk-touch.has-hover ? Theme.alternate-background : transparent;
                                        rk-text := Text {
                                            text: root.strings.shortcut-conflict-keep;
                                            font-size: 11px;
                                            color: Theme.foreground;
                                            x: (parent.width - self.width) / 2;
                                            vertical-alignment: center;
                                        }
                                        rk-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(false); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if root.shortcut-groups.length == 0 : Text {
                text: root.strings.shortcut-no-results;
                color: Theme.foreground.with-alpha(0.5);
                font-size: 12px;
                height: 40px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
