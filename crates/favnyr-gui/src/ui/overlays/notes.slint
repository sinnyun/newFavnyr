// Two kinds of note live here. The popups — the rename box, the note
// editor, the new folder/file/shortcut form and the cleanup list for colours
// and notes — plus the transient bubble that reads a row's note back.
//
// Extracted from main_window.slint. The forms are two-way (they edit the
// window properties the bridge validates and reads back), the validation
// flags and error lines are inputs, and the dwell timer keeps owning the
// `Note` global exactly as it did at the window root.

import { OrphanRow, Strings } from "../structs.slint";
import { Note, Theme, Tokens } from "../theme.slint";
import { EditLineEdit, FieldLink } from "../widgets/inputs.slint";
import { MarkBox } from "../widgets/rows/marks.slint";
import { DeferredLineEditFocus, ModalBackdrop } from "../widgets/tabs.slint";
import { Button, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export component OverlayNotes inherits Rectangle {
    // Transparent, full-window host; the popups centre themselves on it.
    width: 100%;
    height: 100%;

    in property <Strings> strings;
    in property <bool> platform-windows: false;
    // The popups hand focus back to the window's keyboard scope when they
    // close, so Escape and the shortcuts keep working.
    callback return-focus();

    // Rename popup.
    in-out property <bool> rename-popup-open: false;
    in property <string> rename-current-name;
    in property <bool> rename-current-is-dir: false;
    in-out property <string> rename-new-name;
    in property <bool> rename-conflict: false;
    in property <string> rename-name-error: "";
    in property <bool> rename-replace-available: false;
    in-out property <bool> rename-focus-armed: false;
    callback rename-check(string);
    callback rename-confirmed(string);
    callback rename-force-replace(string) -> bool;

    // Entry-note editor.
    in-out property <bool> comment-popup-open: false;
    in property <string> comment-target-name;
    in property <string> comment-text;
    in-out property <bool> comment-focus-armed: false;
    callback comment-confirmed(string);

    // New folder / file / shortcut / link form.
    in-out property <bool> create-popup-open: false;
    in property <int> create-kind: 0;
    in-out property <string> create-name;
    in property <string> create-name-error: "";
    in-out property <string> create-target;
    in-out property <bool> create-shortcut-folder: true;
    in-out property <bool> create-link-symlink: false;
    in-out property <bool> create-focus-armed: false;
    in property <bool> create-can-confirm: false;
    callback create-confirmed(int, string, string) -> bool;
    callback create-browse-target();

    // Cleanup list for colours and notes.
    in-out property <bool> orphans-open: false;
    in property <[OrphanRow]> orphan-rows;
    in property <string> orphans-confirm-label;
    in property <int> orphans-checked: 0;
    callback orphan-toggled(string, bool);
    callback orphans-select-all(bool);
    callback orphans-confirmed();

    // Caret placement before a file's extension (bridge-side rule, shared
    // with the paste-conflict popup).
    callback filename-caret-offset(string, bool) -> int;

    // ===== Rename popup =====
    // Lightweight modal: title + current name + LineEdit + Cancel/Rename.
    // The backdrop absorbs clicks (TouchArea with no handler); only X / Escape
    // / Cancel / Enter close it.
    // ===== Note editor — same shell as the rename popup, without its
    // conflict states: a note has nothing to collide with.
    if root.comment-popup-open : ModalBackdrop { }
    if root.comment-popup-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 210px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        DeferredLineEditFocus {
            armed <=> root.comment-focus-armed;
            apply-focus => {
                comment-edit.focus();
                // Whole text selected: reopening the editor on an existing
                // note is most often about replacing it.
                comment-edit.select-all();
            }
        }

        VerticalBox {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.strings.comment-title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            Text {
                text: root.comment-target-name;
                color: Theme.foreground.with-alpha(0.7);
                font-size: 12px;
                overflow: elide;
            }
            // The note as it stands is copied in when the field is
            // built. The popup is a conditional element, so it is built
            // afresh at every opening and this runs each time; the field
            // is then the one place the text lives until the dialog is
            // confirmed.
            comment-edit := EditLineEdit {
                placeholder-text: root.strings.comment-placeholder;
                init => { self.text = root.comment-text; }
                accepted(t) => {
                    root.comment-confirmed(t);
                    root.comment-popup-open = false;
                }
            }
            // Clearing the field and saving is what removes a note, so the
            // link is a shortcut to the first half rather than a third
            // action. Held on its own line, right-aligned, so it cannot be
            // taken for one of the two buttons below.
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                FieldLink {
                    text: root.strings.comment-clear;
                    clicked => {
                        comment-edit.text = "";
                        comment-edit.focus();
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.comment-popup-open = false; }
                }
                Button {
                    text: root.strings.fav-save;
                    primary: true;
                    clicked => {
                        root.comment-confirmed(comment-edit.text);
                        root.comment-popup-open = false;
                    }
                }
            }
        }
    }

    if root.rename-popup-open : ModalBackdrop { }
    if root.rename-popup-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 244px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        // Deferred focus (armed on opening): focus + caret before
        // a file's extension, or at the end for a folder.
        DeferredLineEditFocus {
            armed <=> root.rename-focus-armed;
            apply-focus => {
                rename-edit.focus();
                let offset = root.filename-caret-offset(
                    root.rename-new-name, root.rename-current-is-dir);
                rename-edit.set-selection-offsets(offset, offset);
            }
        }

        VerticalBox {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.strings.rename-title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            Text {
                text: root.strings.rename-current-prefix + root.rename-current-name;
                color: Theme.foreground.with-alpha(0.7);
                font-size: 12px;
                overflow: elide;
            }
            rename-edit := EditLineEdit {
                placeholder-text: root.strings.rename-new-placeholder;
                text <=> root.rename-new-name;
                // Live validation carried by the widget — same mechanism as the
                // paste-conflict popup (`pc-edit`). Avoids a global
                // `changed` that would call back into Rust on every write to the property,
                // including those made by the bridge on opening.
                edited(t) => { root.rename-check(t); }
                accepted(t) => {
                    // Confirmation blocked on conflict (same guard as paste).
                    if (!root.rename-conflict && t != "") {
                        root.rename-confirmed(t);
                        root.rename-popup-open = false;
                    }
                }
            }
            // Why the name is refused: already taken, or unusable on this
            // filesystem. The bridge decides and translates.
            //
            // The field helper shares this line. It belongs to the text
            // field it acts on rather than to the dialog's actions, and the
            // line is held open in any case — a blank space keeps its
            // height when there is no error — so the card does not grow.
            // When the helper is most useful, right after opening, the line
            // is empty and it sits alone.
            HorizontalBox {
                padding: 0px;
                Text {
                    text: root.rename-name-error == "" ? " " : root.rename-name-error;
                    color: Tokens.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                // Selects the name WITHOUT its extension, through the very
                // offset the deferred focus above uses to place the caret —
                // one rule for where a name ends, not two that could
                // disagree. A folder, or a file with no extension, has
                // nothing to set aside: the whole name is selected.
                FieldLink {
                    text: root.strings.rename-select-name;
                    clicked => {
                        rename-edit.focus();
                        rename-edit.set-selection-offsets(0,
                            root.filename-caret-offset(
                                root.rename-new-name,
                                root.rename-current-is-dir));
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.rename-popup-open = false; }
                }
                if root.rename-replace-available : Button {
                    text: root.strings.rename-force-replace;
                    clicked => {
                        if (root.rename-force-replace(root.rename-new-name)) {
                            root.rename-popup-open = false;
                        }
                    }
                }
                Button {
                    text: root.strings.rename-confirm;
                    primary: true;
                    enabled: !root.rename-conflict && root.rename-new-name != "";
                    clicked => {
                        root.rename-confirmed(root.rename-new-name);
                        root.rename-popup-open = false;
                    }
                }
            }
        }
    }

    // ===== New folder / file / shortcut popup (empty-area) =====
    // Same modal pattern as Rename: backdrop + centered card + deferred
    // focus (caret adapted to the type). `create-kind` picks the title/action; shortcut
    // mode (2) adds a "Target" field → taller card.
    if root.create-popup-open : ModalBackdrop { }
    if root.create-popup-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: root.create-kind == 2 ? 290px : (root.create-kind == 3 ? 258px : 220px);
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        DeferredLineEditFocus {
            armed <=> root.create-focus-armed;
            apply-focus => {
                create-edit.focus();
                // Only kind 0 is a folder. File, .lnk shortcut and
                // symlink are all file entries and share the rule.
                let offset = root.filename-caret-offset(
                    root.create-name, root.create-kind == 0);
                create-edit.set-selection-offsets(offset, offset);
            }
        }

        VerticalBox {
            padding: 18px;
            spacing: 10px;

            Text {
                text: root.create-kind == 0
                    ? root.strings.ctx-new-folder
                    : (root.create-kind == 1 ? root.strings.ctx-new-file
                        : (root.create-kind == 2 ? root.strings.ctx-new-shortcut
                            : root.strings.ctx-create-link));
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            create-edit := EditLineEdit {
                placeholder-text: root.strings.create-placeholder;
                text <=> root.create-name;
                accepted(t) => {
                    if (root.create-can-confirm
                        && root.create-confirmed(root.create-kind, t, root.create-target)) {
                        root.create-popup-open = false;
                        // Returns focus to the view: a second Enter press opens
                        // the freshly created entry, which is selected.
                        root.return-focus();
                    }
                }
            }
            if root.create-kind == 0 || root.create-kind == 1 : Text {
                text: root.create-name-error == "" ? " " : root.create-name-error;
                color: Tokens.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
            // Shortcut mode only. Two tabs, Folder / File:
            // they determine the type of "Browse…" picker (folder vs
            // file) — creating the .lnk is identical either way.
            if root.create-kind == 2 : HorizontalBox {
                padding: 0px;
                spacing: 6px;
                Button {
                    text: root.strings.prop-kind-folder;
                    primary: root.create-shortcut-folder;
                    clicked => { root.create-shortcut-folder = true; }
                }
                Button {
                    text: root.strings.prop-kind-file;
                    primary: !root.create-shortcut-folder;
                    clicked => { root.create-shortcut-folder = false; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // "Target" field — the path can be typed OR chosen via the
            // native picker ("Browse…", folder or file depending on the tab).
            if root.create-kind == 2 : HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Text {
                    text: root.strings.create-shortcut-target;
                    font-size: 12px;
                    color: Theme.foreground.with-alpha(0.6);
                    vertical-alignment: center;
                }
                LineEdit {
                    placeholder-text: root.strings.create-shortcut-target;
                    text <=> root.create-target;
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.strings.create-browse;
                    clicked => { root.create-browse-target(); }
                }
            }
            // "Create link" mode (kind 3): Shortcut
            // (.lnk, Windows) / Symlink tabs, then a reminder of the target (selected
            // file). The link is created in the current folder.
            if root.create-kind == 3 : HorizontalBox {
                padding: 0px;
                spacing: 6px;
                // .lnk shortcut tab: Windows only.
                if root.platform-windows : Button {
                    text: root.strings.ctx-create-link;
                    primary: !root.create-link-symlink;
                    clicked => { root.create-link-symlink = false; }
                }
                Button {
                    text: root.strings.create-symlink-tab;
                    primary: root.create-link-symlink;
                    clicked => { root.create-link-symlink = true; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.create-kind == 3 : Text {
                text: "→ " + root.create-target;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.55);
                overflow: elide;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.create-popup-open = false; }
                }
                Button {
                    text: root.strings.create-confirm;
                    primary: true;
                    enabled: root.create-can-confirm;
                    clicked => {
                        if (root.create-confirmed(
                            root.create-kind, root.create-name, root.create-target
                        )) {
                            root.create-popup-open = false;
                            root.return-focus(); // focus view → 2nd Enter opens the created entry
                        }
                    }
                }
            }
        }
    }

    // ===== Cleanup list for colours and notes =====
    // What goes here is NOT a file — the file left long ago — but the
    // colour and the note it carried. A list of bare paths would hide the
    // very thing the question is about, so every row leads with what is
    // lost and keeps the path behind it, dimmed.
    //
    // Everything arrives ticked. Reaching this list already took opening
    // the settings and asking for a cleanup; what was missing was SEEING
    // what goes, not one more step to click through. Unticking is how an
    // entry is kept.
    if root.orphans-open : ModalBackdrop { }
    if root.orphans-open : Rectangle {
        // The width of the settings card underneath, so the two read as one
        // stack rather than two cards badly piled.
        width: 560px;
        // Grows with the list, then stops: nine rows at a time is what the
        // other lists of this application already show, and past that one
        // sweeps rather than reads.
        height: min(parent.height - 40px,
            min(620px, max(300px, 200px + root.orphan-rows.length * 46px)));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        VerticalBox {
            padding: 18px;
            spacing: 10px;

            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Image {
                    source: @image-url("../../../assets/icons/trash.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Tokens.danger;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.strings.annotations-cleanup-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            // The sentence the settings block already shows, word for word,
            // including what is never touched: one wording to keep true
            // rather than two that could drift.
            Text {
                text: root.strings.settings-annotations-hint;
                font-size: 12px;
                color: Theme.foreground.with-alpha(0.8);
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.alternate-background.with-alpha(0.5);
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                // The count was taken when the panel opened; an item
                // restored from the trash since then leaves nothing to do.
                if root.orphan-rows.length == 0 : Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.strings.annotations-cleanup-empty;
                    font-size: 13px;
                    color: Theme.foreground.with-alpha(0.6);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if root.orphan-rows.length > 0 : ScrollView {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        for row in root.orphan-rows : Rectangle {
                            height: 44px;
                            border-radius: 5px;
                            background: orow.has-hover
                                ? Theme.alternate-background
                                : transparent;
                            // The whole row answers: a 16px box is a small
                            // target in a list one sweeps through.
                            orow := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.orphan-toggled(row.key, !row.checked);
                                }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 10px;
                                MarkBox {
                                    checked: row.checked;
                                    y: (parent.height - self.height) / 2;
                                    toggled(on) => {
                                        root.orphan-toggled(row.key, on);
                                    }
                                }
                                // The colour, and under it the quote bar of
                                // the note: one narrow column that reads as
                                // a small stave down the left of the row.
                                VerticalLayout {
                                    width: 14px;
                                    alignment: center;
                                    spacing: 2px;
                                    Rectangle {
                                        height: 14px;
                                        // No colour to lose: nothing is
                                        // drawn. An empty ring would be
                                        // wrong — in the palette it already
                                        // means "the default gold".
                                        if row.slot > 0 : Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 4px;
                                            background: Tokens.folder-color(row.slot);
                                            opacity: row.checked ? 1.0 : 0.35;
                                            animate opacity {
                                                duration: 110ms;
                                                easing: ease-out;
                                            }
                                        }
                                    }
                                    if row.note != "" : Rectangle {
                                        height: 14px;
                                        Rectangle {
                                            x: 6px;
                                            width: 2px;
                                            height: 14px;
                                            border-radius: 1px;
                                            background: Theme.foreground.with-alpha(0.30);
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 0px;
                                        // The folder still exists — that is
                                        // the very rule that made this an
                                        // orphan — so it is context, not
                                        // the subject. Dimmed, and elided
                                        // from the LEFT: the tail, next to
                                        // the name, is what tells two alike
                                        // apart.
                                        Text {
                                            text: row.parent;
                                            font-size: 13px;
                                            color: Theme.foreground.with-alpha(
                                                row.checked ? 0.50 : 0.28);
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: row.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground.with-alpha(
                                                row.checked ? 1.0 : 0.45);
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    if row.note != "" : Text {
                                        text: row.note;
                                        font-size: 12px;
                                        color: Theme.foreground.with-alpha(
                                            row.checked ? 0.72 : 0.32);
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 10px;
                FieldLink {
                    text: root.strings.annotations-cleanup-all;
                    clicked => { root.orphans-select-all(true); }
                }
                FieldLink {
                    text: root.strings.annotations-cleanup-none;
                    clicked => { root.orphans-select-all(false); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.orphans-open = false; }
                }
                Button {
                    // Destructive, so deliberately NOT primary: the house
                    // rule is that an irreversible action lets Cancel go
                    // first. The label carries the count, so the last thing
                    // read before confirming is how many go.
                    text: root.orphans-confirm-label;
                    enabled: root.orphans-checked > 0;
                    clicked => {
                        root.orphans-confirmed();
                        root.orphans-open = false;
                    }
                }
            }
        }
    }
}

// The transient note bubble and its dwell timer: a note is shown only once
// the pointer has rested on the same row for a whole tick, and the timer
// stops itself as soon as nothing is pending and nothing is shown.
//
// The `Note` global owns the state, so this component needs no members.

export component OverlayNoteBubble inherits Rectangle {
    // Transparent, full-window host; the bubble clamps itself to it.
    width: 100%;
    height: 100%;

    // Dwell before a note bubble appears, and the wait that hides it
    // again. Same polling shape as `FlyoutCloseTimer`: the note is shown
    // only once the pointer has rested on the same row for a whole tick,
    // so crossing a list on the way somewhere else never flashes one.
    // The timer stops itself as soon as nothing is pending and nothing is
    // shown, rather than ticking for the life of the window.
    Timer {
        interval: 220ms;
        running: Note.pending != "" || Note.text != "";
        triggered => {
            if (Note.pending != "" && Note.pending == Note.last-seen) {
                Note.text = Note.pending;
                Note.x = Note.pending-x;
                Note.shown-top = Note.row-top;
                Note.shown-bottom = Note.row-bottom;
            } else {
                Note.text = "";
            }
            Note.last-seen = Note.pending;
        }
    }

    // ===== The note attached to an entry, rendered just under the global
    // tooltip: a tooltip is the more transient of the two, so it wins.
    //
    // The bubble takes the width of the note it carries, capped at
    // 280px — the width the shell cascade already uses, and narrow enough
    // that the bubble never blankets the row it annotates. A short note
    // therefore gets a short bubble instead of a wide, mostly empty one.
    //
    // `preferred-width` is the text's OWN measure, what a single line
    // would need; it does not depend on the box the text sits in, so
    // reading it to size that box closes no circle. Beyond the cap the
    // text wraps and the height follows.
    if Note.text != "" : note-bubble := Rectangle {
        property <length> box-w: min(280px, gnote.preferred-width + 24px);
        x: clamp(Note.x, 4px, max(4px, parent.width - self.width - 4px));
        // Under the row by default; above it when the window ends too soon.
        // Clamping instead would drop the bubble onto the very row it
        // describes, hiding what the user is pointing at.
        y: (Note.shown-bottom + 4px + self.height <= parent.height - 4px)
            ? Note.shown-bottom + 4px
            : max(4px, Note.shown-top - 4px - self.height);
        width: self.box-w;
        height: gnote.preferred-height + 20px;
        background: Theme.background;
        border-radius: Tokens.radius-overlay;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-color: #000000.with-alpha(0.25);
        drop-shadow-offset-y: 4px;
        gnote := Text {
            x: 12px;
            y: 10px;
            width: note-bubble.box-w - 24px;
            text: Note.text;
            font-size: 12px;
            color: Theme.foreground;
            wrap: word-wrap;
            horizontal-alignment: left;
        }
    }
}
