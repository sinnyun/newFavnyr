// The named-workspaces overlay: the save row, the list of saved workspaces
// and its feedback toast.
//
// Extracted from main_window.slint. `workspaces-open`, `ws-toast` and
// `ws-name-focus-armed` are two-way: the overlay closes itself, clears its
// own toast after the countdown and disarms the deferred focus. The rest is
// a list plus the actions the bridge runs.

import { Strings, WorkspaceEntry } from "../structs.slint";
import { Theme, Tokens } from "../theme.slint";
import { EditTextInput } from "../widgets/inputs.slint";
import { DeferredLineEditFocus, ModalBackdrop } from "../widgets/tabs.slint";
import { WorkspaceRow } from "../workspaces.slint";
import { ScrollView } from "std-widgets.slint";

export component OverlayWorkspaces inherits Rectangle {
    // Transparent, full-window host; the card centres itself on it.
    width: 100%;
    height: 100%;

    in property <Strings> strings;

    in-out property <bool> workspaces-open: false;
    in property <[WorkspaceEntry]> workspaces;
    in-out property <string> ws-toast: "";
    in property <bool> ws-sort-newest-first: true;
    in property <bool> ws-name-taken: false;
    in-out property <bool> ws-name-focus-armed: false;

    callback ws-save-new(string);
    callback ws-name-check(string);
    callback ws-load-guarded(string);
    callback ws-overwrite(string);
    callback ws-delete(string);
    callback ws-rename(string, string);
    callback ws-reset-guarded();
    callback ws-toggle-sort();

    // ===== Workspaces overlay =====
    if root.workspaces-open : ModalBackdrop { }
    if root.workspaces-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        // Adaptive height driven by the list's ACTUAL content.
        // A row measures 44px and the spacing between two rows 4px; the
        // bottom padding adds 12px, i.e. `48 * N + 8` in total. The old
        // formula started at 480px and then added these rows on top: three
        // workspaces were therefore enough to reach 620px while leaving a
        // large empty area in the ScrollView.
        property <length> ws-list-ideal-height:
            root.workspaces.length == 0
                ? 112px
                : 8px + root.workspaces.length * 48px;
        // 188px cover the header, Save area, separators, and list
        // title. The name-taken warning adds its own line. 300px remains
        // a readable minimum for the empty state; beyond 620px the list
        // scrolls. The window bound keeps priority on small screens.
        property <length> ws-card-ideal-height:
            188px + self.ws-list-ideal-height + (root.ws-name-taken ? 21px : 0px);
        height: min(
            parent.height - 40px,
            min(620px, max(300px, self.ws-card-ideal-height)));
        background: Theme.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        // Toast timer: clears the message after 2s.
        Timer {
            interval: 2s;
            running: root.ws-toast != "";
            triggered => { root.ws-toast = ""; }
        }

        // Deferred focus of the "name" field (armed by the bridge on Ctrl+S of a
        // still-unnamed workspace). Same shared component as the
        // Rename / New / Paste-conflict popups.
        DeferredLineEditFocus {
            armed <=> root.ws-name-focus-armed;
            apply-focus => { ws-name-input.focus(); }
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Header + X
            Rectangle {
                height: 48px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;
                    Text {
                        text: root.strings.ws-title;
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // "Start a new workspace" button: starts over from the
                    // 1st-launch state (1 panel, $HOME). Goes through the
                    // guard — the bridge resets+closes if the current state
                    // is clean, otherwise opens the warning dialog.
                    Rectangle {
                        width: ws-reset-text.preferred-width + 22px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: ws-reset-touch.has-hover
                            ? Theme.accent-background
                            : Theme.border;
                        background: ws-reset-touch.has-hover
                            ? Theme.alternate-background
                            : transparent;
                        ws-reset-text := Text {
                            text: root.strings.ws-reset;
                            font-size: 12px;
                            color: Theme.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ws-reset-touch := TouchArea {
                            mouse-cursor: pointer;
                            // The bridge decides: direct reset + close, or
                            // opening the dialog (which then closes itself).
                            clicked => { root.ws-reset-guarded(); }
                        }
                    }
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: ws-close-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
                        Image {
                            source: @image-url("../../../assets/icons/close.svg");
                            width: 14px;
                            height: 14px;
                            colorize: ws-close-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ws-close-touch := TouchArea {
                            clicked => { root.workspaces-open = false; }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // --- "Save" area (fixed, at the top) ---
            Rectangle {
                background: Theme.alternate-background.with-alpha(0.35);
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Text {
                        text: root.strings.ws-save-section;
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.foreground.with-alpha(0.55);
                        letter-spacing: 0.5px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 34px;
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.background;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: ws-name-input.has-focus
                                ? Theme.accent-background
                                : Theme.border;
                            ws-name-input := EditTextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: "";
                                font-size: 13px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                single-line: true;
                                selection-background-color: Theme.accent-background.with-alpha(0.5);
                                accepted => {
                                    if (self.text != "" && !root.ws-name-taken) {
                                        root.ws-save-new(self.text);
                                        self.text = "";
                                    }
                                }
                                changed text => { root.ws-name-check(self.text); }
                                Text {
                                    x: 0;
                                    visible: ws-name-input.text == "";
                                    text: root.strings.ws-name-placeholder;
                                    font-size: 13px;
                                    color: Theme.foreground.with-alpha(0.4);
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                            }
                        }
                        // Save button — disabled if the field is empty or if
                        // the name already exists (live validation by the bridge).
                        Rectangle {
                            width: 104px;
                            height: 34px;
                            border-radius: 6px;
                            property <bool> active: ws-name-input.text != "" && !root.ws-name-taken;
                            opacity: self.active ? 1.0 : 0.45;
                            background: save-touch.has-hover && self.active
                                ? Theme.accent-background.with-alpha(0.85)
                                : Theme.accent-background;
                            Text {
                                text: root.strings.ws-save-btn;
                                font-size: 12px;
                                color: Theme.accent-foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            save-touch := TouchArea {
                                enabled: parent.active;
                                clicked => {
                                    root.ws-save-new(ws-name-input.text);
                                    ws-name-input.text = "";
                                }
                            }
                        }
                    }
                    if root.ws-name-taken : Text {
                        text: root.strings.ws-name-taken;
                        font-size: 11px;
                        color: Tokens.danger;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }

            // --- "My workspaces (N)" section + scrollable list ---
            Rectangle {
                height: 14px;
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;
                Text {
                    text: root.strings.ws-saved-section + "  (" + root.workspaces.length + ")";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.foreground.with-alpha(0.55);
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // Sort direction toggle button (newest <-> oldest). The arrow
                // indicates the current direction (down = most recent on top).
                Rectangle {
                    width: ws-sort-text.preferred-width + 46px;
                    height: 22px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: ws-sort-touch.has-hover
                        ? Theme.accent-background
                        : Theme.border;
                    background: ws-sort-touch.has-hover
                        ? Theme.alternate-background
                        : transparent;
                    HorizontalLayout {
                        spacing: 5px;
                        alignment: center;
                        Rectangle {
                            width: 12px;
                            Image {
                                source: root.ws-sort-newest-first
                                    ? @image-url("../../../assets/icons/arrow-down.svg")
                                    : @image-url("../../../assets/icons/arrow-up.svg");
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.foreground;
                            }
                        }
                        ws-sort-text := Text {
                            text: root.ws-sort-newest-first
                                ? root.strings.ws-sort-newest
                                : root.strings.ws-sort-oldest;
                            font-size: 11px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                        }
                    }
                    ws-sort-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.ws-toggle-sort(); }
                    }
                }
            }
            Rectangle { height: 8px; }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 12px;
                    spacing: 4px;

                    // Empty state (title + bootstrap hint).
                    if root.workspaces.length == 0 : VerticalLayout {
                        padding-top: 30px;
                        spacing: 6px;
                        Text {
                            text: root.strings.ws-empty;
                            font-size: 13px;
                            color: Theme.foreground.with-alpha(0.6);
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.strings.ws-empty-hint;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.4);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    for ws[wi] in root.workspaces : WorkspaceRow {
                        name: ws.name;
                        panels: ws.panels;
                        tabs: ws.tabs;
                        is-current: ws.is-current;
                        is-dirty: ws.is-dirty;
                        strings: root.strings;
                        // Load GOES THROUGH the guard: the bridge loads
                        // directly if nothing is pending, otherwise it opens the
                        // dialog (which itself closes the overlay once loaded).
                        load => { root.ws-load-guarded(ws.id); }
                        // "Update" (amber pill) = save the current
                        // state, 1 direct click (clear intent). The hover ⟳
                        // of ANOTHER row keeps its 2-step confirmation.
                        update-now => { root.ws-overwrite(ws.id); }
                        overwrite => { root.ws-overwrite(ws.id); }
                        delete => { root.ws-delete(ws.id); }
                        rename(n) => { root.ws-rename(ws.id, n); }
                    }
                }
            }

            // --- Feedback toast (bottom band, auto-dismiss) ---
            if root.ws-toast != "" : Rectangle {
                height: 34px;
                background: Theme.accent-background.with-alpha(0.15);
                Rectangle { y: 0; height: 1px; background: Theme.border; }
                Image {
                    source: @image-url("../../../assets/icons/check.svg");
                    width: 13px;
                    height: 13px;
                    colorize: Theme.foreground;
                    x: 16px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.ws-toast;
                    font-size: 12px;
                    color: Theme.foreground;
                    x: 37px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }
}
