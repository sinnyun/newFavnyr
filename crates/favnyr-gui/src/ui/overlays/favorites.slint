// The favorites popups and the sidebar context menu: naming or renaming a
// container, "save as favorite" (with its container dropdown and alias
// field), the "new container" sub-popup raised from the save flow, and the
// container / favorite context menu.
//
// Extracted from main_window.slint. Everything the forms edit is two-way,
// including the container index of the dropdowns and the focus-armer flags
// the in-popup timers clear themselves.

import { Strings } from "../structs.slint";
import { Theme, Tokens } from "../theme.slint";
import { MenuItem } from "../widgets/menus.slint";
import { EditLineEdit } from "../widgets/inputs.slint";
import { ModalBackdrop } from "../widgets/tabs.slint";
import { Button, ComboBox, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component OverlayFavorites inherits Rectangle {
    // Transparent, full-window host; the popups centre themselves on it.
    width: 100%;
    height: 100%;

    in property <Strings> strings;

    // Container naming / renaming.
    in-out property <bool> fav-name-open: false;
    in property <bool> fav-name-rename: false;
    in-out property <string> fav-name-value: "";
    in property <bool> fav-name-invalid: true;
    in-out property <bool> fav-name-focus-armed: false;
    callback fav-name-check(string);
    callback fav-name-confirm();

    // "Save as favorite".
    in-out property <bool> fav-save-open: false;
    in property <string> fav-save-target: "";
    in property <bool> fav-save-multi: false;
    in-out property <string> fav-save-alias: "";
    in property <[string]> fav-container-labels;
    in-out property <int> fav-container-index: 0;
    callback fav-save-commit(string, int);
    callback fav-save-new-container(string, int);

    // "New container", raised from the save flow.
    in-out property <bool> fav-newc-open: false;
    in-out property <string> fav-newc-name: "";
    in-out property <int> fav-newc-parent-index: 0;
    in-out property <bool> fav-newc-focus-armed: false;

    // Sidebar container / favorite context menu.
    in-out property <bool> fav-menu-open: false;
    in-out property <length> fav-menu-x;
    in-out property <length> fav-menu-y;
    in-out property <bool> fav-menu-container: false;
    in-out property <bool> fav-menu-confirm-delete: false;
    in property <string> fav-menu-id: "";
    in property <string> fav-menu-name: "";
    callback fav-open(string);
    callback fav-open-all(string);
    callback fav-delete(string);
    callback fav-copy-path(string);
    callback open-fav-name(bool, string, string);

    // ===== Modal popup for naming or renaming a favorites container =====
    // It shares the rules of the other naming popups: validation via
    // `is_valid_entry_name`, deferred focus, and a disabled button if the name is invalid.
    if root.fav-name-open : ModalBackdrop { }
    if root.fav-name-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 196px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;

        Timer {
            interval: 1ms;
            running: root.fav-name-focus-armed;
            triggered => {
                favname-edit.focus();
                // Caret at the END of the line (no selection) — same behavior
                // as a folder name (see rename-edit).
                favname-edit.set-selection-offsets(99999, 99999);
                root.fav-name-focus-armed = false;
            }
        }

        VerticalBox {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.fav-name-rename ? root.strings.fav-rename : root.strings.fav-new-container;
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            favname-edit := EditLineEdit {
                placeholder-text: root.strings.create-placeholder;
                text <=> root.fav-name-value;
                edited(t) => { root.fav-name-check(t); }
                accepted(t) => {
                    if (!root.fav-name-invalid && t != "") { root.fav-name-confirm(); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.fav-name-open = false; }
                }
                Button {
                    text: root.fav-name-rename ? root.strings.rename-confirm : root.strings.create-confirm;
                    primary: true;
                    enabled: !root.fav-name-invalid && root.fav-name-value != "";
                    clicked => { root.fav-name-confirm(); }
                }
            }
        }
    }

    // ===== "Save as favorite" popup =====
    if root.fav-save-open : ModalBackdrop { }
    if root.fav-save-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 300px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;
        VerticalBox {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.strings.fav-popup-title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            // Target (path, or "N items").
            Text {
                text: root.fav-save-target;
                color: Theme.foreground.with-alpha(0.7);
                font-size: 12px;
                overflow: elide;
            }
            // Alias (single item).
            if !root.fav-save-multi : Text {
                text: root.strings.fav-popup-alias;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.3px;
                color: Theme.foreground.with-alpha(0.55);
            }
            if !root.fav-save-multi : fav-save-alias-edit := EditLineEdit {
                text <=> root.fav-save-alias;
            }
            // Target container.
            Text {
                text: root.strings.fav-popup-container;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.3px;
                color: Theme.foreground.with-alpha(0.55);
            }
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                ComboBox {
                    model: root.fav-container-labels;
                    current-index <=> root.fav-container-index;
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.strings.fav-popup-new;
                    clicked => {
                        // Opens the creation sub-popup (name + parent container).
                        root.fav-newc-name = root.strings.fav-new-container;
                        root.fav-newc-parent-index = root.fav-container-index;
                        root.fav-newc-open = true;
                        root.fav-newc-focus-armed = true;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.fav-save-open = false; }
                }
                Button {
                    text: root.strings.fav-save;
                    primary: true;
                    enabled: root.fav-save-multi || root.fav-save-alias != "";
                    clicked => {
                        root.fav-save-commit(root.fav-save-alias, root.fav-container-index);
                        root.fav-save-open = false;
                    }
                }
            }
        }
    }

    // ===== "New container" sub-popup (from the save flow) =====
    if root.fav-newc-open : ModalBackdrop { }
    if root.fav-newc-open : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: 210px;
        background: Theme.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000.with-alpha(0.35);
        drop-shadow-offset-y: 6px;
        Timer {
            interval: 1ms;
            running: root.fav-newc-focus-armed;
            triggered => {
                fav-newc-edit.focus();
                fav-newc-edit.set-selection-offsets(0, 99999);
                root.fav-newc-focus-armed = false;
            }
        }
        VerticalBox {
            padding: 18px;
            spacing: 10px;
            Text {
                text: root.strings.fav-new-container;
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
            }
            fav-newc-edit := EditLineEdit {
                text <=> root.fav-newc-name;
                accepted(t) => {
                    if (t != "") {
                        root.fav-save-new-container(t, root.fav-newc-parent-index);
                        root.fav-newc-open = false;
                    }
                }
            }
            Text {
                text: root.strings.fav-popup-parent;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 0.3px;
                color: Theme.foreground.with-alpha(0.55);
            }
            ComboBox {
                model: root.fav-container-labels;
                current-index <=> root.fav-newc-parent-index;
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                padding: 0px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.strings.btn-cancel;
                    clicked => { root.fav-newc-open = false; }
                }
                Button {
                    text: root.strings.fav-save;
                    primary: true;
                    enabled: root.fav-newc-name != "";
                    clicked => {
                        root.fav-save-new-container(root.fav-newc-name, root.fav-newc-parent-index);
                        root.fav-newc-open = false;
                    }
                }
            }
        }
    }
    // ===== Container / favorite context menu =====
    // Two faces in one popup: the container section (open all, new
    // sub-folder, rename, two-step delete) shows when fav-menu-container is
    // set, the favorite section (open, rename, delete, copy path) otherwise.
    if root.fav-menu-open : Rectangle {
        x: min(root.fav-menu-x, root.width - self.width - 8px);
        y: min(root.fav-menu-y, root.height - self.height - 8px);
        width: 220px;
        height: root.fav-menu-container ? 120px : 126px;
        background: Theme.background;
        border-radius: Tokens.radius-overlay;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 18px;
        drop-shadow-color: #000000.with-alpha(0.25);
        drop-shadow-offset-y: 4px;
        TouchArea { }
        VerticalLayout {
            padding: 4px;
            // --- CONTAINER ---
            if root.fav-menu-container : MenuItem {
                label: root.strings.fav-open-all;
                clicked => { root.fav-menu-open = false; root.fav-open-all(root.fav-menu-id); }
            }
            if root.fav-menu-container : Rectangle {
                height: 7px;
                Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
            }
            if root.fav-menu-container : MenuItem {
                label: root.strings.fav-new-subcontainer;
                clicked => { root.fav-menu-open = false; root.open-fav-name(false, root.fav-menu-id, ""); }
            }
            if root.fav-menu-container : MenuItem {
                label: root.strings.fav-rename;
                clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
            }
            // Container deletion: 2nd click = confirmation (recursive).
            if root.fav-menu-container : Rectangle {
                height: 26px;
                border-radius: 4px;
                background: root.fav-menu-confirm-delete
                    ? Tokens.danger.with-alpha(fdc-touch.has-hover ? 0.34 : 0.20)
                    : (fdc-touch.has-hover ? Tokens.danger.with-alpha(0.14) : transparent);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.fav-menu-confirm-delete ? root.strings.fav-delete-confirm : root.strings.fav-delete;
                        color: Tokens.danger;
                        font-size: 12px;
                        font-weight: root.fav-menu-confirm-delete ? 700 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                fdc-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (root.fav-menu-confirm-delete) {
                            root.fav-menu-open = false;
                            root.fav-delete(root.fav-menu-id);
                        } else {
                            root.fav-menu-confirm-delete = true;
                        }
                    }
                }
            }
            // --- FAVORITE ---
            if !root.fav-menu-container : MenuItem {
                label: root.strings.fav-open;
                clicked => { root.fav-menu-open = false; root.fav-open(root.fav-menu-id); }
            }
            if !root.fav-menu-container : Rectangle {
                height: 7px;
                Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
            }
            if !root.fav-menu-container : MenuItem {
                label: root.strings.fav-rename;
                clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
            }
            if !root.fav-menu-container : MenuItem {
                label: root.strings.fav-delete;
                clicked => { root.fav-menu-open = false; root.fav-delete(root.fav-menu-id); }
            }
            if !root.fav-menu-container : Rectangle {
                height: 7px;
                Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
            }
            if !root.fav-menu-container : MenuItem {
                label: root.strings.fav-copy-path;
                clicked => { root.fav-menu-open = false; root.fav-copy-path(root.fav-menu-id); }
            }
        }
    }
}
