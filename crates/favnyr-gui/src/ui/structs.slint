    // shortcut" popup — hence the `prop-` prefix kept so as not to break the
    // existing translation catalogs.
    prop-kind-folder: string,
    prop-kind-file: string,

    // Settings menu.
    settings-tooltip: string,
    settings-title: string,
    settings-tab-general: string,       // "General" tab label
    settings-columns-section: string,   // "Default columns"
    // MORE EXPLICIT labels in the checkbox for the columns reserved for
