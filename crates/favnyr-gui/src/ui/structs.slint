    // Name conflict on paste
    paste-conflict-title: string,
    paste-conflict-hint: string,
    paste-conflict-taken: string,
    paste-conflict-skip: string,
    paste-conflict-confirm: string,
    paste-conflict-replace: string,       // "Replace"
    paste-conflict-replace-all: string,   // "Replace all"
