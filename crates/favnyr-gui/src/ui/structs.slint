    op-moving: string,
    op-deleting: string,
    op-deleting-permanently: string,
    op-duplicating: string,
    op-scanning: string,
    op-done: string,
    op-cancelled: string,
    op-errors: string,           // e.g.: "Finished with errors"
    op-items: string,            // e.g.: "items" (trash counter)

    // Named workspaces
    ws-tooltip: string,               // top bar button tooltip
    ws-title: string,                 // overlay title
    ws-save-section: string,          // "Save current workspace"
    ws-name-placeholder: string,      // name field placeholder
    ws-name-taken: string,            // name already used (live validation)
    ws-save-btn: string,              // "Save"
    ws-saved-section: string,         // "My workspaces" (no counter, appended in Slint)
    ws-empty: string,                 // "No saved workspace"
    ws-empty-hint: string,            // empty-state subtext
    ws-load: string,                  // "Load"
    ws-update: string,                // "Update" (⟳ tooltip)
    ws-rename: string,                // pencil tooltip
    ws-delete: string,                // trash tooltip + red confirm button
    ws-delete-confirm: string,        // "Delete this workspace?"
    ws-overwrite-confirm: string,     // "Overwrite this workspace?"
    ws-panels-short: string,          // "pnl." (metadata)
    ws-tabs-short: string,            // "tabs." (metadata)
    ws-toast-saved: string,
    ws-toast-updated: string,
    ws-toast-renamed: string,
    ws-toast-deleted: string,
    ws-notice-saved: string,            // global toast with {name} (Ctrl+S)
    ws-notice-save-failed: string,       // global error with {name}
    // "Unsaved changes" safeguard when loading.
    ws-dirty-title: string,           // dialog title (with {name})
    ws-dirty-body: string,            // body (with {name})
    ws-dirty-discard: string,         // "Load without saving" (red ghost)
    ws-dirty-save-load: string,       // "Save and load" (primary)
    ws-dirty-tooltip: string,         // amber dot tooltip: "Unsaved changes"
    ws-dirty-save-action: string,     // amber ⟳ hover tooltip: "Save changes"
    // "Places" sidebar
    sidebar-tooltip: string,          // toggle button tooltip
    sidebar-shortcuts: string,        // shortcuts section header
    sidebar-drives: string,           // drives section header
    sidebar-network: string,          // network section header
    net-ejected: string,              // toast: device removed
    net-disconnected: string,         // toast: network drive disconnected
    net-eject-failed: string,         // toast: removal failed (prefix)
    net-eject: string,                // drive menu, unpluggable device
    net-release: string,              // drive menu, device wired in place
    net-released: string,             // toast: released, nothing to unplug
    net-disconnect: string,           // drive menu: "Disconnect"
    sidebar-home: string,             // "Home folder" label
    sidebar-trash: string,            // "Trash" label
    sidebar-root: string,             // root drive "/" label when unnamed
    sidebar-empty-trash: string,      // context menu: "Empty trash"
    sidebar-empty-trash-confirm: string, // 2nd click: confirmation
    net-delete-title: string,         // network "permanent deletion" popup
    net-delete-body: string,          // … body: no trash, irreversible
    permanent-delete-body: string,    // … generic body for Shift+Delete
    net-delete-confirm: string,       // … action button: "Delete permanently"
    open-many-title: string,          // guard before opening a whole selection
    open-many-confirm: string,        // … action button: "Open all"
    // Cross-view drag'n'drop: drop menu
    drop-move: string,                // "Move here"
    drop-copy: string,                // "Copy here"
    drop-link: string,                // "Link here"
    drop-favorite: string,            // "Add to favorites" (drag over the favorites)
    drop-swap: string,                // "Swap" (a view carried onto another)
    drop-detach: string,              // "Detach" (a view carried out of the window)

    ws-reset: string,                 // "Start a new workspace" button
    ws-new-name: string,              // "new workspace" target name in the dialog
    ws-toast-reset: string,           // toast after reset
    ws-sort-newest: string,           // "newest first" sort label
    ws-sort-oldest: string,           // "oldest first" sort label
    ws-sort-tooltip: string,          // sort-direction toggle button tooltip
    // Open with
    ow-choose: string,
    ow-pick-browse: string,
    ow-custom: string,
    ow-use-as-app: string,
    ow-manage: string,
    ow-title: string,
    ow-name: string,
    ow-program: string,
    ow-store-program: string,       // label of the frozen Program field (OS/Store app)
    ow-args: string,
    ow-tags: string,
    // Tooltips explaining what each insertable tag stands for.
    ow-tag-file: string,
    ow-tag-dir: string,
    ow-tag-dirname: string,
    ow-tag-setname: string,
    ow-tag-name: string,
    ow-tag-stem: string,
    ow-tag-ext: string,
    ow-tag-uri: string,
    ow-tag-files: string,
    ow-preview: string,
    ow-add-suggested: string,
    ow-recipes-label: string,   // section title, also its accessible label
    ow-recipes-hint: string,    // what the recipes are and why some are absent
    ow-launch: string,
    ow-default-ext: string,
    ow-set-default: string,     // "Set as default" checkbox of the app picker
    ow-display-other-apps: string, // Linux picker: include launchers without MimeType
    ow-used-ext: string,        // "Suggested in Open with for these extensions"
    ow-default-ext-placeholder: string,
    ow-used-ext-placeholder: string,
    ow-run-as-admin: string,    // "Run as administrator" checkbox (Windows)
    ow-default-ext-hint: string, // tooltip for the "default app" label
    ow-show-in-section: string,  // title of the "Where to show this command" panel
    ow-ctx-menu: string,        // "Show in the context menu:" label
    ow-ctx-files: string,       // "Files" checkbox
    ow-ctx-dirs: string,        // "Folders" checkbox
    ow-ctx-background: string,  // "View background" checkbox
    ow-ctx-ext: string,         // extension filter of the Files entry
    ow-ctx-ext-hint: string,    // what "*" means, and that it only affects Files
    ow-used-ext-hint: string,   // what the "suggested for" list does
    settings-shellmenu-label: string, // settings card: Windows context menu
    settings-shellmenu-hint: string,
    settings-shellext-list-label: string, // sub-tab: detected Windows entries
    settings-shellext-list-hint: string,
    settings-shellext-empty: string,      // no entry detected
    ow-move-up: string,         // tooltips for the Open-with list buttons
    ow-move-down: string,
    ow-duplicate-tip: string,
    ow-edit-tip: string,
    ow-delete-tip: string,
    settings-openers-section: string,
    ow-add: string,
    ow-empty: string,
    ow-search-placeholder: string,
    ow-no-results: string,
    ow-promote: string,
    ow-promote-add: string,
}
