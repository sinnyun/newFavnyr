    shortcut-conflict-reassign: string,
    shortcut-conflict-keep: string,

    // Rename popup.
    rename-title: string,
    rename-current-prefix: string,    // e.g.: "Current name: "
    rename-new-placeholder: string,
    rename-confirm: string,           // label of the "Rename" button
    rename-force-replace: string,     // explicit replacement of a file with the same name
    rename-select-name: string,       // selects the name without its extension
