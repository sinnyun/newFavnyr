        // ===== Progress toasts, drag pills and the global notice =====
        // Extracted to overlays/toasts.slint; the forwards below are the
        // whole contract with it (state in, dismissals back out).
        OverlayToasts {
            strings: root.strings;
            ops: root.ops;
            ops-more-text: root.ops-more-text;
            op-cancel(id) => { root.op-cancel(id); }
            op-dismiss(id) => { root.op-dismiss(id); }
            drag-active: root.drag-active;
            drag-abs-x: root.drag-abs-x;
            drag-abs-y: root.drag-abs-y;
            file-drag-active: root.file-drag-active;
            file-drag-abs-x: root.file-drag-abs-x;
            file-drag-abs-y: root.file-drag-abs-y;
            file-drag-target-exec: root.file-drag-target-exec;
            file-drag-copy: root.file-drag-copy;
            file-drop-will-cancel: root.file-drop-will-cancel;
            sidebar-item-drop-will-cancel: root.sidebar-item-drop-will-cancel;
            favorite-reorder-drop-will-cancel: root.favorite-reorder-drop-will-cancel;
            fav-hover-panel: sidebar-column.hover-panel;
            fav-reorder-drag-abs-x: sidebar-column.reorder-drag-abs-x;
            fav-reorder-drag-abs-y: sidebar-column.reorder-drag-abs-y;
            view-drag-active: root.view-drag-active;
            view-drag-abs-x: root.view-drag-abs-x;
            view-drag-abs-y: root.view-drag-abs-y;
            view-drag-target: root.view-drag-target;
            view-drag-outside: root.view-drag-outside;
            notice-text <=> root.notice-text;
            notice-tone: root.notice-tone;
            notice-icon: root.notice-icon;
            notice-duration: root.notice-duration;
        }
        // Auto-expand: a collapsed container hovered during a drag
        // expands after a short delay (in-place insertion on the bridge side → the ongoing
        // drag survives). The countdown restarts on every change of
        // hovered container.
        fav-autoexp-timer := Timer {
            interval: 650ms;
            running: root.fav-drag-active && root.fav-drag-hover-container != "";
            triggered => { root.fav-expand(root.fav-drag-hover-container); }
        }
        // Also auto-expands during a TAB or FILE drag over a
        // collapsed container — makes the gesture consistent with internal drag.
        // `root.fav-ext-collapsed` (declared at the root) tracks
        // `sidebar-column.hover-collapsed-container`; its `changed` (at the root) restarts
        // this countdown.
        fav-autoexp-ext-timer := Timer {
            interval: 650ms;
            running: (root.drag-active || root.file-drag-active)
                && root.fav-ext-collapsed != "";
            triggered => { root.fav-expand(root.fav-ext-collapsed); }
        }
        // Auto-expands the whole COLLAPSED favorites section when a tab/file drag
        // dwells on its header → the tree appears so the drop can land, instead of
        // the gesture doing nothing over a folded section. Purely declarative (no
        // imperative restart): it arms only while the drag actually hovers the
        // header, fires once after 650ms, and expanding flips
        // `hover-collapsed-section` false so `running` drops — it cannot re-fire
        // or loop, and leaves no pending fire to re-expand a section the user
        // later collapses.
        Timer {
            interval: 650ms;
            running: (root.drag-active || root.file-drag-active)
                && sidebar-column.hover-collapsed-section;
            triggered => {
                root.fav-section-collapsed = false;
                root.sidebar-section-state-changed(2, false);
            }
        }
        Timer {
            interval: 50ms;
            running: root.file-drag-refresh-pending && !root.file-drag-active
                && !root.file-drop-menu-open && !root.op-busy;
            triggered => {
                root.file-drag-refresh-pending = false;
                root.refresh();
            }
        }
        // Drive change detection: subst, USB, `net use`,
        // mount… don't always emit a system event. We probe the
        // signature only while the "Locations" panel is open;
        // the bridge only rebuilds the sidebar if it changed (near-zero cost).
        Timer {
            interval: 1500ms;
            running: root.left-panel == 1;
            triggered => { root.poll-drives(); }
        }
        // Cross-instance IPC init: shortly after startup (the window
        // exists → HWND available for tagging + subclassing). RETRIES as long
        // as the bridge returns `false` (window not found yet).
        ipc-init-timer := Timer {
            interval: 250ms;
            running: true;
            triggered => { if (root.init-ipc()) { ipc-init-timer.running = false; } }
        }
        // Re-checking unavailable tabs: active ONLY as long
        // as at least one panel is; the bridge only tests `is_dir` if a
        // drive/mount changed (non-blocking otherwise).
        Timer {
            interval: 2s;
            running: root.any-unavailable;
            triggered => { root.recheck-unavailable(); }
        }
        // Closes the "Open with", "New", and Windows shell sub-menu cascade
        // flyouts when neither the parent entry nor the flyout is hovered
        // (small delay → tolerates passing through the gap between them).
        FlyoutCloseTimer {
            open <=> root.mark-menu-open;
            parent-hover: root.mark-parent-hover;
            flyout-hover: root.mark-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.ow-menu-open;
            parent-hover: root.ow-parent-hover;
            flyout-hover: root.ow-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.new-menu-open;
            parent-hover: root.new-parent-hover;
            flyout-hover: root.new-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.ctx-shell-sub-open;
            parent-hover: root.ctx-shell-sub-parent-hover;
            flyout-hover: root.ctx-shell-sub-flyout-hover;
        }

        // ===== "Custom command" popup — rendered LAST =====
        // Extracted to overlays/custom_command.slint; the forwards below are
        // the whole contract with it (the form is two-way, the rest is read).
        OverlayCustomCommand {
            strings: root.strings;
            platform-windows: root.platform-windows;
            ow-popup-open <=> root.ow-popup-open;
            ow-popup-focus-armed <=> root.ow-popup-focus-armed;
            ow-popup-name <=> root.ow-popup-name;
            ow-popup-program <=> root.ow-popup-program;
            ow-popup-args <=> root.ow-popup-args;
            ow-popup-elevated <=> root.ow-popup-elevated;
            ow-popup-ctx-file <=> root.ow-popup-ctx-file;
            ow-popup-ctx-dir <=> root.ow-popup-ctx-dir;
            ow-popup-ctx-bg <=> root.ow-popup-ctx-bg;
            ow-popup-ctx-ext <=> root.ow-popup-ctx-ext;
            ow-popup-default-ext <=> root.ow-popup-default-ext;
            ow-popup-used-ext <=> root.ow-popup-used-ext;
            ow-popup-is-store: root.ow-popup-is-store;
            ow-popup-preview: root.ow-popup-preview;
            ow-popup-runs: root.ow-popup-runs;
            ow-popup-valid: root.ow-popup-valid;
            ow-popup-changed() => { root.ow-popup-changed(); }
            ow-popup-commit() => { root.ow-popup-commit(); }
            ow-browse() => { root.ow-browse(); }
        }

        // ===== The note attached to an entry =====
        // Extracted to overlays/notes.slint; it reads the `Note` global, so
        // there is nothing to forward.
        OverlayNoteBubble { }

        // ===== GLOBAL tooltip — rendered VERY LAST → above
        // everything (panels, popups). Position set by the hovered button (global Tip).
        if Tip.text != "" : Rectangle {
            x: clamp(Tip.x, 4px, max(4px, parent.width - self.width - 4px));
            y: clamp(Tip.y, 4px, max(4px, parent.height - self.height - 4px));
            width: gtip.preferred-width + 14px;
            height: 24px;
            background: #1a1a1a;
            border-radius: 4px;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000066;
            gtip := Text {
                text: Tip.text;
                font-size: 11px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

    }
}




