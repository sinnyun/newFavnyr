// Favnyr's main window and multi-view management.
//
// Layout:
//   ┌──────────────────────────────────────────────────────────────────────┐
//   │ [Panel1●][Panel2 ][+]                      [lang ▾] [theme ▾]       │
//   ├──────────────────────────────────────────────────────────────────────┤
//   │ ┌─ Panel 1 (active) ───────┐ ┌─ Panel 2 ─────────────────────┐       │
//   │ │ [tabs+]   [nav][path]    │ │ [tabs+]   [nav][path]        │       │
//   │ │ [sortable columns]       │ │ [columns]                    │       │
//   │ │ [file list]              │ │ [file list]                  │       │
//   │ │ [footer: N items]        │ │ [footer: N items]            │       │
//   │ └──────────────────────────┘ └──────────────────────────────┘       │
//   └──────────────────────────────────────────────────────────────────────┘
//
// All translatable strings go through `Strings` (struct below).
// Colors come from `Palette` (switched by `apply-theme()`).


import { ColumnInfo, FavNode, MenuShortcuts, OpProgress, OpenerItem, OrphanRow, OwRecipe, PanelBox, PanelView, ShellCtxEntry, ShellExtRow, ShortcutGroup, SidebarPlace, SplitterView, Strings, WorkspaceEntry } from "structs.slint";
import { CtxNav, Dismiss, Theme, Tip, Tokens, WindowFocus } from "theme.slint";
// Re-exported so the Rust bridge keeps reaching it as `crate::CtxNav`
// (only the root document's exports are re-exported by `include_modules!`).
export { CtxNav } from "theme.slint";
import { FlyoutCloseTimer, PanelSplitterAbs } from "widgets/tabs.slint";
import { PanelComponent } from "panel.slint";
import { OverlayToasts } from "overlays/toasts.slint";
import { OverlayDialogs } from "overlays/dialogs.slint";
import { OverlayWorkspaces } from "overlays/workspaces.slint";
import { OverlayCustomCommand } from "overlays/custom_command.slint";
import { OverlayNoteBubble, OverlayNotes } from "overlays/notes.slint";
import { OverlayFavorites } from "overlays/favorites.slint";
import { OverlayOpenWith } from "overlays/openwith.slint";
import { OverlayPanelMenus } from "overlays/panel_menus.slint";
import { OverlayMenus } from "overlays/menus.slint";
import { OverlaySettings } from "overlays/settings.slint";
import { SidebarColumn } from "sidebar/column.slint";
import { ActivityRail } from "sidebar/rail.slint";
import { VerticalBox, Palette } from "std-widgets.slint";

// ---------- Main window ----------

export component MainWindow inherits Window {
    // OS title (taskbar / Alt-Tab). Default "Favnyr"; the bridge
    // replaces it with "{workspace} — Favnyr" based on the current workspace.
    in property <string> window-title: root.strings.app-title;
    title: root.window-title;
    // Application icon (title bar / taskbar / Alt-Tab).
    icon: @image-url("../../assets/favnyr.svg");
    // Window background = theme's channel color (otherwise the Fluent default would reappear).
    background: Theme.background;

    preferred-width: 1300px;
    preferred-height: 750px;
    min-width: 720px;
    min-height: 420px;

    // ----- Strings + selectors -----
    in property <Strings> strings;
    in property <[string]> language-labels;
    in property <[string]> theme-labels;
    in property <[string]> ui-scale-labels;      // "80%", "100%", …
    in-out property <int> language-index: 0;
    in-out property <int> theme-pref: 0;
    in-out property <int> ui-scale-index: 0;      // index into ui-scale-labels
    callback language-changed(int);
    callback theme-changed(int);
    callback ui-scale-changed(int);               // → applies + persists the zoom
    // "Video thumbnails (ffmpeg)" section (Linux). State set by the bridge.
    in property <bool> ffmpeg-found: false;
    in property <string> ffmpeg-version;          // "8.1.2"; empty if unknown
    in property <bool> ffmpeg-flatpak: false;     // sandbox → host commands useless
    in property <int> ffmpeg-detected-index: -1;  // 0 Debian·1 Fedora·2 Arch·3 Alpine; -1 unknown
    callback ffmpeg-recheck();                    // re-runs detection
    callback settings-copy(string);               // copies text to the clipboard
    // DEFAULT tab bar position for new views "from
    // scratch" (new workspace / reset) — global setting.
    in property <[string]> tabbar-default-labels;
    in-out property <int> tabbar-default-pref: 0;
    callback tabbar-default-changed(int);
    // Timezone for the "Modified" column: 0 = local time (default), 1 = UTC.
    in-out property <int> clock-utc-pref: 0;
    callback clock-mode-changed(int);
    // "Full path" tooltip on tab hover — opt-in.
    in-out property <bool> tab-tooltip-enabled: false;
    callback tab-tooltip-changed(bool);
    // "Unsaved changes" guard before loading —
    // checked by default; the bridge reads `ws-warn-unsaved` in `ws-load-guarded`.
    in-out property <bool> ws-warn-unsaved: true;
    callback ws-warn-unsaved-changed(bool);
    // Preview mode: compact single-icon rows, enabled by default.
    in-out property <bool> compact-preview-rows-enabled: true;
    callback compact-preview-rows-changed(bool);

    // Panels: flattened rendering of the layout tree.
    in property <[PanelView]> panels;
    // Per-panel footers, indexed like `panels`. PARALLEL model,
    // deliberately kept separate from `panels`: the bridge can write the selection
    // count to it on every rubber-band step without rewriting the `PanelView`s
    // (see `PanelComponent.footer-text`).
    in property <[string]> panel-footers;
    // Where each view sits, parallel to `panels` — see `PanelBox`.
    in property <[PanelBox]> panel-boxes;
    in property <[SplitterView]> splitters;
    in property <int> active-panel-idx: 0;
    // Counter bumped by Ctrl+L (`focus-address`) → each PanelComponent observes it;
    // the ACTIVE panel enters address bar edit mode.
    property <int> address-focus-gen: 0;
    in property <bool> can-add-panel: true;
    callback panel-clicked(int);
    callback panel-closed(int);
    /// Two views exchange their places in the layout. Nothing else moves:
    /// neither the shape of the split tree nor a single proportion, so each
    /// view takes the size of its new place.
    callback views-swapped(int, int);
    /// A view released outside the window leaves for a window of its own.
    callback view-torn-off(int, length, length);
    /// The cursor has left the window while carrying a view, so releasing now
    /// would detach it into a window of its own. Both systems: detaching only
    /// needs a new instance to be started, never the cross-instance messaging
    /// that is still missing outside Windows.
    property <bool> view-drag-outside: root.view-drag-active
        && (root.view-drag-abs-x < -24px
            || root.view-drag-abs-y < -24px
            || root.view-drag-abs-x > root.width + 24px
            || root.view-drag-abs-y > root.height + 24px);
    /// A view is being carried by its grip.
    in-out property <bool> view-drag-active: false;
    in-out property <length> view-drag-abs-x;
    in-out property <length> view-drag-abs-y;
    /// The view being carried, and the one under the cursor. `-1` for none.
    in-out property <int> view-drag-source: -1;
    in-out property <int> view-drag-target: -1;
    /// Escape during the drag: the pointer stays captured until release, but
    /// nothing will be swapped and every preview goes out at once.
    property <bool> view-drag-cancelled: false;
    /// The two views crossing right now, and the flag that arms their travel.
    ///
    /// The animation is armed by the EVENT, never by the property: the tiles'
    /// positions also change on every frame of a separator drag, on a split and
    /// on a close, and an unguarded `animate` would make all of those trail
    /// behind the pointer.
    property <int> swap-flight-a: -1;
    property <int> swap-flight-b: -1;
    property <bool> view-swap-flying: false;
    Timer {
        // Just past the travel, so the mark goes out once the tiles are down.
        interval: 200ms;
        running: root.view-swap-flying;
        triggered => {
            root.view-swap-flying = false;
            root.swap-flight-a = -1;
            root.swap-flight-b = -1;
        }
    }

    /// Evens out the views a separator governs: `idx` designates it, `-1`
    /// means the whole layout (the menu, which aims at no separator).
    /// Double-clicking the same separator again puts the sizes back.
    callback equalize-views(int);
    /// More than one view, so there is something to even out.
    in property <bool> equalize-available: false;
    /// A way back is being held: the menu row offers it instead.
    in property <bool> equalize-undone: false;
    /// Separator under the pointer, `-1` for none — drives the outline that
    /// shows which views a double-click would move.
    property <int> hover-splitter: -1;

    /// Guard before opening a whole selection of files at once. The body
    /// carries the count and is written by the bridge.
    in-out property <bool> open-many-open: false;
    in-out property <string> open-many-body;
    callback open-many-confirmed();

    /// Splits the active panel. `dir`: 0 = side by side (Row), 1 = stacked (Column).
    callback panel-split(int);
    /// Resize of a splitter: `idx` of the Split node, `frac` = pointer
    /// position as a fraction [0,1] of the container along the split axis.
    callback splitter-resized(int, float);
    /// Sets the display mode of panel `idx`'s active tab: "list", "previews"
    /// or "grid" (the mode menu of the view button).
    callback set-view-mode(int /*idx*/, string /*mode code*/);
    /// Advances panel `idx`'s active tab to the next display mode
    /// (list → previews → grid → list): the view button's Ctrl+P route.
    callback cycle-view-mode(int /*idx*/);
    /// Shows / hides the contents of the direct subfolders for panel `idx`'s
    /// active tab ("show subfolder contents": one section per subfolder).
    callback toggle-subfolder-contents(int /*idx*/);
    /// Folds / unfolds a section (header click), by its key.
    callback toggle-section(int /*idx*/, string /*section key*/);
    /// Width of a view's list area, in logical px — what the grid packs its
    /// tiles with. Reported whenever the area changes size.
    callback rows-area-width(int /*idx*/, length /*width*/);
    /// Zoom of panel `idx`'s active tab entries: `delta` = +1 / -1.
    /// The viewport and pointer position let the bridge preserve
    /// a semantic anchor despite variable row heights.
    callback zoom-view(int /*idx*/, int /*delta*/, length /*top*/, length /*height*/,
        length /*pointer-y*/) -> length;
    /// Current state of the Ctrl key (tracked by the root FocusScope) — used
    /// to distinguish wheel (scroll) from Ctrl+wheel (zoom).
    in-out property <bool> ctrl-down: false;
    /// Current state of the Shift key (tracked like `ctrl-down`) — rubber-band mode:
    /// Shift = add to selection, Ctrl = subtract.
    in-out property <bool> shift-down: false;
    property <int> keyboard-interaction-gen: 0;
    /// Shows / hides hidden files for panel `idx`'s active tab.
    callback toggle-show-hidden(int);
    /// Keyboard navigation of the active view's cursor. `kind`: 0=up,
    /// 1=down, 2=start, 3=end. `extend` = extend the selection (Shift).
    callback move-cursor(int, bool);
    /// Resolves a key combination → action id (or "" if none) using the
    /// effective shortcut map (defaults + overrides). `keyname` is already
    /// normalized by `chord-key-name`.
    callback match-action(string, bool, bool, bool) -> string;
    /// Emitted by the bridge when a thumbnail is ready (full path, generation, image).
    callback thumb-ready(string, int, image);
    /// Exact viewport of a panel: drives virtualization and prioritization.
    callback panel-viewport-changed(int /*panel*/, length /*top*/, length /*height*/);
    /// Hit-test of a content ordinate within variable-height rows.
    callback panel-row-at-content-y(int /*panel*/, length /*y*/) -> int;
    /// Wakes the UI thread from the INITIAL FILL thread: drains
    /// the channel of delivered listings (the Rust handler captured the AppState).
    callback initial-listing-drain();
    /// Ordinary background listings delivered off-UI, with an anti-race generation.
    callback async-listing-drain();
    /// "Show subfolder contents" scans delivered off-UI: drains the queue of
    /// finished scans (the Rust handler captured the AppState).
    callback subfolders-drain();
    // the worker computed a folder's recursive stats (path, Unix mtime, total
    // size in bytes — both as text to dodge Slint's `int` i32 limit; an empty
    // string means "not computed" for that metric).
    callback folder-stats-ready(int /* panel */, int /* row */, string /* path */, string /* mtime */, string /* size */);
    // the worker read an image's metadata (path, resolution, bits).
    callback imgmeta-ready(
        int /* panel */, int /* row */, string /* path */,
        string /* resolution */, string /* depth */, string /* mtime (unix, text) */
    );
    // "Split" menu: opened via a panel's token (which activates
    // beforehand), so it acts on the active panel via `panel-split`.
    in-out property <bool> split-menu-open: false;
    in-out property <length> split-menu-x;
    in-out property <length> split-menu-y;

    // "Tab bar position" menu: 3 radio options (top /
    // left / right), per view. `set-tab-bar-mode(panel, mode)` → bridge.
    in-out property <bool> tabbar-menu-open: false;
    in-out property <length> tabbar-menu-x;
    in-out property <length> tabbar-menu-y;
    in-out property <int> tabbar-menu-panel: -1;
    in-out property <int> tabbar-menu-mode: 0;     // CURRENT mode (checked option)
    callback set-tab-bar-mode(int /*panel*/, int /*mode*/);

    // "View mode" menu: 3 radio options (list /
    // previews / grid), per view. `view-menu-mode` is the CURRENT mode code
    // (checked option). The view button in the nav bar opens it.
    in-out property <bool> view-menu-open: false;
    in-out property <length> view-menu-x;
    in-out property <length> view-menu-y;
    in-out property <int> view-menu-panel: -1;
    in-out property <string> view-menu-mode: "list";
    /// Vertical bar width resized via the grip —
    /// persisted per view on the bridge side.
    callback panel-vbar-resized(int /*panel*/, length /*width*/);

    // URL bar menu (right-click): Paste / Copy path.
    in-out property <bool> url-menu-open: false;
    /// Bumped by the menu's "Copy"; the URL field watches it and copies its
    /// own selection. A callback could not do this: the field is inside a
    /// panel, and only it knows what is highlighted.
    in-out property <int> url-copy-serial: 0;
    in-out property <int> url-paste-serial: 0;
    in-out property <length> url-menu-x;
    in-out property <length> url-menu-y;
    // EDITABLE text of the URL bar (shared: only one panel in edit mode at
    // a time). Lets the bridge paste the clipboard into it without submitting.
    in-out property <string> url-edit-text;

    // ----- Column widths: PER PANEL (carried by each PanelView).
    //       A header resize reports here with the panel's index. -----
    callback panel-column-resized(int /*panel*/, string /*id*/, length /*width*/);
    // Tab bar scroll target — geometric computation on the bridge side
    // (panel, tab_idx[-1=chevron], forward, viewport-x, view-w) → viewport-x.
    callback panel-scroll-target(int, int, bool, length, length) -> length;
    // check/uncheck a column (panel_idx, col_id, visible) + menu.
    callback column-toggle(int, string, bool);
    // Reordering: panel, column identifier, and target visible index.
    callback column-moved(int, string, int);
    // extension filter. `ext-filter-toggle(panel)` shows/hides the bar
    // (from the columns menu OR the close button). Input is shared with the
    // type-ahead (filter-type/backspace/clear routed bridge-side).
    callback ext-filter-toggle(int);
    in-out property <bool> columns-menu-open: false;
    in-out property <length> columns-menu-x;
    in-out property <length> columns-menu-y;
    in-out property <int> columns-menu-panel: 0;
    // changes the grouping mode (panel_idx, code "folders"/"files"/"mixed").
    callback set-group-mode(int, string);
    // Active view's "type-ahead" filter -----
    // Typed text (maintained by the bridge). The bar shows in the active view
    // as soon as it's non-empty. Reset on navigation / panel change / Escape.
    in property <string> active-filter: "";
    // Active panel's "extension filter" mode: when true, keyboard
    // input (filter-type/backspace/clear) feeds the extension filter instead of
    // the by-name type-ahead → shared routing on the bridge side.
    in property <bool> active-ext-filter-on: false;
    callback filter-type(string);       // a printable character typed
    callback filter-backspace();        // removes the last character
    callback filter-clear();            // clears it ("x" / Escape)
    // Is an overlay/popup open? (gates the filter's keyboard capture)
    // Everything that can appear ON TOP of a gesture and take the pointer with
    // it. A drag is deliberately absent from this list: it IS the gesture, not
    // something stealing it — a list that included it could never tell the two
    // apart.
    property <bool> popup-overlay-open:
        root.settings-open || root.workspaces-open || root.rename-popup-open
        || root.create-popup-open || root.ctx-menu-open
        || root.paste-conflict-open || root.columns-menu-open || root.trash-menu-open
        || root.drive-menu-open
        || root.url-menu-open || root.split-menu-open || root.tabbar-menu-open
        || root.view-menu-open
        || root.file-drop-menu-open
        || root.fav-menu-open || root.fav-name-open || root.fav-save-open
        || root.fav-newc-open || root.tab-menu-open || root.tab-empty-menu-open
        || root.ow-menu-open || root.new-menu-open || root.mark-menu-open
        || root.ow-popup-open || root.ow-picker-open
        || root.delete-warning-open || root.open-many-open;
    property <bool> any-overlay-open: root.popup-overlay-open || root.file-drag-active;
    // One of those appearing in the middle of a gesture ends it, rather than
    // leaving it drawn on screen with no way to finish it.
    changed popup-overlay-open => {
        if (root.popup-overlay-open) { root.cancel-mouse-gestures(); }
    }

    /// Ends every mouse gesture in progress.
    ///
    /// A menu or a popup appearing mid-gesture takes the pointer with it: the
    /// release that would have ended the gesture never comes back, and what it
    /// was drawing — a drag pill, an insertion bar, a carried view — stays on
    /// screen following nothing. The usual way in is a right-click slipped in
    /// while the left button is still down. Only one gesture can run at a
    /// time, so ending all of them is exact, and each area holding local state
    /// follows its own flag going down.
    function cancel-mouse-gestures() {
        // A carried view is CANCELLED, not dropped: should the release still
        // arrive, it must not tear the view off.
        if (root.view-drag-active) { root.view-drag-cancelled = true; }
        root.view-drag-active = false;
        root.view-drag-source = -1;
        root.view-drag-target = -1;
        root.drag-active = false;
        root.cancel-sidebar-item-drag();
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.drag-source-panel = -1;
        root.file-drag-active = false;
        root.file-drag-target-panel = -1;
        root.file-drag-target-row = -1;
        root.file-drag-target-folder = false;
        root.file-drag-target-exec = false;
        root.file-drag-target-invalid = false;
        root.fav-drag-active = false;
        root.fav-drag-target-index = -1;
        root.fav-drag-hover-container = "";
        root.cancel-sidebar-section-drag();
    }
    // Settings: default columns (1st launch / Reset) — all of them, with their
    // default visibility. `default-column-toggle(id, visible)` updates the config.
    in property <[ColumnInfo]> settings-columns;
    callback default-column-toggle(string, bool);
    // recursive folder modification-date depth
    // (0 = disabled). Drives `Config.recursive_mtime_depth`.
    in-out property <int> rmtime-depth: 0;
    callback rmtime-depth-changed(int);
    // recursive folder SIZE depth (0 = disabled).
    // Drives `Config.recursive_size_depth`.
    in-out property <int> size-depth: 0;
    callback size-depth-changed(int);

    // Configurable shortcuts -----
    // Action groups (pushed by the bridge when settings open and
    // after each modification / search).
    in property <[ShortcutGroup]> shortcut-groups;
    // EFFECTIVE shortcuts displayed in context menus, pushed by
    // the bridge (dynamic: follow user rebinds).
    in property <MenuShortcuts> menu-shortcuts;
    // True if at least one override exists (enables "Reset all").
    in property <bool> shortcut-has-overrides: false;
    // Action currently being reassigned (keyboard capture); "" = none.
    in-out property <string> shortcut-capturing: "";
    // Pending conflict: targeted action + localized message ready to display.
    // (in-out: set by the bridge, reset by the UI on close.)
    in-out property <string> shortcut-conflict-action: "";
    in-out property <string> shortcut-conflict-message: "";
    // Current search/filter text.
    in-out property <string> shortcut-search-text: "";
    callback shortcut-rebind(string /*action_id*/, string /*raw chord*/);
    callback shortcut-reset(string /*action_id*/);
    callback shortcut-unassign(string /*action_id*/);
    callback shortcut-reset-all();
    callback shortcut-resolve-conflict(bool /*reassign*/);
    callback shortcut-search(string);

    /// Index where the drop preview line appears during a tab drag.

    // ----- Per-panel callbacks (routed from the active panel) -----
    callback go-back();
    callback go-forward();
    callback go-parent();
    callback go-home();
    callback refresh();
    callback sort-clicked(string);
    callback row-activated(int);
    callback row-clicked(int) -> bool;
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    callback select-all();
    callback deselect-all();
    callback rubber-band-begin(int);
    callback rubber-band-update(length, length, length, length);
    callback row-right-clicked(int, length, length);
    callback tab-new();
    callback tab-clicked(int);
    callback tab-closed(int);
    // (src_panel, src_tab, target_intra, abs_x, abs_y) — src_panel passed
    // explicitly to handle a drag from a NON-active panel.
    callback tab-drag-completed(int, int, int, length, length);
    callback tab-drag-progress(int, length, length);
    /// Drop of a tab on a FAVORITES folder: (src_panel, src_tab,
    /// container id). Saves the tab's path into this folder.
    callback tab-to-favorite(int, int, string);
    /// Drop of a view's SELECTION (files/folders) on a FAVORITES
    /// folder: (src_panel, container id).
    callback file-to-favorite(int, string);
    /// Favorites container currently hovered by a drag (tab OR file),
    /// "" if none. Read PULL-BASED on release (the binding is re-evaluated on read
    /// → reflects the current position of the `*-drag-abs-*`), making it robust
    /// even when cross-instance hover lags behind. Exposed from the
    /// unconditional FavPanel.
    out property <string> fav-hover-container: sidebar-column.hover-container;
    out property <bool> fav-hover-panel: sidebar-column.hover-panel;   // root fallback

    /// Global tab drag state — propagated to ALL PanelComponents
    /// so each computes its own preview line.
    in-out property <bool> drag-active: false;
    in-out property <length> drag-abs-x: 0px;
    in-out property <length> drag-abs-y: 0px;
    /// Last insertion gap claimed during the drag + claiming panel
    /// . Read by the BRIDGE on cross-view drop: if `drag-target-gap-panel`
    /// == target panel, the drop in its header uses this EXACT gap; otherwise
    /// (drop in the body) the tab goes to the end of the bar. Reset at drag start.
    in-out property <int> drag-target-gap: -1;
    in-out property <int> drag-target-gap-panel: -1;
    // Index of the tab drag's SOURCE panel (for the danger preview "will
    // close" on the source whose last tab is being dragged). -1 = none.
    in-out property <int> drag-source-panel: -1;
    // Drop target — set by the panel under the cursor.
    // `panel` = index (-1 if none); `zone` = 0 none·1 center·2 W·3 E·4 N·5 S.
    in-out property <int> drag-target-panel: -1;
    in-out property <int> drag-target-zone: 0;

    // File drag'n'drop between views -----
    in-out property <bool> file-drag-active: false;
    in-out property <length> file-drag-abs-x: 0px;
    in-out property <length> file-drag-abs-y: 0px;
    in-out property <int> file-drag-source-panel: -1;
    in-out property <int> file-drag-target-panel: -1;   // panel under the cursor
    in-out property <int> file-drag-target-row: -1;     // hovered row (folder/executable/other)
    in-out property <bool> file-drag-target-folder: false;
    in-out property <bool> file-drag-target-exec: false;
    in-out property <bool> file-drag-target-invalid: false; // target = source/descendant
    callback file-drop-target-invalid(int /*src panel*/, int /*target panel*/, int /*row*/) -> bool;
    function claim-file-drag-target(panel: int, row: int, folder: bool, executable: bool) {
        root.file-drag-target-panel = panel;
        root.file-drag-target-row = row;
        root.file-drag-target-folder = folder;
        root.file-drag-target-exec = executable;
        root.file-drag-target-invalid = root.file-drag-active && panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel, panel, row);
    }
    function refresh-file-drag-target-invalid() {
        root.file-drag-target-invalid = root.file-drag-active
            && root.file-drag-target-panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel,
                root.file-drag-target-panel, root.file-drag-target-row);
    }
    function clear-file-drag-target(panel: int) {
        if (root.file-drag-target-panel == panel) {
            root.file-drag-target-panel = -1;
            root.file-drag-target-row = -1;
            root.file-drag-target-folder = false;
            root.file-drag-target-exec = false;
            root.file-drag-target-invalid = false;
        }
    }
    // During a file drag: would releasing at the CURRENT position do
    // NOTHING? EXACT mirror of `file-drag-dropped`'s drop condition
    // (favorites OR folder/executable OR another panel): true
    // = unsuitable zone (scrollbars, headers, tab bar, footer, dead zone,
    // or the SOURCE folder itself). Drives the "cancel" pill that follows
    // the cursor → the indicator can never lie about what the drop will do.
    property <bool> file-drop-will-cancel:
        root.file-drag-active
        && root.fav-hover-container == ""
        && !root.fav-hover-panel
        && (root.file-drag-target-invalid
            || !(root.file-drag-target-panel >= 0
                && (root.file-drag-target-folder
                    || root.file-drag-target-exec
                    || root.file-drag-target-panel != root.file-drag-source-panel)));
    in-out property <bool> file-drag-copy: false;       // internal Ctrl or external OLE key-state
    // A watcher event that arrived during the gesture is replayed cleanly after
    // the drag/menu/operation instead of rebuilding the model under the mouse.
    in-out property <bool> file-drag-refresh-pending: false;
    // Native (OLE) drag triggered once when the cursor leaves the
    // window during a drag → external apps. Re-armed on every new drag.
    in-out property <bool> native-drag-armed: false;
    callback start-native-drag(int /*src_panel*/);
    callback file-drag-begin(int /*src_panel*/, int /*row_idx*/);  // ensures the selection
    // Drop menu (Move / Copy / Link here) + panels captured on drop.
    in-out property <bool> file-drop-menu-open: false;
    in-out property <length> file-drop-menu-x;
    in-out property <length> file-drop-menu-y;
    in-out property <int> file-drop-src-panel: -1;
    in-out property <int> file-drop-target-panel: -1;
    in-out property <int> file-drop-target-row: -1;     // target folder row captured on drop (1 = current folder)
    callback file-drop-action(int /*0 move · 1 copy · 2 link*/);
    // Drop onto an executable → launches it with the files as arguments.
    // Returns true if launched (the bridge reads the already-set file-drop-src/target/row).
    callback file-drop-onto-exec() -> bool;
    callback refresh-all();   // re-lists ALL panels (after a multi-view op)

    callback rename-confirmed(string);
    callback rename-force-replace(string) -> bool;
    callback navigate-to(string);
    /// Emitted on right-click in a panel's empty area (useful for Paste).
    callback empty-right-clicked(length, length);
    // Bumped by the Menu key; see `PanelComponent.menu-key-serial`.
    in-out property <int> menu-key-serial: 0;
    // Row the keyboard context menu targets in the ACTIVE view, -1 for the
    // background menu.
    callback keyboard-context-row() -> int;

    // ----- Settings: open an XDG path in the OS file manager -----
    callback open-config-dir();
    callback open-data-dir();
    callback open-cache-dir();

    // True on Windows only (pushed by the bridge): gates the
    // "Open with…" entry (native picker), absent on other OSes.
    in property <bool> platform-windows: false;
    // True only on Linux: gates Linux-specific application discovery controls.
    in property <bool> platform-linux: false;

    // Open with -----
    in property <[OpenerItem]> openers-suggested;   // "Open with" submenu
    in property <[OpenerItem]> openers-all;         // Settings list
    in-out property <string> opener-search-text: "";
    callback opener-search(string);
    in property <bool> selection-is-executable;     // drives "Use as application"
    callback run-opener(string /*id*/);             // runs an opener on the selection
    callback ow-use-as-app();                       // creates an opener from the selected exe
    callback ow-add();                              // blank creation popup (Settings)
    // Ready-made archiving commands, empty when no archiver is installed.
    // Recipes are pre-split into two balanced rows on the bridge side (Slint's
    // `for` cannot carry an inline `if`), so the block wraps without sideways
    // scroll. Row 1 holds the first half (the extra chip when the count is odd).
    // Two balanced columns of full-width rows. Splitting in Rust rather than
    // in Slint, whose `for` cannot carry an inline slice.
    in property <[OwRecipe]> ow-recipes-col1: [];
    in property <[OwRecipe]> ow-recipes-col2: [];
    // Tools none of whose recipes could be resolved, already worded by the
    // bridge — empty when everything supported is installed.
    in property <string> ow-recipes-missing: "";
    // Collapsed by default: expanded, the block would push the saved commands
    // — the tab's actual content — below the fold for everyone.
    in-out property <bool> ow-recipes-open: false;
    callback ow-recipe-add(int);                    // opens the editor prefilled
    callback ow-edit(string /*id*/);                // edit popup
    callback ow-duplicate(string /*id*/);           // clones an entry
    callback ow-delete(string /*id*/);
    callback ow-move(string /*id*/, int /*dir -1/+1*/);
    callback ow-popup-changed();                    // recomputes the preview (bridge)
    callback ow-popup-commit();                     // saves OR launches (depending on the case)
    callback ow-browse();                           // opens an exe picker (native)
    // Home-grown application picker: list enumerated by the OS.
    callback ow-open-picker();                      // "Choose an application…"
    callback ow-pick(string /*key handler*/);       // choice → launches + captures
    callback ow-pick-browse();                      // browse the OS → saves + launches
    in property <[OpenerItem]> ow-picker-handlers;
    in-out property <string> ow-picker-search-text: "";
    callback ow-picker-search(string);
    in-out property <bool> ow-picker-open: false;
    callback ow-picker-show-other-apps-changed(bool);
    // Linux-only discovery of .desktop launchers without a MimeType declaration.
    in-out property <bool> ow-picker-show-other-apps: false;
    // "Set as default": the chosen app becomes Favnyr's default for the
    // file's extension (overrides the OS). Unchecked on every opening.
    in-out property <bool> ow-picker-set-default: false;
    // "Open with" submenu: flyout on hover of the entry (the parent menu
    // stays visible). Hover tracked via two properties (the entry + the flyout) for
    // a clean deferred close, without referencing conditional elements.
    // "Colour & note" flyout — same mechanism as "Open with" below, so the
    // strip is reached by hovering rather than by an extra click.
    in-out property <bool> mark-menu-open: false;
    in-out property <length> mark-menu-x;
    in-out property <length> mark-menu-y;
    in-out property <bool> mark-parent-hover: false;
    in-out property <bool> mark-flyout-hover: false;
    // Slot already applied to the target, so the strip can point at it.
    in-out property <int> mark-current-color: 0;
    // Does the selection contain at least ONE folder? Distinct from
    // `ctx-selection-is-dir`, which describes only the primary item: a mixed
    // selection starting with a file still has folders to colour.
    in-out property <bool> ctx-selection-has-dir: false;
    callback folder-color-picked(int);
    // Note editor. Single item at a time, so the entry that opens it is gated
    // on `ctx-selection-single` exactly as "Create a shortcut" is.
    in-out property <bool> comment-popup-open: false;
    in-out property <string> comment-target-name;   // shown as the caption
    in-out property <string> comment-text;          // note the editor opens on
    property <bool> comment-focus-armed: false;
    callback comment-confirmed(string);
    // Asks the bridge to fill the three properties above from the selection,
    // then open the editor — the row itself knows neither the name nor the
    // note already stored.
    callback open-comment-editor();
    changed comment-popup-open => {
        if (root.comment-popup-open) { root.comment-focus-armed = true; }
        else { key-scope.focus(); }
    }
    in-out property <bool> ow-menu-open: false;
    in-out property <length> ow-menu-x;
    in-out property <length> ow-menu-y;
    in-out property <bool> ow-parent-hover: false;
    in-out property <bool> ow-flyout-hover: false;
    // "New" submenu (empty area) — SAME mechanism as "Open with"
    // above: flyout on hover, deferred close via two hover flags.
    in-out property <bool> new-menu-open: false;
    in-out property <length> new-menu-x;
    in-out property <length> new-menu-y;
    in-out property <bool> new-parent-hover: false;
    in-out property <bool> new-flyout-hover: false;
    // "Custom command" popup (create/edit/one-shot launch).
    in-out property <bool> ow-popup-open: false;
    in-out property <bool> ow-popup-focus-armed: false;
    in-out property <string> ow-popup-id: "";       // "" = creation
    in-out property <string> ow-popup-name: "";
    in-out property <string> ow-popup-program: "";
    // Persisted visual family inherited from a ready-made recipe.
    in-out property <int> ow-popup-icon-kind: 0;
    // Opener based on an OS association (Windows Store/UWP app, Linux .desktop):
    // no executable → the Program field is frozen + explicit label.
    in-out property <bool> ow-popup-is-store: false;
    in-out property <string> ow-popup-args: "";
    // Run as administrator (UAC elevation) — Windows only, unchecked by
    // default. The checkbox is only shown if `platform-windows`.
    in-out property <bool> ow-popup-elevated: false;
    // Pinning to the context menu: 3 checkboxes → file/folder/background bits.
    in-out property <bool> ow-popup-ctx-file: false;
    // Extensions the FILE entry is limited to; "*" means every file. Only
    // meaningful with the Files box — folders and the background have none.
    in-out property <string> ow-popup-ctx-ext: "";
    in-out property <bool> ow-popup-ctx-dir: false;
    in-out property <bool> ow-popup-ctx-bg: false;
    in-out property <string> ow-popup-default-ext: "";
    in-out property <string> ow-popup-used-ext: "";   // extensions listed in "Open with"
    in-out property <bool> ow-popup-add: true;       // "Add to applications"
    in property <string> ow-popup-preview: "";       // resolved preview (set by the bridge)
    // How many processes the command will start, already worded by the bridge.
    in property <string> ow-popup-runs: "";
    in property <bool> ow-popup-valid: false;        // valid program (set by the bridge)
    // Promotion toast after the native dialog (Windows).
    in-out property <bool> ow-promote-visible: false;
    callback ow-promote-accept();

    // ----- Global operations (target the active panel) -----
    callback action-open();
    callback action-open-new-tab();
    callback action-open-admin();   // "Open as administrator" (file, Windows)
    // Context menu target = a SINGLE file (not a folder) → on Windows,
    // "Open as administrator" replaces "Open in a new tab".
    in-out property <bool> ctx-selection-is-file: false;
    // A single item is selected (file OR folder) — gates "Create a shortcut".
    in-out property <bool> ctx-selection-single: false;
    // The primary selected item is a folder — hides "Open with" (files only).
    in-out property <bool> ctx-selection-is-dir: false;
    callback action-open-with();
    callback action-open-parent();
    callback action-open-terminal();
    callback action-copy();
    callback action-cut();
    callback action-paste();
    callback action-duplicate();
    callback action-copy-path();
    callback action-copy-name();
    callback action-rename();
    callback action-delete();
    callback action-delete-permanent();
    callback action-restore-last-trashed();
    // Internal deliveries from the trash workers, drained on the UI thread.
    callback process-op-events();
    callback action-properties();
    callback ctx-close();

    // ----- Menu/properties state (global) -----
    in-out property <bool> ctx-menu-open: false;
    in-out property <length> ctx-menu-x;
    in-out property <length> ctx-menu-y;
    /// Closes the open submenu and puts the keyboard back on the row that
    /// opened it. Which one is open does not matter: closing all of them is
    /// exact, since only one can be.
    function leave-submenu() {
        root.ow-menu-open = false;
        root.mark-menu-open = false;
        root.new-menu-open = false;
        root.ctx-shell-sub-open = false;
        CtxNav.leave-submenu();
    }

    // Closes ALL context menus at once. A SINGLE shared mechanism:
    // no more per-menu backdrop. DIRECT function (not via a
    // `changed`) → deterministic order when a trigger closes-then-reopens (=
    // teleporting the menu under the cursor on a right-click in a valid zone).
    function close-ctx-menus() {
        CtxNav.disarm();
        root.ctx-menu-open = false;      // the "Open with" flyout follows via `changed`
        root.url-menu-open = false;
        root.drive-menu-open = false;
        root.trash-menu-open = false;
        root.columns-menu-open = false;
        root.tab-menu-open = false;
        root.tab-empty-menu-open = false;
        root.fav-menu-open = false;
        root.split-menu-open = false;
        root.tabbar-menu-open = false;
        root.view-menu-open = false;
        root.file-drop-menu-open = false;
        root.shortcut-menu-open = false;
    }
    // Single route for the sidebar's right-clicks. The four reorderable
    // components and the Trash call it without duplicating menu
    // initialization or risking different behavior based on their rank.
    function open-sidebar-place-context(path: string, kind: int, removable: bool,
            hotplug: bool, device: string, x: length, y: length) {
        root.close-ctx-menus();
        if (kind == 3) {
            root.trash-menu-x = x;
            root.trash-menu-y = y;
            root.trash-menu-confirm = false;
            root.trash-menu-open = true;
        } else if (kind == 2 || kind == 4) {
            root.drive-menu-x = x;
            root.drive-menu-y = y;
            root.drive-menu-path = path;
            root.drive-menu-kind = kind;
            root.drive-menu-removable = removable;
            root.drive-menu-hotplug = hotplug;
            root.drive-menu-device = device;
            root.drive-menu-open = true;
        }
    }
    // Observes the "chrome" interaction counter (global Dismiss, bumped on a
    // LEFT click on rail/sidebar/headers/tabs/margins…) → closes menus (which
    // no longer have a backdrop). A RIGHT click on a valid zone does not bump and
    // reaches the trigger → reopens/teleports the menu.
    property <int> dismiss-watch: Dismiss.serial;
    changed dismiss-watch => { root.close-ctx-menus(); }
    // true = right-click on a blank area (no targeted entry) → menu
    // reduced to only the actions that make sense without a selection (Paste…).
    in-out property <bool> ctx-on-empty: false;
    // User commands PINNED to the context menu — pushed by the
    // bridge on EVERY opening (filtered by file/folder/background context).
    in property <[OpenerItem]> ctx-custom-entries;
    in-out property <bool> ctx-custom-bg: false;  // true = background menu (target = current folder)
    callback ctx-custom-run(string /*id*/);
    // Entries of the WINDOWS CONTEXT MENU (hosted shell extensions) —
    // pushed by the bridge on every opening (live IContextMenu session).
    in property <[ShellCtxEntry]> ctx-shell-entries;
    callback ctx-shell-run(int /*command offset*/);
    // Shell CASCADE flyout (PeaZip…) — same mechanism as the "Open
    // with" flyout: hover of the parent → the bridge pushes the children
    // (`ctx-shell-sub-hover`), deferred close Timer on both hovers.
    in property <[ShellCtxEntry]> ctx-shell-sub-entries;
    in-out property <bool> ctx-shell-sub-open: false;
    in-out property <length> ctx-shell-sub-x;
    in-out property <length> ctx-shell-sub-y;
    in-out property <int> ctx-shell-sub-for: -1;   // `sub` index of the open parent
    in-out property <bool> ctx-shell-sub-parent-hover: false;
    in-out property <bool> ctx-shell-sub-flyout-hover: false;
    callback ctx-shell-sub-hover(int /*sub*/);
    // Setting: integrate the Windows menu (kill-switch if the extension is slow/broken).
    in-out property <bool> shell-menu-enabled: true;
    callback shell-menu-changed(bool);
    // "Detected Windows entries" settings panel: list built at
    // launch (completed as used), checkboxes → hide/show the entry.
    in property <[ShellExtRow]> shell-ext-rows;
    callback shell-ext-toggle(string /*label*/, bool /*enabled*/);


    // ----- Rename modal popup -----
    in-out property <bool> rename-popup-open: false;
    in property <string> rename-current-name;
    // Folders keep the caret at the end; for a file, the bridge places
    // the caret right before the extension via `fs::ops::split_name`.
    in property <bool> rename-current-is-dir: false;
    in-out property <string> rename-new-name;
    callback filename-caret-offset(string /* name */, bool /* folder */) -> int;
    // Name conflict (same logic as paste): `rename-check` is called on
    // every keystroke; the bridge sets `rename-conflict` if the name is already
    // taken at the same level (or invalid). Blocks confirmation.
    in-out property <bool> rename-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine).
    // Filled by the bridge, which alone knows whether the name is taken or
    // simply unusable on this filesystem.
    in-out property <string> rename-name-error: "";
    // Replaceable conflict, file↔file only. Distinguishes a real duplicate
    // from an invalid name or a conflict involving a folder.
    in-out property <bool> rename-replace-available: false;
    callback rename-check(string);
    // Deferred focus of the field (armed on opening, consumed by a Timer in the
    // popup block — a direct focus() can freeze / loop depending on the context).
    property <bool> rename-focus-armed: false;
    changed rename-popup-open => {
        if (root.rename-popup-open) { root.rename-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // ----- New folder / file / shortcut popup (empty area) -----
    in-out property <bool> create-popup-open: false;
    // Type of entry to create: 0 = folder, 1 = file, 2 = shortcut.
    in-out property <int> create-kind: 0;
    in-out property <string> create-name;
    // New folder/file: live validation shared with Rename.
    // Shortcuts/links keep their own specific rules.
    in-out property <bool> create-name-valid: false;
    in-out property <bool> create-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine), see
    // `rename-name-error`.
    in-out property <string> create-name-error: "";
    // Target of a shortcut (mode 2): pointed-to path, typed or chosen via Browse.
    in-out property <string> create-target;
    // Shortcut popup tab: true = target a FOLDER, false = a
    // FILE. Only drives the "Browse…" picker's type (creating
    // the .lnk is identical). Default: folder.
    in-out property <bool> create-shortcut-folder: true;
    // "Create a shortcut" popup tab (kind 3): true = symlink,
    // false = .lnk shortcut (Windows). Target = selected file (create-target).
    in-out property <bool> create-link-symlink: false;
    property <bool> create-focus-armed: false;
    property <bool> create-can-confirm:
        (root.create-kind == 0 || root.create-kind == 1)
            ? (root.create-name-valid && !root.create-conflict)
            : ((root.create-kind == 2 && root.create-target != "")
                || (root.create-kind == 3 && root.create-name != ""));
    callback create-check(int /*kind*/, string /*name*/);
    callback create-confirmed(int /*kind*/, string /*name*/, string /*target*/) -> bool;
    callback create-browse-target();           // native picker → fills create-target
    callback action-create-link();             // file context menu → kind 3 popup
    changed create-name => { root.create-check(root.create-kind, root.create-name); }
    changed create-kind => { root.create-check(root.create-kind, root.create-name); }
    changed create-popup-open => {
        if (root.create-popup-open) {
            root.create-check(root.create-kind, root.create-name);
            root.create-focus-armed = true;
        }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // Permanent-deletion warning, shared between a network volume
    // without a trash and the explicit Shift+Delete shortcut.
    in-out property <bool> delete-warning-open: false;
    // true = explicit permanent deletion; false = standard network
    // deletion (the `trash` primitive will itself fall back to permanent).
    in-out property <bool> delete-warning-permanent: false;
    callback delete-warning-confirmed();

    // Paste conflict popup -----
    in-out property <bool> paste-conflict-open: false;
    // Bumped by the bridge for EACH conflict, including when the popup stays
    // open between two items. This makes focus reliable across the whole series.
    in-out property <int> paste-conflict-focus-gen: 0;
    property <bool> paste-conflict-focus-armed: false;
    changed paste-conflict-open => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }
    changed paste-conflict-focus-gen => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
    }
    // Original name in conflict (shown in the message).
    in property <string> paste-conflict-original;
    // Type of the source, to never interpret a folder name's dot
    // as an extension when positioning the caret.
    in property <bool> paste-conflict-is-dir: false;
    // Name proposed / edited by the user.
    in-out property <string> paste-conflict-name;
    // True if the entered name is already taken (or invalid) — disables "Paste".
    in property <bool> paste-conflict-name-taken: false;
    // True when the conflict is a COPY WITHIN THE SAME FOLDER: overwriting
    // would amount to destroying the source, skipping amounts to canceling → we show
    // ONLY "Cancel" / "Paste" (with the renamed name). Set by the bridge.
    in property <bool> paste-conflict-rename-only: false;
    /// Live validation on every keystroke (the bridge updates name-taken).
    callback paste-conflict-check(string);
    /// Pastes with the entered name (resolves this conflict, moves to the next).
    callback paste-conflict-confirm(string);
    /// Skips this item — the others continue.
    callback paste-conflict-skip();
    /// Overwrites the existing target for THIS item, then moves to the next.
    callback paste-conflict-replace();
    /// Overwrites THIS item and all remaining conflicts, then runs.
    callback paste-conflict-replace-all();
    /// Skips THIS item and all remaining conflicts, then runs.
    callback paste-conflict-skip-all();
    /// Cancels the whole paste operation.
    callback paste-conflict-cancel();

    // Long operations in progress, one row per operation and one
    // non-blocking floating toast each. Driven by the bridge (background threads).
    // A row only appears once its operation passes the deferred-appearance
    // threshold, so a quick copy never flashes a toast.
    in property <[OpProgress]> ops: [];
    // "+N others" summary shown when more operations run than the stack displays.
    in property <string> ops-more-text;
    /// `true` while at least one operation is in flight — including those with no
    /// toast yet. Gates the deferred refreshes, which must not re-list mid-operation.
    in property <bool> op-busy: false;
    /// Emitted by the bridge (from a worker thread) to create or refresh one
    /// operation's row.
    callback op-progress(OpProgress);
    callback op-cancel(int);
    /// Emitted by the bridge at the end of an operation (releases it on the Rust side).
    callback op-finished(int);
    /// Closes one operation's toast, by hand or after its auto-dismiss delay.
    callback op-dismiss(int);

    // ----- Settings -----
    in-out property <bool> settings-open: false;
    // Annotations pointing at an item that is gone. Counted when the panel
    // opens, never swept on its own — see the hint beside the button.
    in-out property <int> annotation-orphans: 0;
    callback count-annotation-orphans();
    /// Opens the cleanup list. The sweeping itself waits for an answer.
    callback clean-annotations();
    /// The cleanup list, and what is ticked in it.
    ///
    /// Ticks are NOT held here: the bridge owns the set of keys, and this model
    /// only mirrors it. That is what lets "Select all" cover every orphan
    /// rather than only the rows currently built.
    in-out property <bool> orphans-open: false;
    in property <[OrphanRow]> orphan-rows;
    /// Label of the confirming button, count already interpolated by the
    /// bridge — where the number sits in the sentence differs by language.
    in property <string> orphans-confirm-label;
    in property <int> orphans-checked: 0;
    callback orphan-toggled(string, bool);
    callback orphans-select-all(bool);
    callback orphans-confirmed();
    // App version (CARGO_PKG_VERSION), set by the bridge.
    in property <string> app-version: "0.0.0";
    // Active tab of the Settings panel: 0 = General, 1 = Shortcuts (key
    // management has its own page so it no longer weighs down "General").
    in-out property <int> settings-tab: 0;
    // Sub-tab of the "Open with" tab: 0 = Favnyr commands,
    // 1 = detected Windows entries (shell extensions).
    in-out property <int> ow-subtab: 0;
    // LAZY probe of the shell menu: triggered when the
    // sub-tab opens — nothing at startup (see `scan_shell_ext`).
    callback shell-ext-scan();
    changed ow-subtab => {
        if (self.ow-subtab == 1) { root.shell-ext-scan(); }
    }
    in property <string> config-dir-path;
    in property <string> data-dir-path;
    in property <string> cache-dir-path;
    // True when the config folder == the data folder (Windows case:
    // `config.toml` lives in the Data dir) → the "Configuration file" row
    // would be redundant and is hidden. On Linux the two differ.
    in property <bool> config-path-redundant: false;

    // Named workspaces (overlay) -----
    in-out property <bool> workspaces-open: false;
    // On menu OPENING, recomputes the list and flags from the
    // live state (including "unsaved changes") — regardless of how the menu was
    // opened (button, shortcut…).
    changed workspaces-open => {
        if (self.workspaces-open) { root.ws-refresh(); }
        // The "save as workspace" sub-input grabs focus; on close return it to
        // the keyboard scope so Escape / shortcuts keep working (grouped note below).
        else { key-scope.focus(); }
    }
    in property <[WorkspaceEntry]> workspaces;
    in-out property <string> ws-toast: "";   // feedback message (cleared by a Timer)
    // GLOBAL "notice" toast (e.g. "Access denied" on an unreadable folder) — set
    // by the bridge, auto-cleared by a Timer. Independent of overlays.
    in-out property <string> notice-text: "";
    // Toast tone: 0 = danger (red), 1 = success (green),
    // 2 = info (accent). Drives background + border + icon tint. Set by the bridge.
    in-out property <int> notice-tone: 0;
    // Toast icon: 0 = closed lock (access/error), 1 = open
    // lock (eject OK), 2 = checkmark (generic success), 3 = bookmark (favorites).
    in-out property <int> notice-icon: 0;
    // Toast display duration, set by the bridge based on message LENGTH
    // (adaptive reading time) — a long message (e.g. "service X is using the
    // device") stays displayed longer.
    in-out property <duration> notice-duration: 2800ms;
    // List sort direction: true = most recent first (default).
    in-out property <bool> ws-sort-newest-first: true;
    callback ws-save-new(string);       // saves the current state under this name
    callback ws-save-current();         // quick save of the current named workspace
    in-out property <bool> ws-name-taken: false;
    callback ws-name-check(string);     // live validation: name already used?
    // Deferred focus of the "workspace name" field — armed ONLY when the
    // panel opens because the user asked to SAVE a
    // still-unnamed workspace (Ctrl+S on an ad hoc state): the cursor is then in the
    // field, indicating a name must be entered. Normal opening (rail
    // button, Ctrl+Q) → not armed: the list is browsed, nothing gets named.
    in-out property <bool> ws-name-focus-armed: false;
    callback ws-load(string);           // loads workspace `id` (WITHOUT the guard)
    callback ws-overwrite(string);      // replaces workspace `id` with the current state
    callback ws-delete(string);         // deletes workspace `id`
    callback ws-rename(string, string); // (id, new-name)
    callback ws-reset();                // starts over from a blank space (1 panel, $HOME) — DIRECT
    callback ws-reset-guarded();        // "Start a new workspace" WITH the guard
    // "Unsaved changes" guard. The Load button goes
    // through `ws-load-guarded`: the bridge loads directly if the current state is clean,
    // otherwise it FILLS the dialog below (interpolated texts + target id) and
    // opens it. `ws-save-and-load` saves the current state THEN loads the target.
    callback ws-load-guarded(string /*target_id*/);
    callback ws-save-and-load();        // saves the current state THEN runs the pending action
    // Recomputes the list + the is-current/is-dirty flags from the LIVE state.
    // Called on EVERY menu opening (see `changed workspaces-open`): the
    // "unsaved changes" check happens when the menu opens, not
    // only after a save.
    callback ws-refresh();
    in-out property <bool> ws-dirty-warn-open: false;
    in-out property <string> ws-dirty-title-text;   // interpolated by the bridge
    in-out property <string> ws-dirty-body-text;    // interpolated by the bridge
    in-out property <string> ws-dirty-target-id;    // workspace to load after the decision
    // Nature of the pending action behind the dialog: false = load
    // `ws-dirty-target-id`, true = start over blank ("Start a new workspace").
    in-out property <bool> ws-dirty-reset: false;
    callback ws-toggle-sort();          // reverses the list's sort direction

    // "Places" sidebar -----
    // Stable semantic models. The order of the four movable sections
    // is a small model of codes: 0 Drives · 1 Shortcuts · 2 Favorites ·
    // 3 Network. Trash stays fixed below them.
    in property <[SidebarPlace]> sidebar-places-drives;
    in property <[SidebarPlace]> sidebar-places-shortcuts;
    in property <[SidebarPlace]> sidebar-places-network;
    in property <[SidebarPlace]> sidebar-places-trash;
    in property <[int]> sidebar-section-order;
    in-out property <bool> sidebar-section-drag-active: false;
    in-out property <int> sidebar-section-drag-source: -1;
    in-out property <int> sidebar-section-drag-target: -1;
    in-out property <length> sidebar-section-drag-preview-y: 0px;
    in-out property <length> sidebar-section-drag-last-x: 0px;
    in-out property <length> sidebar-section-drag-last-y: 0px;
    callback sidebar-section-reordered(int /*section*/, int /*final index*/);
    changed sidebar-section-order => { root.cancel-sidebar-section-drag(); }
    // Open left panel: 0 collapsed · 1 Places · 2 Favorites.
    in-out property <int> left-panel: 1;
    in-out property <length> sidebar-width: 210px;
    callback sidebar-place-clicked(string, int);   // (path, kind)
    callback place-open-new-tab(string, int);      // (path, kind) → new tab (active view)
    // A navigable location dropped on a tab gap or onto a panel. Favorite ids
    // use kind -1; the bridge resolves their stored path before acting.
    callback sidebar-item-dropped(string, int, int, int, int);
    in-out property <bool> sidebar-item-drag-active: false;
    // True only for sources that designate a directory. A favorite pointing to
    // a file may still become a tab at an exact gap, but never a panel drop.
    in-out property <bool> sidebar-item-split-capable: false;
    property <bool> sidebar-item-panel-drop-valid:
        root.sidebar-item-drag-active
        && root.sidebar-item-split-capable
        && root.drag-target-panel >= 0
        && root.drag-target-zone > 0
        && (root.drag-target-zone == 1 || root.can-add-panel);
    // Mirrors every successful release: exact tab gap, panel center/edge, or
    // an internal favorite reorder. The no-drop pill therefore cannot conflict
    // with an insertion line or split preview.
    property <bool> sidebar-item-drop-will-cancel:
        root.sidebar-item-drag-active
        && !(root.drag-target-gap-panel >= 0 && root.drag-target-gap >= 0)
        && !root.sidebar-item-panel-drop-valid
        && !(root.fav-drag-active && sidebar-column.reorder-hover-panel);
    // Containers and unavailable favorite locations only support tree
    // reordering. Once outside that tree, releasing cannot perform an action.
    property <bool> favorite-reorder-drop-will-cancel:
        root.fav-drag-active
        && !root.sidebar-item-drag-active
        && !sidebar-column.reorder-hover-panel;
    function begin-sidebar-item-drag(
        abs-x: length, abs-y: length, can-split: bool
    ) {
        root.drag-abs-x = abs-x;
        root.drag-abs-y = abs-y;
        root.drag-source-panel = -1;
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.sidebar-item-split-capable = can-split;
        root.sidebar-item-drag-active = true;
    }
    function update-sidebar-item-drag(abs-x: length, abs-y: length) {
        if (!root.sidebar-item-drag-active) { return; }
        root.drag-abs-x = abs-x;
        root.drag-abs-y = abs-y;
    }
    function cancel-sidebar-item-drag() {
        root.sidebar-item-drag-active = false;
        root.sidebar-item-split-capable = false;
        root.drag-target-panel = -1;
        root.drag-target-zone = 0;
        root.drag-target-gap = -1;
        root.drag-target-gap-panel = -1;
        root.drag-source-panel = -1;
    }
    function finish-sidebar-item-drag(
        source: string, kind: int, abs-x: length, abs-y: length
    ) -> bool {
        if (!root.sidebar-item-drag-active) { return false; }
        root.update-sidebar-item-drag(abs-x, abs-y);
        let gap-panel: int = root.drag-target-gap-panel;
        let gap: int = root.drag-target-gap;
        let gap-accepted: bool = gap-panel >= 0 && gap >= 0;
        let panel-accepted: bool = !gap-accepted && root.sidebar-item-panel-drop-valid;
        let panel: int = gap-accepted ? gap-panel : root.drag-target-panel;
        let drop-gap: int = gap-accepted ? gap : -1;
        let drop-zone: int = panel-accepted ? root.drag-target-zone : 0;
        let accepted: bool = gap-accepted || panel-accepted;
        root.cancel-sidebar-item-drag();
        if (accepted) {
            root.sidebar-item-dropped(source, kind, panel, drop-gap, drop-zone);
        }
        return accepted;
    }
    callback sidebar-refresh();                     // re-scans places
    callback poll-drives();                          // lightweight drive check: rebuilds only if changed
    // Cross-instance IPC init: `true` = initialized (the Timer stops),
    // `false` = window not ready yet → the Timer retries.
    callback init-ipc() -> bool;
    // Scroll of a panel's tab bar (viewport-x ≤ 0, plain) —
    // reported to the bridge for cross-instance insertion hit-testing.
    callback panel-tabs-scrolled(int, length);
    // PLAIN geometry of the panels container: read LAZILY by
    // the bridge (Rust getter, at the time of a cross-instance drop) → hit-test
    // of the target panel/gap. absolute-position read at the container level —
    // same family as `tabs-row-x` (proven pattern, no layout cycle).
    out property <length> panels-cont-x: panels-container.absolute-position.x;
    out property <length> panels-cont-y: panels-container.absolute-position.y;
    out property <length> panels-cont-w: panels-container.width;
    out property <length> panels-cont-h: panels-container.height;
    // "Unavailable" tabs (network/missing folder): `any-unavailable`
    // (set by the bridge) → a Timer calls `recheck-unavailable` to retry
    // as soon as a drive/mount changes.
    in-out property <bool> any-unavailable: false;
    callback recheck-unavailable();
    callback empty-trash();                         // empties the trash (permanent)
    // Trash context menu (right-click on the Trash entry).
    in-out property <bool> trash-menu-open: false;
    in-out property <length> trash-menu-x;
    in-out property <length> trash-menu-y;
    in-out property <bool> trash-menu-confirm: false;   // 2nd click = confirmation
    // Context menu of a drive / network location (right-click).
    in-out property <bool> drive-menu-open: false;
    in-out property <length> drive-menu-x;
    in-out property <length> drive-menu-y;
    in-out property <string> drive-menu-path;
    in-out property <int> drive-menu-kind;
    in-out property <bool> drive-menu-removable;   // → offers to release the drive
    // Unpluggable hardware → the entry and the toast say so; otherwise both
    // speak of releasing, which is all that actually happens.
    in-out property <bool> drive-menu-hotplug;
    in-out property <string> drive-menu-device;    // eject/disconnect target (empty → actions hidden)
    callback drive-eject(string, bool);  // release (device, unpluggable)
    callback drive-disconnect(string);   // disconnects a mapped network drive (device)
    callback place-copy-path(string);    // copies the path to the clipboard
    // Re-scans places when the Places panel is (re)opened.
    changed left-panel => {
        if (root.left-panel == 1) {
            root.sidebar-refresh();
        } else {
            root.cancel-sidebar-section-drag();
            root.cancel-sidebar-item-drag();
        }
    }
    // Auto-expand on drag: restarts the countdown when the
    // hovered collapsed container changes (declared at the component level to see the
    // property; the `fav-autoexp-timer` Timer lives in the window's body).
    changed fav-drag-hover-container => { fav-autoexp-timer.restart(); }
    // Auto-expand during a TAB/FILE drag: mirrors
    // `sidebar-column.hover-collapsed-container` (hovered collapsed container) declared at the
    // ROOT to be visible to the Timer + its `changed` that restarts the countdown.
    property <string> fav-ext-collapsed: sidebar-column.hover-collapsed-container;
    changed fav-ext-collapsed => { fav-autoexp-ext-timer.restart(); }
    // Auto-expanding the collapsed favorites SECTION on drag-hover is driven
    // purely by the Timer's `running` binding below (single target → no need to
    // re-arm on change, unlike the multi-container case above). Mixing an
    // imperative `restart()` with `running` here caused stray fires.
    // The "Open with" flyout closes along with its parent menu.
    changed ctx-menu-open => {
        if (!root.ctx-menu-open) {
            root.ow-menu-open = false;
            root.new-menu-open = false;
            root.ctx-shell-sub-open = false;
            root.mark-menu-open = false;
            CtxNav.disarm();
        }
    }
    // A submenu opened with the keyboard highlights its first entry. Its
    // entries are built a moment after the key was pressed, so the wish waits
    // here until they say they exist.
    property <int> nav-born: CtxNav.born;
    changed nav-born => {
        if (CtxNav.want-first && CtxNav.level == 2) {
            CtxNav.want-first = false;
            CtxNav.step(1);
        }
    }
    // A submenu also goes away on its own: the pointer leaves it and the close
    // timer fires. The keyboard follows it back to the row that opened it.
    property <bool> ctx-sub-open: root.ow-menu-open || root.mark-menu-open
        || root.new-menu-open || root.ctx-shell-sub-open;
    changed ctx-sub-open => {
        if (!root.ctx-sub-open && CtxNav.level == 2) { CtxNav.leave-submenu(); }
    }

    // Tree-structured favorites -----
    in property <[FavNode]> fav-nodes;          // flattened tree (visible nodes)
    in-out property <string> fav-selected-id: "";
    callback fav-row-activate(string);          // click: container→toggle / favorite→open
    callback fav-row-middle(string);            // middle-click favorite → new tab
    callback fav-collapse-all();
    callback fav-open(string);                  // open favorite (new tab)
    callback fav-open-all(string);              // container: open all children
    callback fav-delete(string);
    callback fav-copy-path(string);
    // Drag reordering: delegated to the bridge (target/zone computed in f32).
    callback fav-drag-move(int, length, length);   // (row-index, cur-y, row-top)
    callback fav-drag-drop(int, length, length, bool); // final bool: commit tree move
    // Context menu of a favorite node.
    in-out property <bool> fav-menu-open: false;
    in-out property <length> fav-menu-x;
    in-out property <length> fav-menu-y;
    in-out property <string> fav-menu-id: "";
    in-out property <string> fav-menu-name: "";             // label (pre-fills the rename)
    in-out property <bool> fav-menu-container: false;
    in-out property <bool> fav-menu-confirm-delete: false;  // 2nd click, non-empty container
    // Modal popup for creating or renaming a favorites container.
    // `rename` distinguishes create/rename; `target` = id to rename (rename) or
    // parent id (create; "" = root). `invalid` is set by the bridge.
    in-out property <bool> fav-name-open: false;
    in-out property <bool> fav-name-rename: false;
    in-out property <string> fav-name-target: "";
    in-out property <string> fav-name-value: "";
    in-out property <bool> fav-name-invalid: true;
    in-out property <bool> fav-name-focus-armed: false;
    callback fav-name-check(string);
    callback fav-name-confirm();
    // Drag indicators (set by the bridge during the move).
    in-out property <bool> fav-drag-active: false;
    in-out property <int> fav-drag-target-index: -1;
    in-out property <int> fav-drag-zone: 0;
    // Collapsed container currently hovered during a drag (auto-expand after a delay).
    in-out property <string> fav-drag-hover-container: "";
    callback fav-expand(string);   // expands a container (IN-PLACE insertion → drag preserved)
    // Toggle "Collapse all" / "Expand all" (containers).
    in-out property <bool> fav-can-collapse: false;
    callback fav-expand-all();
    // Collapse of the Favorites SECTION — hides the tree in the unified column.
    in-out property <bool> fav-section-collapsed: false;
    // The three other collapsible sections of the left column. These four
    // properties are restored from the workspace by the bridge.
    in-out property <bool> sidebar-shortcuts-collapsed: false;
    in-out property <bool> sidebar-drives-collapsed: false;
    in-out property <bool> sidebar-network-collapsed: false;
    callback sidebar-section-state-changed(int /*0 drives · 1 shortcuts · 2 favorites · 3 network*/,
        bool /*collapsed*/);
    function toggle-sidebar-section(section: int) {
        if (section == 0) {
            root.sidebar-drives-collapsed = !root.sidebar-drives-collapsed;
            root.sidebar-section-state-changed(0, root.sidebar-drives-collapsed);
        } else if (section == 1) {
            root.sidebar-shortcuts-collapsed = !root.sidebar-shortcuts-collapsed;
            root.sidebar-section-state-changed(1, root.sidebar-shortcuts-collapsed);
        } else if (section == 2) {
            root.fav-section-collapsed = !root.fav-section-collapsed;
            root.sidebar-section-state-changed(2, root.fav-section-collapsed);
        } else if (section == 3) {
            root.sidebar-network-collapsed = !root.sidebar-network-collapsed;
            root.sidebar-section-state-changed(3, root.sidebar-network-collapsed);
        }
    }
    // Rank in the global preference. The fallback preserves the historical
    // order during the very first milliseconds, before the bridge's push.
    pure function sidebar-section-rank(section: int) -> int {
        if (root.sidebar-section-order.length == 4) {
            if (root.sidebar-section-order[0] == section) { return 0; }
            if (root.sidebar-section-order[1] == section) { return 1; }
            if (root.sidebar-section-order[2] == section) { return 2; }
            if (root.sidebar-section-order[3] == section) { return 3; }
        }
        return section;
    }
    pure function sidebar-section-top(section: int) -> length {
        return sidebar-column.section-top(section);
    }
    pure function sidebar-section-bottom(section: int) -> length {
        return sidebar-column.section-bottom(section);
    }
    pure function sidebar-section-header-middle(section: int) -> length {
        // All headers are exactly 30px. An expanded section's content
        // must never enlarge its reordering toggle zone.
        return root.sidebar-section-top(section) + 15px;
    }
    // Final index after removal then insertion. Only the centers of the three
    // (remaining) HEADERS matter: identical behavior whether the section is collapsed or very tall.
    pure function sidebar-section-target-at(source: int, local-y: length) -> int {
        return (source != 0 && local-y > root.sidebar-section-header-middle(0) ? 1 : 0)
            + (source != 1 && local-y > root.sidebar-section-header-middle(1) ? 1 : 0)
            + (source != 2 && local-y > root.sidebar-section-header-middle(2) ? 1 : 0)
            + (source != 3 && local-y > root.sidebar-section-header-middle(3) ? 1 : 0);
    }
    pure function sidebar-section-remaining-rank(section: int, source: int) -> int {
        return root.sidebar-section-rank(section)
            - (root.sidebar-section-rank(section) > root.sidebar-section-rank(source) ? 1 : 0);
    }
    pure function sidebar-section-at-remaining-rank(rank: int, source: int) -> int {
        if (source != 0 && root.sidebar-section-remaining-rank(0, source) == rank) { return 0; }
        if (source != 1 && root.sidebar-section-remaining-rank(1, source) == rank) { return 1; }
        if (source != 2 && root.sidebar-section-remaining-rank(2, source) == rank) { return 2; }
        return 3;
    }
    function update-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (!root.sidebar-section-drag-active || section != root.sidebar-section-drag-source) { return; }
        root.sidebar-section-drag-last-x = abs-x;
        root.sidebar-section-drag-last-y = abs-y;
        let local-y: length = abs-y - sidebar-column.stack-y;
        if (abs-x < sidebar-column.stack-x
                || abs-x > sidebar-column.stack-x + sidebar-column.stack-w
                || local-y < 0px || local-y > sidebar-column.stack-h) {
            root.sidebar-section-drag-target = -1;
            return;
        }
        root.sidebar-section-drag-target = root.sidebar-section-target-at(section, local-y);
        if (root.sidebar-section-drag-target < 3) {
            root.sidebar-section-drag-preview-y = root.sidebar-section-top(
                root.sidebar-section-at-remaining-rank(root.sidebar-section-drag-target, section));
        } else {
            root.sidebar-section-drag-preview-y = root.sidebar-section-bottom(
                root.sidebar-section-at-remaining-rank(2, section));
        }
    }
    function refresh-sidebar-section-drag-geometry() {
        if (root.sidebar-section-drag-active) {
            root.update-sidebar-section-drag(root.sidebar-section-drag-source,
                root.sidebar-section-drag-last-x, root.sidebar-section-drag-last-y);
        }
    }
    function start-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (section < 0 || section > 3 || root.left-panel != 1) { return; }
        root.sidebar-section-drag-active = true;
        root.sidebar-section-drag-source = section;
        root.sidebar-section-drag-target = root.sidebar-section-rank(section);
        root.update-sidebar-section-drag(section, abs-x, abs-y);
    }
    function drop-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        root.update-sidebar-section-drag(section, abs-x, abs-y);
        let target: int = root.sidebar-section-drag-target;
        let source-rank: int = root.sidebar-section-rank(section);
        root.cancel-sidebar-section-drag();
        if (target >= 0 && target != source-rank) {
            root.sidebar-section-reordered(section, target);
        }
    }
    function cancel-sidebar-section-drag() {
        root.sidebar-section-drag-active = false;
        root.sidebar-section-drag-source = -1;
        root.sidebar-section-drag-target = -1;
    }
    // "Save as favorite" popup (from a tab / file).
    in-out property <bool> fav-save-open: false;
    in-out property <bool> fav-save-focus-armed: false;
    in-out property <string> fav-save-target: "";     // path (or "N items")
    in-out property <bool> fav-save-multi: false;
    in-out property <string> fav-save-alias: "";
    in property <[string]> fav-container-labels;       // indented labels (dropdown)
    in-out property <int> fav-container-index: 0;      // 0 = Root
    callback fav-save-commit(string, int);             // (alias, container index)
    callback fav-save-new-container(string, int);      // (name, parent container index) → creates + selects
    // "New container" sub-popup (from the save popup).
    in-out property <bool> fav-newc-open: false;
    in-out property <bool> fav-newc-focus-armed: false;
    in-out property <string> fav-newc-name: "";
    in-out property <int> fav-newc-parent-index: 0;    // 0 = Root
    // Save requests (triggered by the tab/file menus).
    callback fav-save-tab(int, int);                   // (panel, tab)
    callback fav-save-all-tabs(int);                   // (panel)
    callback duplicate-tab(int, int);                  // (panel, tab) → copy inserted after
    callback fav-add-selection();                      // selected files (active view)
    // Context menu of a tab (right-click).
    in-out property <bool> tab-menu-open: false;
    in-out property <length> tab-menu-x;
    in-out property <length> tab-menu-y;
    in-out property <int> tab-menu-panel: -1;
    in-out property <int> tab-menu-tab: -1;
    // Menu of a tab bar's dead zone. It reuses the existing favorites
    // callback and only exposes the specific restore action.
    in-out property <bool> tab-empty-menu-open: false;
    in-out property <length> tab-empty-menu-x;
    in-out property <length> tab-empty-menu-y;
    in-out property <int> tab-empty-menu-panel: -1;
    in-out property <bool> closed-tabs-available: false;
    callback reopen-last-closed-tab(int /*panel*/);

    // Context menu of a keyboard shortcut: same shared mechanism as
    // the other menus (close-ctx-menus / Dismiss). `action` = the targeted id.
    in-out property <bool> shortcut-menu-open: false;
    in-out property <length> shortcut-menu-x;
    in-out property <length> shortcut-menu-y;
    in-out property <string> shortcut-menu-action;
    function open-shortcut-menu(action: string, ax: length, ay: length) {
        root.close-ctx-menus();
        root.shortcut-menu-action = action;
        root.shortcut-menu-x = ax;
        root.shortcut-menu-y = ay;
        root.shortcut-menu-open = true;
    }

    // Opens the naming popup for a favorites container. `rename`: false =
    // create (target = parent id, "" = root), true = rename (target = id).
    function open-fav-name(rename: bool, target: string, value: string) {
        root.fav-name-rename = rename;
        root.fav-name-target = target;
        root.fav-name-value = value;
        root.fav-name-open = true;
        root.fav-name-focus-armed = true;
        root.fav-name-check(value);   // sets `fav-name-invalid` (empty → disabled)
    }

    // ----- Theme -----
    public function apply-theme() {
        if (root.theme-pref == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.theme-pref == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    init => { apply-theme(); }
    changed theme-pref => { apply-theme(); }
    // closing settings cancels any ongoing capture/conflict (otherwise the
    // `key-scope` would stay stuck in capture mode).
    changed settings-open => {
        if (!root.settings-open) {
            root.shortcut-capturing = "";
            root.shortcut-conflict-action = "";
            root.shortcut-conflict-message = "";
        } else {
            // On OPENING: re-detects ffmpeg (Linux) — the user may have
            // installed it since last time → status stays current with no action needed.
            root.ffmpeg-recheck();
            // Same reasoning: the count is a filesystem walk, so it is taken
            // when the panel opens rather than kept live.
            root.count-annotation-orphans();
            // On OPENING, returns focus to the root keyboard scope → Escape closes
            // the dialog even when it was opened via a click (gear button):
            // otherwise no element has focus and `key-scope.key-pressed` (which handles
            // Escape) never gets called. Consistent with shortcut capture, which
            // already requires this focus.
            key-scope.focus();
        }
    }

    // Text-field popups grab focus into their edit field when they open. On
    // CLOSE that field is destroyed, so — unless we act — focus is left on
    // nothing and `key-scope` (which handles Escape and the shortcuts) stops
    // receiving keys. Most visible when the popup sat on top of ANOTHER overlay,
    // e.g. Custom Command over Settings: after closing the popup with Escape, a
    // second Escape could no longer close the settings. Hand focus back to
    // `key-scope` on every close (all paths: Escape, buttons, backdrop).
    // rename / create / paste-conflict / workspaces do the same above.
    changed ow-popup-open => { if (!root.ow-popup-open) { key-scope.focus(); } }
    changed fav-name-open => { if (!root.fav-name-open) { key-scope.focus(); } }
    changed fav-newc-open => { if (!root.fav-newc-open) { key-scope.focus(); } }

    // Configurable shortcuts -----
    // Normalizes `event.text` into a canonical key name (special keys
    // are `Key.*` constants). Letters/digits/punctuation pass through as-
    // is (the bridge uppercases letters). Aligned with `shortcuts.rs`.
    pure function chord-key-name(t: string) -> string {
        if (t == Key.UpArrow) { return "ArrowUp"; }
        if (t == Key.DownArrow) { return "ArrowDown"; }
        if (t == Key.LeftArrow) { return "ArrowLeft"; }
        if (t == Key.RightArrow) { return "ArrowRight"; }
        if (t == Key.Tab) { return "Tab"; }
        if (t == Key.Backtab) { return "Tab"; }
        if (t == Key.Return) { return "Enter"; }
        if (t == Key.Delete) { return "Delete"; }
        if (t == Key.Home) { return "Home"; }
        if (t == Key.End) { return "End"; }
        if (t == Key.PageUp) { return "PageUp"; }
        if (t == Key.PageDown) { return "PageDown"; }
        if (t == Key.Insert) { return "Insert"; }
        if (t == Key.Space) { return "Space"; }
        if (t == Key.F1) { return "F1"; }
        if (t == Key.F2) { return "F2"; }
        if (t == Key.F3) { return "F3"; }
        if (t == Key.F4) { return "F4"; }
        if (t == Key.F5) { return "F5"; }
        if (t == Key.F6) { return "F6"; }
        if (t == Key.F7) { return "F7"; }
        if (t == Key.F8) { return "F8"; }
        if (t == Key.F9) { return "F9"; }
        if (t == Key.F10) { return "F10"; }
        if (t == Key.F11) { return "F11"; }
        if (t == Key.F12) { return "F12"; }
        // Backslash / pipe (Shift+\) → stable name independent of the layout.
        if (t == "\\" || t == "|") { return "Backslash"; }
        if (t == ",") { return "Comma"; }
        return t;
    }

    // Executes action `id` (resolved by `match-action`). Centralizes each
    // shortcut's behavior; the combination→id mapping is
    // driven by the config (rebind).
    function perform-action(id: string) {
        // Cursor navigation (keyboard)
        if (id == "cursor-up") { root.move-cursor(0, false); return; }
        if (id == "cursor-down") { root.move-cursor(1, false); return; }
        if (id == "cursor-first") { root.move-cursor(2, false); return; }
        if (id == "cursor-last") { root.move-cursor(3, false); return; }
        if (id == "cursor-left") { root.move-cursor(4, false); return; }
        if (id == "cursor-right") { root.move-cursor(5, false); return; }
        if (id == "extend-up") { root.move-cursor(0, true); return; }
        if (id == "extend-down") { root.move-cursor(1, true); return; }
        if (id == "extend-left") { root.move-cursor(4, true); return; }
        if (id == "extend-right") { root.move-cursor(5, true); return; }
        // Folder navigation
        if (id == "nav-back") { root.go-back(); return; }
        if (id == "nav-forward") { root.go-forward(); return; }
        if (id == "nav-parent") { root.go-parent(); return; }
        if (id == "nav-home") { root.go-home(); return; }
        if (id == "refresh") { root.refresh(); return; }
        // Ctrl+L: focuses the ACTIVE panel's address bar. The counter
        // is observed by each PanelComponent; only the active one enters edit mode.
        if (id == "focus-address") { root.address-focus-gen += 1; return; }
        // Selection
        if (id == "select-all") { root.select-all(); return; }
        // Tabs & views
        if (id == "tab-new") { root.tab-new(); return; }
        if (id == "tab-close") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-closed(root.panels[root.active-panel-idx].active-tab-idx);
            }
            return;
        }
        if (id == "tab-reopen-closed") {
            root.reopen-last-closed-tab(root.active-panel-idx);
            return;
        }
        if (id == "tab-next") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(mod(
                    root.panels[root.active-panel-idx].active-tab-idx + 1,
                    root.panels[root.active-panel-idx].tabs.length));
            }
            return;
        }
        if (id == "tab-prev") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(root.panels[root.active-panel-idx].active-tab-idx <= 0
                    ? root.panels[root.active-panel-idx].tabs.length - 1
                    : root.panels[root.active-panel-idx].active-tab-idx - 1);
            }
            return;
        }
        if (id == "view-next") {
            if (root.panels.length > 1) {
                root.panel-clicked(mod(root.active-panel-idx + 1, root.panels.length));
            }
            return;
        }
        if (id == "split-side") { root.panel-split(0); return; }
        if (id == "split-stack") { root.panel-split(1); return; }
        if (id == "equalize-views") { root.equalize-views(-1); return; }
        // File operations
        if (id == "open") { root.action-open(); return; }
        if (id == "copy") { root.action-copy(); return; }
        if (id == "cut") { root.action-cut(); return; }
        if (id == "paste") { root.action-paste(); return; }
        if (id == "rename") { root.action-rename(); return; }
        if (id == "delete") { root.action-delete(); return; }
        if (id == "delete-permanent") { root.action-delete-permanent(); return; }
        if (id == "restore-trash") { root.action-restore-last-trashed(); return; }
        if (id == "new-folder") { root.create-kind = 0; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; return; }
        if (id == "new-file") { root.create-kind = 1; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; return; }
        if (id == "terminal") { root.action-open-terminal(); return; }
        if (id == "properties") { root.action-properties(); return; }
        // Display options
        if (id == "toggle-hidden") { root.toggle-show-hidden(root.active-panel-idx); return; }
        if (id == "cycle-group") {
            if (root.active-panel-idx < root.panels.length) {
                root.set-group-mode(root.active-panel-idx,
                    root.panels[root.active-panel-idx].group-mode == "folders" ? "files"
                    : root.panels[root.active-panel-idx].group-mode == "files" ? "mixed"
                    : root.panels[root.active-panel-idx].group-mode == "mixed" ? "category"
                    : "folders");
            }
            return;
        }
        if (id == "toggle-view-mode") { root.cycle-view-mode(root.active-panel-idx); return; }
        // Application
        if (id == "save-workspace") { root.ws-save-current(); return; }
        if (id == "open-settings") { root.settings-open = true; return; }
        if (id == "open-workspaces") { root.workspaces-open = true; return; }
    }

    // ----- Root focus scope (global keyboard shortcuts) -----
    key-scope := FocusScope {
        // Coming back from another application. Only a WINDOW activation
        // counts: focus moving inside Favnyr is not the user returning from
        // somewhere else. Slint hands the activation to the element that had
        // focus, which is this scope in the ordinary case.
        focus-gained(reason) => {
            if (reason == FocusReason.window-activation) {
                WindowFocus.activations += 1;
            }
        }
        // Focus ON STARTUP: without this, the active view doesn't have keyboard
        // focus until it's been clicked into → a shortcut like Ctrl+L
        // would have no effect on a cold start.
        init => { self.focus(); }
        // Focus returning to Favnyr (Alt-Tab, click from another window)
        // while a file drag is still "active": the user left then came
        // back → the gesture must have ended (mouse released
        // outside the window, `up` lost). We cancel this phantom drag, otherwise the pill
        // stays stuck to the cursor. The `file-drag-active` guard prevents any
        // effect during a normal focus change (a real drag never causes the
        // window to lose focus). The scope keeps focus on wake-up (Slint
        // forwards the activation event to the previously focused element).
        changed has-focus => {
            if (self.has-focus && root.sidebar-section-drag-active) {
                root.cancel-sidebar-section-drag();
            }
            // An external OLE drag can legitimately reactivate Favnyr while
            // its source prepares temporary files. OLE DragLeave/Drop owns
            // that lifecycle; this focus fallback only cancels an INTERNAL
            // gesture whose mouse-up was lost outside the window.
            if (self.has-focus && root.file-drag-active
                    && root.file-drag-source-panel >= 0) {
                root.file-drag-active = false;
                root.file-drag-target-panel = -1;
                root.file-drag-target-row = -1;
                root.file-drag-target-folder = false;
                root.file-drag-target-exec = false;
                root.file-drag-target-invalid = false;
            }
        }
        // Ctrl key tracking: reflects the modifier on every key
        // → Ctrl+wheel = zoom entries (see PanelTile.scroll-event).
        key-released(event) => {
            if (event.text == Key.Control) { root.ctrl-down = false; }
            if (event.text == Key.Shift) { root.shift-down = false; }
            if (root.file-drag-active && root.file-drag-source-panel >= 0) {
                root.file-drag-copy = root.ctrl-down;
            }
            return reject;
        }
        key-pressed(event) => {
            root.keyboard-interaction-gen += 1;
            root.ctrl-down = event.modifiers.control;
            root.shift-down = event.modifiers.shift;
            if (root.file-drag-active && root.file-drag-source-panel >= 0) {
                root.file-drag-copy = root.ctrl-down;
            }
            // capturing an ongoing combination (rebind in settings).
            // Intercepts EVERYTHING as long as `shortcut-capturing` is set.
            if (root.shortcut-capturing != "") {
                if (event.text == Key.Escape) { root.shortcut-capturing = ""; return accept; }
                // Ignores lone modifiers: we're waiting for the actual key.
                if (event.text == Key.Control || event.text == Key.Shift
                        || event.text == Key.Alt || event.text == Key.Meta
                        || event.text == Key.AltGr) {
                    return accept;
                }
                root.shortcut-rebind(root.shortcut-capturing,
                    (event.modifiers.control ? "Ctrl+" : "")
                    + (event.modifiers.alt ? "Alt+" : "")
                    + (event.modifiers.shift ? "Shift+" : "")
                    + root.chord-key-name(event.text));
                return accept;
            }
            if (event.text == Key.Escape) {
                // A gesture in progress answers before anything else. Every
                // preview it draws keys on the state cleared here, so they all
                // go out at once and the release then finds nothing to do. The
                // pointer stays captured until the button comes up, which is
                // what every toolkit does.
                if (root.view-drag-active || root.drag-active || root.sidebar-item-drag-active
                        || root.file-drag-active || root.fav-drag-active
                        || root.sidebar-section-drag-active) {
                    root.cancel-mouse-gestures();
                    return accept;
                }
                if (root.file-drop-menu-open) { root.file-drop-menu-open = false; return accept; }
                if (root.split-menu-open) { root.split-menu-open = false; return accept; }
                if (root.tabbar-menu-open) { root.tabbar-menu-open = false; return accept; }
                if (root.url-menu-open) { root.url-menu-open = false; return accept; }
                if (root.trash-menu-open) { root.trash-menu-open = false; return accept; }
                if (root.drive-menu-open) { root.drive-menu-open = false; return accept; }
                if (root.columns-menu-open) { root.columns-menu-open = false; return accept; }
                // "Open with", favorites, and tab menus/popups that weren't
                // closed by Escape. Placed BEFORE settings: the "Custom
                // command" popup can be opened ON TOP OF the settings
                // → Escape closes the popup first, not the settings.
                if (root.ow-popup-open) { root.ow-popup-open = false; return accept; }
                if (root.ow-picker-open) { root.ow-picker-open = false; return accept; }
                // A submenu is peeled off first: Escape closes what it
                // opened, not everything at once. Same route as the left
                // arrow, so the keyboard lands back on the parent row.
                if (root.ctx-sub-open) { root.leave-submenu(); return accept; }
                if (root.fav-save-open) { root.fav-save-open = false; return accept; }
                if (root.fav-newc-open) { root.fav-newc-open = false; return accept; }
                if (root.fav-menu-open) { root.fav-menu-open = false; return accept; }
                if (root.tab-menu-open) { root.tab-menu-open = false; return accept; }
                if (root.tab-empty-menu-open) { root.tab-empty-menu-open = false; return accept; }
                if (root.paste-conflict-open) { root.paste-conflict-cancel(); root.paste-conflict-open = false; return accept; }
                if (root.ctx-menu-open) { root.ctx-close(); return accept; }
                // BEFORE the settings: this list sits on top of the panel, so
                // Escape gives back the panel first and closes it only on the
                // next press. Same order as the "unsaved changes" guard over
                // the workspaces overlay.
                if (root.orphans-open) { root.orphans-open = false; return accept; }
                if (root.settings-open) { root.settings-open = false; return accept; }
                // Escape first closes the guard (back to the list), not the
                // whole Workspaces overlay.
                if (root.ws-dirty-warn-open) { root.ws-dirty-warn-open = false; return accept; }
                if (root.workspaces-open) { root.workspaces-open = false; return accept; }
                if (root.rename-popup-open) { root.rename-popup-open = false; return accept; }
                if (root.create-popup-open) { root.create-popup-open = false; return accept; }
                if (root.delete-warning-open) { root.delete-warning-open = false; return accept; }
                if (root.open-many-open) { root.open-many-open = false; return accept; }
                if (root.fav-name-open) { root.fav-name-open = false; return accept; }
                // Escape first closes the active filter (by-name OR by-extension
                // type-ahead — shared via filter-clear bridge-side), otherwise
                // deselects.
                if (root.active-filter != "" || root.active-ext-filter-on) { root.filter-clear(); return accept; }
                root.deselect-all();
                return accept;
            }
            // Backspace: edits the active filter when there is one (by-name
            // OR by-extension type-ahead). Outside a filter, Backspace no longer has a
            // "parent" navigation effect — that now only goes through its
            // configurable shortcut (e.g. Alt+Up arrow).
            if (event.text == Key.Backspace && (root.active-filter != "" || root.active-ext-filter-on)) {
                root.filter-backspace();
                return accept;
            }
            // Arrow navigation of the view's context menu: the keyboard has to
            // be able to finish what the Menu key started. Placed before the
            // dispatch below, which an open overlay suspends in any case.
            if (root.ctx-menu-open && CtxNav.level > 0) {
                if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                    // Wrapping both ways: going up from nothing lands on the
                    // last entry, which is what a menu does elsewhere.
                    CtxNav.step(event.text == Key.DownArrow ? 1 : -1);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    // Only a row that carries a submenu answers; the others
                    // hear the broadcast and do nothing.
                    if (CtxNav.level == 1) { CtxNav.expand += 1; }
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (CtxNav.level == 2) { root.leave-submenu(); }
                    return accept;
                }
                if (event.text == Key.Return) {
                    CtxNav.activate += 1;
                    return accept;
                }
            }
            // Menu key: opens the context menu of the active view, like a
            // right-click. Handled natively rather than through the rebindable
            // catalogue — the key carries this one meaning on every desktop and
            // has no combination to describe — and placed ahead of the dispatch
            // below so no binding can mask it.
            if (event.text == Key.Menu) {
                if (!root.any-overlay-open) {
                    root.close-ctx-menus();
                    root.menu-key-serial += 1;
                }
                return accept;
            }
            // Configurable shortcuts: the bridge resolves the combination into
            // an action id, which we execute via `perform-action`. Suspended when an
            // overlay is open (it manages its own keys, e.g. rebind capture).
            if (!root.any-overlay-open) {
                let id: string = root.match-action(
                    root.chord-key-name(event.text),
                    event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                if (id != "") { root.perform-action(id); return accept; }
            }
            // PRINTABLE character outside an overlay → active view's type-ahead
            // filter. Special keys (>= U+F700) and controls (< U+0020) excluded;
            // Ctrl/Alt/Meta left to the shortcuts.
            if (!root.any-overlay-open
                    && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                    && event.text != "" && event.text >= " " && event.text < "\u{F700}") {
                root.filter-type(event.text);
                return accept;
            }
            return reject;
        }

        // Catch-all BELOW all content (declared first = bottom
        // of the z-order → steals no clicks from interactive elements above):
        // receives clicks that NOTHING consumes (window margins, rail /
        // sidebar backgrounds, empty strips) and closes the context menu.
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { Dismiss.serial += 1; }
            }
        }

        VerticalBox {
            // Reduced top margin so the panel does not start too low. The
            // other sides keep 10px for breathing room.
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 6px;

            // ===== Activity rail, "Places" sidebar, and content =====
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Always-visible vertical activity rail. Side panel toggle
                // at the top; system actions (Workspaces, Settings) at the bottom.
                ActivityRail {
                    left-panel: root.left-panel;
                    strings: root.strings;
                    shortcuts: root.menu-shortcuts;
                    toggle-places => { root.left-panel = root.left-panel == 1 ? 0 : 1; }
                    open-workspaces => { root.workspaces-open = true; }
                    open-settings => { root.settings-open = true; }
                }

                // ===== UNIFIED side column (Places + Favorites) =====
                // ALWAYS instantiated (width 0 when collapsed) to stay
                // referenceable: the drop path reads `sidebar-column.hover-container`,
                // which would be impossible with a conditional element. The column
                // keeps one grid instance per section and only varies their rank;
                // Favorites absorbs the available height up to its cap and scrolls.
                sidebar-column := SidebarColumn {
                    strings: root.strings;
                    left-panel: root.left-panel;
                    sidebar-width: root.sidebar-width;
                    sidebar-places-drives: root.sidebar-places-drives;
                    sidebar-places-shortcuts: root.sidebar-places-shortcuts;
                    sidebar-places-network: root.sidebar-places-network;
                    sidebar-places-trash: root.sidebar-places-trash;
                    fav-nodes: root.fav-nodes;
                    fav-selected-id: root.fav-selected-id;
                    fav-can-collapse: root.fav-can-collapse;
                    sidebar-drives-collapsed: root.sidebar-drives-collapsed;
                    sidebar-shortcuts-collapsed: root.sidebar-shortcuts-collapsed;
                    fav-section-collapsed: root.fav-section-collapsed;
                    sidebar-network-collapsed: root.sidebar-network-collapsed;
                    // The grid rows: the ranks implied by the bridge's order array.
                    section-rank-0: root.sidebar-section-rank(0);
                    section-rank-1: root.sidebar-section-rank(1);
                    section-rank-2: root.sidebar-section-rank(2);
                    section-rank-3: root.sidebar-section-rank(3);
                    section-source-rank: root.sidebar-section-rank(root.sidebar-section-drag-source);
                    sidebar-section-drag-active: root.sidebar-section-drag-active;
                    sidebar-section-drag-source: root.sidebar-section-drag-source;
                    sidebar-section-drag-target: root.sidebar-section-drag-target;
                    sidebar-section-drag-preview-y: root.sidebar-section-drag-preview-y;
                    sidebar-item-drag-active: root.sidebar-item-drag-active;
                    fav-drag-active: root.fav-drag-active;
                    fav-drag-target-index: root.fav-drag-target-index;
                    fav-drag-zone: root.fav-drag-zone;
                    drag-active: root.drag-active;
                    drag-abs-x: root.drag-abs-x;
                    drag-abs-y: root.drag-abs-y;
                    file-drag-active: root.file-drag-active;
                    file-drag-abs-x: root.file-drag-abs-x;
                    file-drag-abs-y: root.file-drag-abs-y;
                    fav-menu-open <=> root.fav-menu-open;
                    fav-menu-x <=> root.fav-menu-x;
                    fav-menu-y <=> root.fav-menu-y;
                    fav-menu-id <=> root.fav-menu-id;
                    fav-menu-name <=> root.fav-menu-name;
                    fav-menu-container <=> root.fav-menu-container;
                    fav-menu-confirm-delete <=> root.fav-menu-confirm-delete;
                    refresh-sidebar-section-drag-geometry => { root.refresh-sidebar-section-drag-geometry(); }
                    toggle-sidebar-section(section) => { root.toggle-sidebar-section(section); }
                    start-sidebar-section-drag(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                    update-sidebar-section-drag(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                    drop-sidebar-section-drag(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                    begin-sidebar-item-drag(x, y, can-split) => { root.begin-sidebar-item-drag(x, y, can-split); }
                    update-sidebar-item-drag(x, y) => { root.update-sidebar-item-drag(x, y); }
                    finish-sidebar-item-drag(source, kind, x, y) => {
                        return root.finish-sidebar-item-drag(source, kind, x, y);
                    }
                    cancel-sidebar-item-drag => { root.cancel-sidebar-item-drag(); }
                    sidebar-place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                    place-open-new-tab(path, kind) => { root.place-open-new-tab(path, kind); }
                    open-sidebar-place-context(path, kind, removable, hotplug, device, x, y) => {
                        root.open-sidebar-place-context(path, kind, removable, hotplug, device, x, y);
                    }
                    close-ctx-menus => { root.close-ctx-menus(); }
                    open-fav-name(rename, target, value) => { root.open-fav-name(rename, target, value); }
                    fav-row-activate(id) => { root.fav-row-activate(id); }
                    fav-row-middle(id) => { root.fav-row-middle(id); }
                    fav-drag-move(ri, cy, rt) => { root.fav-drag-move(ri, cy, rt); }
                    fav-drag-drop(ri, cy, rt, commit-tree) => { root.fav-drag-drop(ri, cy, rt, commit-tree); }
                    fav-collapse-all => { root.fav-collapse-all(); }
                    fav-expand-all => { root.fav-expand-all(); }
                }

                // Left panel resize grip (horizontal drag).
                // Absolute delta since the start of the drag → no drift.
                if root.left-panel != 0 : Rectangle {
                    width: 6px;
                    property <length> start-w;
                    property <length> start-x;
                    background: sb-resize.has-hover || sb-resize.pressed
                        ? Theme.accent-background.with-alpha(0.45)
                        : transparent;
                    sb-resize := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.left) {
                                Dismiss.serial += 1;
                                parent.start-w = root.sidebar-width;
                                parent.start-x = self.absolute-position.x + self.mouse-x;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = clamp(
                                    parent.start-w
                                        + (self.absolute-position.x + self.mouse-x - parent.start-x),
                                    150px, 440px);
                            }
                        }
                    }
                }

                // ===== Panels container (flattened rendering of the tree) =====
                // Rectangle (NOT a layout): each panel is positioned in
                // **absolute** terms from its fractional geometry (fx/fy/fw/fh x container
                // size), splitters are overlays on the seams.
                // This bypasses Slint's layout engine (a source of
                // "Recursion detected" cycles on repeaters).
                panels-container := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    // Groove: slightly recessed background so the tiles
                    // (panels) stand out in the gap that separates them.
                    background: Tokens.trough;
                    for panel[idx] in root.panels : PanelComponent {
                        // Rounded to a WHOLE pixel: without this, a
                        // fractional position (fraction x width) places the panel on a
                        // half-pixel → blurry text/icons (and inconsistent from one
                        // panel to another depending on whether the fraction lands exactly).
                        // + uniform `panel-gap` inset on all 4 sides → a gap of
                        // 2xpanel-gap between neighbors, 1x against the edges. The seam
                        // (hence the splitter) stays centered on the same position.
                        //
                        // Read from the PARALLEL model `panel-boxes` (never from
                        // `panel`) → moving a tile does not invalidate
                        // `view.rendered-rows`. Should the two models ever be out
                        // of step for a frame, a full-size tile is a kinder
                        // failure than an invisible one.
                        property <PanelBox> box: idx < root.panel-boxes.length
                            ? root.panel-boxes[idx]
                            : { fx: 0, fy: 0, fw: 1, fh: 1 };
                        x: round(panels-container.width * self.box.fx / 1px) * 1px + Tokens.panel-gap;
                        y: round(panels-container.height * self.box.fy / 1px) * 1px + Tokens.panel-gap;
                        width: round(panels-container.width * self.box.fw / 1px) * 1px - 2 * Tokens.panel-gap;
                        height: round(panels-container.height * self.box.fh / 1px) * 1px - 2 * Tokens.panel-gap;
                        // Only the POSITION travels. Animating the size would change
                        // this view's height on every frame, and a height change
                        // costs a round trip to the bridge — render window and
                        // thumbnail priority recomputed, per frame and per view.
                        // The tiles therefore take their new size at once and slide
                        // to their new place.
                        //
                        // 180ms sits between the 110ms of a state lighting up and
                        // the 200ms of a dissolve: long enough for the eye to
                        // follow a tile across the window, short enough never to
                        // delay a second gesture. `ease-in-out` because a tile
                        // LEAVES a place as much as it arrives at one — `ease-out`
                        // is the curve of an arrival alone.
                        animate x, y {
                            duration: root.view-swap-flying ? 180ms : 0ms;
                            easing: ease-in-out;
                        }
                        view-swap-flying: root.view-swap-flying
                            && (root.swap-flight-a == idx || root.swap-flight-b == idx);
                        view: panel;
                        // Dragging a VIEW. The claim on the target follows the
                        // idiom used for the separator outline: only the view that
                        // claimed it may drop it, since leaving one and entering
                        // the next fires both handlers in an order nothing
                        // guarantees.
                        view-drag-active: root.view-drag-active;
                        view-drag-abs-x: root.view-drag-abs-x;
                        view-drag-abs-y: root.view-drag-abs-y;
                        view-drag-is-source: root.view-drag-source == idx;
                        view-drag-is-target: root.view-drag-target == idx;
                        view-drag-armed: root.view-drag-target >= 0;
                        view-drag-leaving: root.view-drag-outside
                            && root.view-drag-source == idx;
                        changed view-drag-over => {
                            if (self.view-drag-over) {
                                root.view-drag-target = idx;
                            } else if (root.view-drag-target == idx) {
                                root.view-drag-target = -1;
                            }
                        }
                        view-drag-progress(ax, ay) => {
                            if (!root.view-drag-cancelled) {
                                root.view-drag-active = true;
                                root.view-drag-source = idx;
                                root.view-drag-abs-x = ax;
                                root.view-drag-abs-y = ay;
                            }
                        }
                        view-drag-completed(ax, ay) => {
                            // Read before clearing: every preview hangs off these,
                            // so they must survive long enough to be consulted.
                            if (root.view-drag-target >= 0 && !root.view-drag-cancelled) {
                                root.swap-flight-a = idx;
                                root.swap-flight-b = root.view-drag-target;
                                root.view-swap-flying = true;
                                root.views-swapped(idx, root.view-drag-target);
                            } else if (!root.view-drag-cancelled) {
                                // No view under the cursor. The bridge checks
                                // whether the release truly landed outside the
                                // window before detaching anything.
                                root.view-torn-off(idx, ax, ay);
                            }
                            root.view-drag-cancelled = false;
                            root.view-drag-active = false;
                            root.view-drag-source = -1;
                            root.view-drag-target = -1;
                        }
                        // Footer drawn from the PARALLEL model `panel-footers`
                        // (never from `panel`) → its update does not invalidate
                        // `view.rendered-rows`.
                        footer-text: idx < root.panel-footers.length ? root.panel-footers[idx] : "";
                        active: idx == root.active-panel-idx;
                        can-close: root.panels.length > 1;
                        strings: root.strings;
                        drag-active: root.drag-active || root.sidebar-item-drag-active;
                        drag-panel-zones: root.drag-active
                            || (root.sidebar-item-drag-active
                                && root.sidebar-item-split-capable);
                        drag-panel-split-edges: root.drag-active || root.can-add-panel;
                        drag-abs-x: root.drag-abs-x;
                        drag-abs-y: root.drag-abs-y;
                        tab-tooltip-enabled: root.tab-tooltip-enabled;
                        is-drag-source: root.drag-active && idx == root.drag-source-panel;
                        // The panel under the cursor claims the drop target.
                        changed drag-zone => {
                            if (self.drag-zone > 0) {
                                root.drag-target-panel = idx;
                                root.drag-target-zone = self.drag-zone;
                            } else if (root.drag-target-panel == idx) {
                                root.drag-target-panel = -1;
                                root.drag-target-zone = 0;
                            }
                        }
                        // File drag'n'drop between views ---
                        file-drag-active: root.file-drag-active;
                        file-drag-abs-x: root.file-drag-abs-x;
                        file-drag-abs-y: root.file-drag-abs-y;
                        is-file-drag-source: idx == root.file-drag-source-panel;
                        changed file-drag-over => {
                            if (self.file-drag-over) {
                                root.claim-file-drag-target(idx, self.drag-target-row,
                                    self.drag-folder-row >= 0, self.drag-target-exec);
                            } else {
                                root.clear-file-drag-target(idx);
                            }
                        }
                        // The hovered row changes → publishes folder AND executable to
                        // the root to keep feedback and action aligned.
                        changed drag-target-row => {
                            if (root.file-drag-target-panel == idx) {
                                root.claim-file-drag-target(idx, self.drag-target-row,
                                    self.drag-folder-row >= 0, self.drag-target-exec);
                            }
                        }
                        changed drag-target-exec => {
                            if (root.file-drag-target-panel == idx) {
                                root.claim-file-drag-target(idx, self.drag-target-row,
                                    self.drag-folder-row >= 0, self.drag-target-exec);
                            }
                        }
                        changed drag-folder-row => {
                            if (root.file-drag-target-panel == idx) {
                                root.claim-file-drag-target(idx, self.drag-target-row,
                                    self.drag-folder-row >= 0, self.drag-target-exec);
                            }
                        }
                        file-drag-started(ri, x, y) => {
                            root.file-drag-source-panel = idx;
                            root.file-drag-abs-x = x;
                            root.file-drag-abs-y = y;
                            root.file-drag-active = true;
                            root.file-drag-copy = root.ctrl-down;
                            root.native-drag-armed = false;   // re-arms the native drag
                            root.file-drag-begin(idx, ri);
                            // `file-drag-begin` just guaranteed the selection of the
                            // grabbed row: now recompute the target/source conflict.
                            root.refresh-file-drag-target-invalid();
                        }
                        file-drag-progress(x, y) => {
                            root.file-drag-abs-x = x;
                            root.file-drag-abs-y = y;
                            root.file-drag-copy = root.ctrl-down;
                            // The cursor LEAVES the window → switches to a native OLE drag
                            // (once) for external apps. We end the
                            // Slint drag (releases ghost + state) before the modal loop.
                            if (root.file-drag-active && !root.native-drag-armed
                                    && (x < 0px || y < 0px || x > root.width || y > root.height)) {
                                root.native-drag-armed = true;
                                root.file-drag-active = false;
                                root.file-drag-target-panel = -1;
                                root.file-drag-target-row = -1;
                                root.file-drag-target-folder = false;
                                root.file-drag-target-exec = false;
                                root.file-drag-target-invalid = false;
                                root.start-native-drag(root.file-drag-source-panel);
                            }
                        }
                        file-drag-dropped(x, y) => {
                            root.file-drag-abs-x = x;
                            root.file-drag-abs-y = y;
                            // Drop on a FAVORITES folder: TAKES PRIORITY over the
                            // cross-view drop. `fav-hover-container` is read pull-based
                            // BEFORE cutting the drag (file-drag-abs position already up
                            // to date above); non-empty = hovered container → the
                            // selection is saved there as a favorite (no file operation).
                            if (root.fav-hover-container != "") {
                                root.close-ctx-menus();
                                root.file-to-favorite(root.file-drag-source-panel, root.fav-hover-container);
                            } else if (root.fav-hover-panel) {
                                // "No favorites" area or dead zone of the favorites
                                // section → adds AT THE ROOT (container "").
                                root.close-ctx-menus();
                                root.file-to-favorite(root.file-drag-source-panel, "");
                            } else if (!root.file-drag-target-invalid
                                    && root.file-drag-target-panel >= 0
                                    && (root.file-drag-target-folder
                                        || root.file-drag-target-exec
                                        || root.file-drag-target-panel != root.file-drag-source-panel)) {
                                root.close-ctx-menus();
                                root.file-drop-src-panel = root.file-drag-source-panel;
                                root.file-drop-target-panel = root.file-drag-target-panel;
                                root.file-drop-target-row = root.file-drag-target-row;
                                // Drop ONTO an executable (.cmd/.bat/.exe…) → we
                                // LAUNCH it with the dropped files as arguments (dev
                                // habit of "dragging a .txt onto a .cmd"). The bridge
                                // returns true if it launched; otherwise normal Copy/… menu.
                                if (root.file-drop-onto-exec()) {
                                    // launched — nothing else to do
                                } else if (root.file-drag-copy) {
                                    root.file-drop-action(1); // 1 = copy
                                } else {
                                    root.file-drop-menu-x = x;
                                    root.file-drop-menu-y = y;
                                    root.file-drop-menu-open = true;
                                }
                            }
                            root.file-drag-active = false;
                            root.file-drag-target-invalid = false;
                        }
                        column-resized(id, w) => { root.panel-column-resized(idx, id, w); }
                        column-toggle(id, vis) => { root.column-toggle(idx, id, vis); }
                        column-moved(id, target) => { root.column-moved(idx, id, target); }
                        ext-filter-toggle => { root.ext-filter-toggle(idx); }
                        tabs-scrolled(vx) => { root.panel-tabs-scrolled(idx, vx); }
                        scroll-target(ti, fwd, vx, vw) => { return root.panel-scroll-target(idx, ti, fwd, vx, vw); }
                        filter-text: root.active-filter;
                        filter-clear => { root.filter-clear(); }
                        rows-viewport-changed(top, height) => {
                            root.panel-viewport-changed(idx, top, height);
                        }
                        row-at-content-y(y) => { return root.panel-row-at-content-y(idx, y); }
                        open-columns-menu(mx, my) => {
                            root.close-ctx-menus();
                            root.columns-menu-panel = idx;
                            root.columns-menu-x = mx;
                            root.columns-menu-y = my;
                            root.columns-menu-open = true;
                        }
                        open-split-menu(mx, my) => {
                            root.close-ctx-menus();
                            root.split-menu-x = mx;
                            root.split-menu-y = my;
                            root.split-menu-open = true;
                        }
                        open-tabbar-menu(mx, my) => {
                            root.close-ctx-menus();
                            root.tabbar-menu-panel = idx;
                            root.tabbar-menu-mode = panel.tab-bar-mode;
                            root.tabbar-menu-x = mx;
                            root.tabbar-menu-y = my;
                            root.tabbar-menu-open = true;
                        }
                        vbar-resized(w) => { root.panel-vbar-resized(idx, w); }
                        set-view-mode(mode) => { root.set-view-mode(idx, mode); }
                        cycle-view-mode => { root.cycle-view-mode(idx); }
                        open-view-menu(mx, my) => {
                            root.close-ctx-menus();
                            root.view-menu-panel = idx;
                            root.view-menu-mode = panel.view-mode;
                            root.view-menu-x = mx;
                            root.view-menu-y = my;
                            root.view-menu-open = true;
                        }
                        toggle-subfolder-contents => { root.toggle-subfolder-contents(idx); }
                        toggle-section(key) => { root.toggle-section(idx, key); }
                        rows-area-width(w) => { root.rows-area-width(idx, w); }
                        zoom-step(d, top, height, pointer-y) => {
                            return root.zoom-view(idx, d, top, height, pointer-y);
                        }
                        keyboard-interaction-gen: root.keyboard-interaction-gen;
                        address-focus-gen: root.address-focus-gen;
                        overlay-open: root.any-overlay-open;
                        toggle-show-hidden => { root.toggle-show-hidden(idx); }
                        open-url-menu(mx, my) => {
                            root.close-ctx-menus();
                            root.url-menu-x = mx;
                            root.url-menu-y = my;
                            root.url-menu-open = true;
                        }
                        close-ctx-menu => { root.close-ctx-menus(); }
                        url-edit-text <=> root.url-edit-text;
                        url-menu-open: root.url-menu-open;
                        url-copy-serial: root.url-copy-serial;
                        url-paste-serial: root.url-paste-serial;

                        activate => { root.panel-clicked(idx); }
                        go-back => { root.go-back(); }
                        go-forward => { root.go-forward(); }
                        go-parent => { root.go-parent(); }
                        go-home => { root.go-home(); }
                        refresh => { root.refresh(); }
                        sort-clicked(c) => { root.sort-clicked(c); }
                        row-activated(i) => { root.row-activated(i); }
                        row-clicked(i) => { return root.row-clicked(i); }
                        row-ctrl-clicked(i) => { root.row-ctrl-clicked(i); }
                        row-shift-clicked(i) => { root.row-shift-clicked(i); }
                        rename-selected => { root.action-rename(); }
                        right-clicked(i, x, y) => { root.close-ctx-menus(); root.row-right-clicked(i, x, y); }
                        menu-key-serial: root.menu-key-serial;
                        keyboard-context-row() => { return root.keyboard-context-row(); }
                        select-all => { root.select-all(); }
                        deselect-all => { root.deselect-all(); }
                        rubber-band-begin(m) => { root.rubber-band-begin(m); }
                        rubber-band-update(a, b, c, d) => { root.rubber-band-update(a, b, c, d); }
                        tab-new => { root.tab-new(); }
                        tab-clicked(i) => { root.tab-clicked(i); }
                        tab-closed(i) => { root.tab-closed(i); }
                        tab-context(ti, x, y) => {
                            root.close-ctx-menus();
                            root.tab-menu-panel = idx;
                            root.tab-menu-tab = ti;
                            root.tab-menu-x = x;
                            root.tab-menu-y = y;
                            root.tab-menu-open = true;
                        }
                        tab-bar-context(x, y) => {
                            root.close-ctx-menus();
                            root.tab-empty-menu-panel = idx;
                            root.tab-empty-menu-x = x;
                            root.tab-empty-menu-y = y;
                            root.tab-empty-menu-open = true;
                        }
                        tab-drag-completed(i, ti, ax, ay) => {
                            // Drop on a FAVORITES folder: takes priority over
                            // the normal drop (panel / tear-off / transfer), which is
                            // thus left 100% INTACT. `fav-hover-container` is read
                            // PULL-BASED BEFORE cutting the drag (the binding resets
                            // as soon as `drag-active = false`); non-empty = hovered container.
                            if (root.fav-hover-container != "") {
                                // `idx` = drag's SOURCE panel (may be non-active).
                                root.tab-to-favorite(idx, i, root.fav-hover-container);
                                root.drag-active = false;
                                root.drag-target-gap = -1;
                                root.drag-target-gap-panel = -1;
                            } else if (root.fav-hover-panel) {
                                // Empty / dead zone of the favorites → root ("").
                                root.tab-to-favorite(idx, i, "");
                                root.drag-active = false;
                                root.drag-target-gap = -1;
                                root.drag-target-gap-panel = -1;
                            } else {
                                root.drag-active = false;
                                root.tab-drag-completed(idx, i, ti, ax, ay);
                            }
                            root.drag-target-panel = -1;
                            root.drag-target-zone = 0;
                            root.drag-source-panel = -1;
                        }
                        tab-drag-progress(i, ax, ay) => {
                            // Drag start → purges the previous drag's gap.
                            if (!root.drag-active) {
                                root.drag-target-gap = -1;
                                root.drag-target-gap-panel = -1;
                            }
                            root.drag-active = true;
                            root.drag-abs-x = ax;
                            root.drag-abs-y = ay;
                            root.drag-source-panel = idx;
                            root.tab-drag-progress(i, ax, ay);
                        }
                        tab-gap-claimed(g) => {
                            root.drag-target-gap = g;
                            root.drag-target-gap-panel = idx;
                        }
                        tab-gap-cleared => {
                            if (root.drag-target-gap-panel == idx) {
                                root.drag-target-gap = -1;
                                root.drag-target-gap-panel = -1;
                            }
                        }
                        request-focus => { key-scope.focus(); }
                        navigate-to(p) => { root.navigate-to(p); }
                        empty-right-clicked(x, y) => { root.close-ctx-menus(); root.empty-right-clicked(x, y); }
                        close-panel => { root.panel-closed(idx); }
                    }

                    // Which views a double-click on the hovered separator would
                    // move. Two identical bars can govern very different regions —
                    // the outer one commands the whole layout — and nothing on
                    // screen says so, hence this outline BEFORE the click rather
                    // than an animation after it. Drawn only where the answer is
                    // not already obvious: a pair of views needs no help. It bears
                    // no TouchArea, so it never stands between the pointer and the
                    // panels underneath.
                    if root.hover-splitter >= 0
                        && root.splitters[root.hover-splitter].governs > 2 : Rectangle {
                        property <SplitterView> sp: root.splitters[root.hover-splitter];
                        x: panels-container.width * self.sp.area-x;
                        y: panels-container.height * self.sp.area-y;
                        width: panels-container.width * self.sp.area-w;
                        height: panels-container.height * self.sp.area-h;
                        background: transparent;
                        border-width: 1px;
                        border-color: Theme.accent-background;
                        border-radius: Tokens.radius-panel;
                    }

                    // Separators (resize grips) overlaid on the seams.
                    for sp[i] in root.splitters : PanelSplitterAbs {
                        vertical: sp.vertical;
                        equalize => { root.equalize-views(sp.idx); }
                        // Only the separator that claimed the outline may drop it:
                        // leaving one and entering the next fires both handlers in
                        // an order nothing guarantees.
                        changed outlined => {
                            if (self.outlined) {
                                root.hover-splitter = i;
                            } else if (root.hover-splitter == i) {
                                root.hover-splitter = -1;
                            }
                        }
                        x: sp.vertical
                            ? round(panels-container.width * sp.pos / 1px) * 1px - self.width / 2
                            : round(panels-container.width * sp.cross-start / 1px) * 1px;
                        y: sp.vertical
                            ? round(panels-container.height * sp.cross-start / 1px) * 1px
                            : round(panels-container.height * sp.pos / 1px) * 1px - self.height / 2;
                        width: sp.vertical ? 8px : round(panels-container.width * sp.cross-len / 1px) * 1px;
                        height: sp.vertical ? round(panels-container.height * sp.cross-len / 1px) * 1px : 8px;
                        dragged(ax, ay) => {
                            root.splitter-resized(sp.idx,
                                sp.vertical
                                    ? (ax - panels-container.absolute-position.x) / panels-container.width
                                    : (ay - panels-container.absolute-position.y) / panels-container.height);
                        }
                    }
                }
            } // closes the HorizontalLayout (sidebar + panels)
        }

        // ===== File & panel context menus (ctx, split, view, tab-bar, URL, trash, drive) =====
        // Extracted to overlays/menus.slint; the forwards below are the whole
        // contract with it (state in, actions back out).
        OverlayMenus {
            action-copy() => { root.action-copy(); }
            action-copy-name() => { root.action-copy-name(); }
            action-copy-path() => { root.action-copy-path(); }
            action-create-link() => { root.action-create-link(); }
            action-cut() => { root.action-cut(); }
            action-delete() => { root.action-delete(); }
            action-duplicate() => { root.action-duplicate(); }
            action-open() => { root.action-open(); }
            action-open-admin() => { root.action-open-admin(); }
            action-open-new-tab() => { root.action-open-new-tab(); }
            action-open-parent() => { root.action-open-parent(); }
            action-open-terminal() => { root.action-open-terminal(); }
            action-paste() => { root.action-paste(); }
            action-properties() => { root.action-properties(); }
            action-rename() => { root.action-rename(); }
            ctx-close() => { root.ctx-close(); }
            ctx-custom-entries: root.ctx-custom-entries;
            ctx-custom-run(id) => { root.ctx-custom-run(id); }
            ctx-menu-open: root.ctx-menu-open;
            ctx-menu-x: root.ctx-menu-x;
            ctx-menu-y: root.ctx-menu-y;
            ctx-on-empty: root.ctx-on-empty;
            ctx-selection-has-dir: root.ctx-selection-has-dir;
            ctx-selection-is-dir: root.ctx-selection-is-dir;
            ctx-selection-is-file: root.ctx-selection-is-file;
            ctx-selection-single: root.ctx-selection-single;
            ctx-shell-entries: root.ctx-shell-entries;
            ctx-shell-run(command) => { root.ctx-shell-run(command); }
            ctx-shell-sub-for <=> root.ctx-shell-sub-for;
            ctx-shell-sub-hover(sub) => { root.ctx-shell-sub-hover(sub); }
            ctx-shell-sub-open <=> root.ctx-shell-sub-open;
            ctx-shell-sub-parent-hover <=> root.ctx-shell-sub-parent-hover;
            ctx-shell-sub-x <=> root.ctx-shell-sub-x;
            ctx-shell-sub-y <=> root.ctx-shell-sub-y;
            fav-add-selection() => { root.fav-add-selection(); }
            mark-menu-open <=> root.mark-menu-open;
            mark-menu-x <=> root.mark-menu-x;
            mark-menu-y <=> root.mark-menu-y;
            mark-parent-hover <=> root.mark-parent-hover;
