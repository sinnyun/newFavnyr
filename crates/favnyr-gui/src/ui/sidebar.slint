// Left side: activity rail, sidebar sections, favorites panel.

import { FavNode, MenuShortcuts, SidebarPlace, Strings } from "structs.slint";
import { Dismiss, Theme, Tip, Tokens } from "theme.slint";
import { DragEdgeScroller } from "widgets/tabs.slint";
import { DriveGauge } from "progress.slint";
import { ScrollView } from "std-widgets.slint";

// A clickable sidebar entry (icon + label).
export component SidebarItem inherits Rectangle {
    callback clicked();
    callback middle-clicked();                 // open in a new tab
    callback right-clicked(length, length);   // absolute position
    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-dropped(length, length);
    in property <bool> drag-active: false;
    in property <bool> draggable: true;
    in property <string> label;
    in property <int> kind;   // 0 folder · 1 home · 2 drive · 3 trash · 4 network · 5 phone · 6 unmounted volume · 7 locked volume
    in property <int> space-level: -1;   // -1 = unmeasurable → no gauge at all
    in property <float> space-used-ratio;
    in property <string> space-text;
    in property <string> space-text-short;
    in property <string> space-hint;
    /// Width of the whole side panel, handed down rather than measured.
    ///
    /// The gauge sizes itself to its text, so it FEEDS the row's layout. Were
    /// its content chosen from the row's resolved width, that width would
    /// depend on the gauge and the gauge on the width — a binding loop the
    /// compiler rejects outright. The panel width is set by the user and
    /// depends on nothing below it, which breaks the cycle at the source.
    in property <length> panel-width;
    property <length> down-abs-x;
    property <length> down-abs-y;
    property <bool> dragging: false;
    property <bool> suppress-click: false;
    changed drag-active => {
        if (!root.drag-active) { root.dragging = false; }
    }

    // The row trades detail for room as the panel narrows: full figures, then
    // free space alone — the bar already carries the ratio, so the total is
    // the one redundant part — then the bare gauge, which still shows the
    // proportion and the warning colour.
    //
    // Fixed costs per row: 12px of section padding, then 8 padding + 16 icon +
    // 9 + 9 spacing + 8 padding = 50px of row chrome. The thresholds keep at
    // least 64px for the drive's name, because a row that says how full a disk
    // is but no longer says WHICH disk has traded away the wrong thing.
    property <int> space-tier: root.panel-width >= 185px ? 2
        : root.panel-width >= 170px ? 1
        : 0;

    // Below the narrowest tier the gauge is dropped entirely rather than shown
    // bare. A capsule with no figures still costs 28px of a row that has none
    // to spare, and it says only what the row could no longer name — the
    // drive's own label matters more than how full it is.
    property <bool> show-gauge: root.space-level >= 0 && root.space-tier > 0;
    // An unmounted volume shows its size in place of a gauge it cannot have.
    property <bool> show-size: (root.kind == 6 || root.kind == 7)
        && root.space-text-short != ""
        && root.space-tier > 0;

    height: 30px;
    border-radius: Tokens.radius-row;
    opacity: root.dragging ? 0.45 : 1.0;
    // Both areas count: the gauge's sits on top of the row's, so over the
    // gauge only IT reports hover — without this the row would lose its
    // highlight exactly where the pointer is.
    background: (touch.has-hover || gauge-hover.has-hover)
        ? Theme.alternate-background
        : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        // Full-height icon slot → vertically centered image (otherwise the
        // layout pins the 16px image to the top of the row).
        Rectangle {
            width: 16px;
            height: parent.height;
            Image {
                width: 16px;
                height: 16px;
                x: 0;
                y: (parent.height - self.height) / 2;
                colorize: (root.kind == 2 || root.kind == 4 || root.kind == 5)
                    ? Theme.accent-background
                    // A volume that is not mounted keeps the drive shape and
                    // loses the accent: present, but not reachable yet.
                    : (root.kind == 6 || root.kind == 7)
                        ? Theme.foreground.with-alpha(0.45)
                    : Theme.foreground.with-alpha(0.7);
                source: root.kind == 1 ? @image-url("../../assets/icons/home.svg")
                    : root.kind == 2 ? @image-url("../../assets/icons/drive.svg")
                    : root.kind == 3 ? @image-url("../../assets/icons/trash.svg")
                    : root.kind == 4 ? @image-url("../../assets/icons/network.svg")
                    : root.kind == 5 ? @image-url("../../assets/icons/phone.svg")
                    : root.kind == 6 ? @image-url("../../assets/icons/drive.svg")
                    // An encrypted volume shows what stands between the user
                    // and it, rather than a drive it cannot open.
                    : root.kind == 7 ? @image-url("../../assets/icons/lock.svg")
                    : @image-url("../../assets/icons/folder.svg");
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: (root.kind == 6 || root.kind == 7)
                ? Theme.foreground.with-alpha(0.6)
                : Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Capacity gauge, local volumes only and only when the size could
        // actually be read. Declared inside the SAME layout so it costs no
        // extra height.
        //
        // ALWAYS instantiated, collapsed to nothing when there is no capacity
        // to show, rather than wrapped in an `if`: a conditional element is
        // out of scope for the row, which needs its position to tell whether
        // the pointer is over it. Zero width and hidden is the same
        // "instantiate and collapse" idiom the Favorites tree uses.
        gauge-slot := Rectangle {
            width: root.show-gauge ? gauge.width : 0px;
            visible: root.show-gauge;
            // Full-height slot → vertically centred gauge, same reason as the
            // icon above: the layout would otherwise pin it to the top.
            height: parent.height;
            gauge := DriveGauge {
                y: (parent.height - self.height) / 2;
                used-ratio: root.space-used-ratio;
                level: root.space-level;
                avail-width: max(28px, root.panel-width - 126px);
                label: root.space-tier == 2 ? root.space-text : root.space-text-short;
            }
        }
        // Size of a volume that is not mounted. No gauge is possible — nothing
        // has opened its filesystem to measure occupancy — but the figure still
        // says which disk this is. Same instantiate-and-collapse idiom as the
        // gauge above, and it hides on a narrow panel for the same reason.
        size-slot := Rectangle {
            width: root.show-size ? size-text.width + 12px : 0px;
            visible: root.show-size;
            height: parent.height;
            size-text := Text {
                x: 6px;
                y: (parent.height - self.height) / 2;
                text: root.space-text-short;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.5);
            }
        }
    }
    // Button handling for the row, shared by the two touch areas below so that
    // clicking the gauge behaves exactly like clicking anywhere else on the
    // row — one implementation, not a copy that can drift.
    function dispatch-pointer(
        ev: PointerEvent, abs-x: length, abs-y: length, inside: bool
    ) {
        // LEFT click on the sidebar closes menus; right-click (drive/
        // trash menu) does not bump, so it can teleport the menu.
        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
            Dismiss.serial += 1;
            root.down-abs-x = abs-x;
            root.down-abs-y = abs-y;
            root.dragging = false;
            root.suppress-click = false;
        }
        if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
            if (root.dragging) {
                root.drag-dropped(abs-x, abs-y);
            } else if (inside && !root.suppress-click) {
                root.clicked();
            }
            root.dragging = false;
            root.suppress-click = false;
        }
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
            root.right-clicked(abs-x, abs-y);
        }
        // Middle-click opens the target in a new tab, unchanged by the drag.
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle) {
            root.middle-clicked();
        }
    }
    function dispatch-move(pressed: bool, abs-x: length, abs-y: length) {
        if (!pressed || !root.draggable) { return; }
        if (!root.dragging
                && (abs(abs-x - root.down-abs-x) > 6px
                    || abs(abs-y - root.down-abs-y) > 6px)) {
            root.dragging = true;
            root.suppress-click = true;
            Tip.text = "";
            root.drag-started(abs-x, abs-y);
        }
        if (root.dragging) {
            root.drag-moved(abs-x, abs-y);
        }
    }

    touch := TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(ev) => {
            root.dispatch-pointer(ev,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y,
                self.mouse-x >= 0px && self.mouse-x <= self.width
                    && self.mouse-y >= 0px && self.mouse-y <= self.height);
        }
        moved => {
            root.dispatch-move(self.pressed,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
    }

    // Hover target for the gauge, and the gauge only.
    //
    // Declared AFTER `touch` so it sits ON TOP of it and is the one the
    // pointer reaches — the same front-to-back rule the Favorites tree relies
    // on. It hands every button straight back to the row, so nothing is lost
    // by covering it.
    //
    // This replaces an earlier attempt that compared the row's `mouse-x`
    // against the gauge's position. That looked cheaper but was unreliable:
    // entering the gauge did not raise the hint, moving on to another row did,
    // and leaving the gauge sideways left it up — the pointer coordinate is
    // simply not dependable at the moment hovering begins. A real touch area
    // has one honest state, `has-hover`, and Slint maintains it. Zero width
    // when there is no gauge, so it cannot intercept anything.
    gauge-hover := TouchArea {
        x: gauge-slot.x;
        y: 0;
        width: root.show-gauge ? gauge-slot.width : 0px;
        height: parent.height;
        mouse-cursor: pointer;
        // Names each figure, which the gauge alone cannot: "26.0 / 57.3 GB" does
        // not say which number is which. `absolute-position` is read HERE, in
        // an event handler where the layout has settled — reading it from a
        // property derived from the geometry aborted the whole window with
        // "Recursion detected", the row being inside a ScrollView.
        changed has-hover => {
            if (self.has-hover && root.space-hint != "") {
                Tip.text = root.space-hint;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + self.height + 4px;
            } else if (Tip.text == root.space-hint) {
                Tip.text = "";
            }
        }
        pointer-event(ev) => {
            root.dispatch-pointer(ev,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y,
                self.mouse-x >= 0px && self.mouse-x <= self.width
                    && self.mouse-y >= 0px && self.mouse-y <= self.height);
        }
        moved => {
            root.dispatch-move(self.pressed,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
    }
}


// Small icon button reserved for the Favorites header actions. Declared before
// the shared header so its deeper TouchAreas keep priority
// over the drag surface placed behind them.
export component SidebarHeaderAction inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.alternate-background : transparent;
    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.6);
    }
    touch := TouchArea {
        clicked => { Dismiss.serial += 1; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tip.text = root.tooltip;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + self.height + 4px;
            } else if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}


// Explicitly centers a 24x24 action within the 30px header without
// modifying `SidebarHeaderAction`, also used in the Open With settings.
export component SidebarHeaderActionSlot inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    width: 24px;
    height: 30px;
    SidebarHeaderAction {
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        tooltip: root.tooltip;
        clicked => { root.clicked(); }
    }
}


// Header shared by the four reorderable sections. A release before the
// 6px threshold keeps the legacy collapse click; past this threshold, the gesture
// becomes exclusively a drag and never changes the chevron's state.
export component SidebarSectionHeader inherits Rectangle {
    callback toggled();
    callback drag-started(int, length, length); // section, absolute x/y
    callback drag-moved(int, length, length);
    callback drag-dropped(int, length, length);
    callback new-container();
    callback collapse-all();
    in property <int> section-code;
    in property <string> label;
    in property <bool> collapsed;
    in property <bool> favorite-actions: false;
    in property <bool> can-collapse: false;
    in property <string> new-container-tooltip;
    in property <string> collapse-tooltip;
    in property <bool> reorder-drag-active: false;
    property <length> down-abs-x;
    property <length> down-abs-y;
    property <bool> dragging: false;

    height: 30px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
    background: root.dragging
        ? Theme.accent-background.with-alpha(0.08)
        : (header-touch.has-hover ? Theme.foreground.with-alpha(0.05) : transparent);

    changed reorder-drag-active => {
        if (!root.reorder-drag-active) { root.dragging = false; }
    }

    // Whole surface draggable, below the Favorites action buttons.
    header-touch := TouchArea {
        mouse-cursor: root.dragging ? grabbing : grab;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                Dismiss.serial += 1;
                root.down-abs-x = self.absolute-position.x + self.mouse-x;
                root.down-abs-y = self.absolute-position.y + self.mouse-y;
                root.dragging = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                let ax: length = self.absolute-position.x + self.mouse-x;
                let ay: length = self.absolute-position.y + self.mouse-y;
                if (root.dragging) {
                    root.drag-dropped(root.section-code, ax, ay);
                    root.dragging = false;
                } else if (self.mouse-x >= 0px && self.mouse-x <= self.width
                        && self.mouse-y >= 0px && self.mouse-y <= self.height) {
                    root.toggled();
                }
            }
        }
        moved => {
            if (self.pressed) {
                let ax: length = self.absolute-position.x + self.mouse-x;
                let ay: length = self.absolute-position.y + self.mouse-y;
                if (!root.dragging
                        && (abs(ax - root.down-abs-x) > 6px
                            || abs(ay - root.down-abs-y) > 6px)) {
                    root.dragging = true;
                    Tip.text = "";
                    root.drag-started(root.section-code, ax, ay);
                }
                if (root.dragging) {
                    root.drag-moved(root.section-code, ax, ay);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Image {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            source: root.collapsed
                ? @image-url("../../assets/icons/chevron-right.svg")
                : @image-url("../../assets/icons/chevron-down.svg");
            colorize: Theme.foreground.with-alpha(header-touch.has-hover ? 0.7 : 0.4);
        }
        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.foreground.with-alpha(0.5);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // The two Favorites actions precede the handle: this way it stays
        // at the same X, all the way to the right, across all four headers.
        if root.favorite-actions : SidebarHeaderActionSlot {
            icon: @image-url("../../assets/icons/plus.svg");
            tooltip: root.new-container-tooltip;
            clicked => { root.new-container(); }
        }
        if root.favorite-actions : SidebarHeaderActionSlot {
            icon: root.can-collapse
                ? @image-url("../../assets/icons/chevron-up.svg")
                : @image-url("../../assets/icons/chevron-down.svg");
            tooltip: root.collapse-tooltip;
            clicked => { root.collapse-all(); }
        }
        // 24px full-height slot: the 3x2-dot SVG is centered on both
        // axes and stays crisp regardless of the header's number of actions.
        Rectangle {
            width: 24px;
            height: 30px;
            Image {
                source: @image-url("../../assets/icons/grip-horizontal.svg");
                width: 16px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Theme.foreground;
                opacity: root.dragging ? 0.90 : (header-touch.has-hover ? 0.65 : 0.32);
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.hairline;
    }
}


// A semantic section of places. Its header exists even when its
// model is empty (notably Network), a necessary condition for moving it.
export component Sidebar inherits Rectangle {
    in property <[SidebarPlace]> places;
    in property <Strings> strings;
    in property <int> section-code;
    in property <string> title;
    in property <bool> collapsed: false;
    in property <bool> header-visible: true;
    in property <bool> reorder-drag-active: false;
    in property <int> reorder-drag-source: -1;
    in property <bool> item-drag-active: false;
    /// Width of the side panel, forwarded to the rows — see `SidebarItem`.
    in property <length> panel-width;
    callback place-clicked(string, int);   // (path, kind)
    callback place-middle-clicked(string, int);   // (path, kind) → new tab
    callback place-right-clicked(string, int, bool, bool, string, length, length);   // (path, kind, removable, hotplug, device, x, y)
    callback place-drag-started(length, length);
    callback place-drag-moved(length, length);
    callback place-drag-dropped(string, int, length, length);
    callback section-toggled();
    callback section-drag-started(int, length, length);
    callback section-drag-moved(int, length, length);
    callback section-drag-dropped(int, length, length);

    background: Theme.toolbar;
    opacity: root.reorder-drag-active && root.reorder-drag-source == root.section-code ? 0.55 : 1.0;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        if root.header-visible : SidebarSectionHeader {
            section-code: root.section-code;
            label: root.title;
            collapsed: root.collapsed;
            reorder-drag-active: root.reorder-drag-active;
            toggled => { root.section-toggled(); }
            drag-started(section, x, y) => { root.section-drag-started(section, x, y); }
            drag-moved(section, x, y) => { root.section-drag-moved(section, x, y); }
            drag-dropped(section, x, y) => { root.section-drag-dropped(section, x, y); }
        }
        // The items scroll on their own. Without this, a long list claims its
        // full height from the panel's layout and pushes whatever follows past
        // the bottom edge, out of reach — there was no way to scroll to it.
        // `min-height: 0` is what lets the layout shrink the list instead;
        // collapsing then zeroes the height rather than dropping the element,
        // the same way the Favorites tree does it.
        places-scroll := ScrollView {
            vertical-stretch: 1;
            visible: !root.collapsed;
            min-height: 0px;
            // Never taller than its own content, so the next section follows
            // immediately instead of hanging below an empty gap. Slint
            // geometry: item 30px + 2px of top padding.
            max-height: root.collapsed ? 0px : root.places.length * 32px;
            // Content height stated explicitly, for the reason given on the
            // Favorites tree: a view told nothing about its content cannot
            // know it has anything to scroll to.
            viewport-height: max(self.height, root.places.length * 32px);
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                for p in root.places : HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    place-item := SidebarItem {
                        label: p.kind == 1 ? root.strings.sidebar-home
                            : p.kind == 3 ? root.strings.sidebar-trash
                            : (p.kind == 2 && p.label == "") ? root.strings.sidebar-root
                            : p.label;
                        draggable: p.path != ""
                            && (p.kind == 0 || p.kind == 1 || p.kind == 2 || p.kind == 4);
                        drag-active: root.item-drag-active;
                        kind: p.kind;
                        space-level: p.space-level;
                        space-used-ratio: p.space-used-ratio;
                        space-text: p.space-text;
                        space-text-short: p.space-text-short;
                        space-hint: p.space-hint;
                        panel-width: root.panel-width;
                        clicked => { root.place-clicked(p.path, p.kind); }
                        middle-clicked => { root.place-middle-clicked(p.path, p.kind); }
                        right-clicked(x, y) => { root.place-right-clicked(p.path, p.kind, p.removable, p.hotplug, p.device, x, y); }
                        drag-started(x, y) => { root.place-drag-started(x, y); }
                        drag-moved(x, y) => { root.place-drag-moved(x, y); }
                        drag-dropped(x, y) => { root.place-drag-dropped(p.path, p.kind, x, y); }
                    }
                }
            }
        }
    }
}


// A row of the favorites tree: container or favorite, indented by
// depth. PURELY visual on the chevron side (left click expands a
// container / opens a favorite, handled by the parent via `activate`).
export component FavRow inherits Rectangle {
    in property <FavNode> node;
    in property <bool> selected;
    in property <int> row-index;                // position in the visible list
    in property <bool> drag-active;             // a reorder drag is in progress
    in property <bool> location-drag-active: false;
    in property <bool> reorder-feedback-visible: true;
    in property <int> drag-target-index;        // current target row (-1 = none)
    in property <int> drag-zone;                // 0 before · 1 inside · 2 after
    // Target of a tab or file drag: this container is hovered and the
    // target dropped here will be saved as a favorite. Same "drop-into" rendering as
    // the internal reorder drag.
    in property <bool> drop-hover: false;
    callback activate();
    callback middle-clicked();
    callback right-clicked(length, length);
    // Drag: (source row-index, absolute cursor y, top y of THIS row). The bridge
    // computes the target/zone in f32 (reliable) and performs the move on drop.
    callback drag-move(int, length, length, length);
    callback drag-drop(int, length, length, length);

    height: 30px;
    border-radius: Tokens.radius-row;
    // Indentation capped at 5 levels (beyond that, it degrades without aligning).
    property <length> indent: 8px + min(root.node.depth, 5) * 14px;
    // "Drop INTO this container" highlight: internal (reorder) drag
    // OR a tab/file drag — same rendering.
    property <bool> drop-into: (root.drag-active && root.reorder-feedback-visible
        && root.drag-target-index == root.row-index && root.drag-zone == 1
        && root.node.is-container) || root.drop-hover;
    property <length> ds-y;
    property <length> row-top;
    property <bool> dragging: false;
    // See the reorderable sections: a drag cut from outside takes this row's
    // own state with it, so it stops looking carried.
    changed drag-active => {
        if (!root.drag-active && !root.location-drag-active) { root.dragging = false; }
    }
    changed location-drag-active => {
        if (!root.drag-active && !root.location-drag-active) { root.dragging = false; }
    }

    opacity: root.dragging ? 0.4 : 1.0;
    background: root.drop-into
        ? Theme.accent-background.with-alpha(0.18)
        : (root.selected
            ? Theme.accent-background.with-alpha(0.20)
            : (touch.has-hover ? Theme.alternate-background : transparent));
    border-width: (root.selected || root.drop-into) ? 1px : 0px;
    border-color: Theme.accent-background.with-alpha(0.45);

    // Insertion bar (reorder before / after).
    if root.drag-active && root.reorder-feedback-visible
            && root.drag-target-index == root.row-index && root.drag-zone == 0 : Rectangle {
        y: 0;
        height: 2px;
        x: root.indent;
        width: parent.width - root.indent - 8px;
        background: Theme.accent-background;
        border-radius: 1px;
    }
    if root.drag-active && root.reorder-feedback-visible
            && root.drag-target-index == root.row-index && root.drag-zone == 2 : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: root.indent;
        width: parent.width - root.indent - 8px;
        background: Theme.accent-background;
        border-radius: 1px;
    }

    // Root TouchArea: the visual content is declared afterward and clicks on
    // empty areas fall through here. Renaming uses a modal popup.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            // LEFT click on a favorite closes menus; right-click (favorite
            // menu) does not bump → it can teleport the menu.
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Dismiss.serial += 1; }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.ds-y = self.absolute-position.y + self.mouse-y;
                root.row-top = self.absolute-position.y;
                root.dragging = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                if (root.dragging) {
                    // CURRENT top of the row (auto-corrects if the list moved
                    // during the drag, e.g. auto-expand of a hovered container).
                    root.drag-drop(root.row-index,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y,
                        self.absolute-position.y);
                    root.dragging = false;
                } else {
                    root.activate();
                }
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.right-clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (ev.button == PointerEventButton.middle && ev.kind == PointerEventKind.down) {
                root.middle-clicked();
            }
        }
        moved => {
            if (self.pressed) {
                if (!root.dragging
                        && abs(self.absolute-position.y + self.mouse-y - root.ds-y) > 6px) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.drag-move(root.row-index,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y,
                        self.absolute-position.y);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: root.indent;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;
        // Chevron slot (16px) — shown only for a non-empty container.
        Rectangle {
            width: 16px;
            height: parent.height;
            if root.node.is-container && root.node.has-children : Image {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.node.expanded
                    ? @image-url("../../assets/icons/chevron-down.svg")
                    : @image-url("../../assets/icons/chevron-right.svg");
                colorize: Theme.foreground.with-alpha(touch.has-hover ? 0.7 : 0.45);
            }
        }
        // Icon slot (16px): folder (container, accent if expanded) / bookmark (favorite).
        Rectangle {
            width: 16px;
            height: parent.height;
            Image {
                width: 16px;
                height: 16px;
                x: 0;
                y: (parent.height - self.height) / 2;
                source: root.node.is-container
                    ? @image-url("../../assets/icons/folder.svg")
                    : @image-url("../../assets/icons/bookmark.svg");
                colorize: root.node.is-container
                    ? (root.node.expanded ? Theme.accent-background : Theme.foreground.with-alpha(0.7))
                    : (root.node.available ? Theme.foreground.with-alpha(0.65) : Tokens.danger.with-alpha(0.8));
            }
        }
        // Node label, renamed via a modal popup.
        Rectangle {
            horizontal-stretch: 1;
            Text {
                text: root.node.label;
                font-size: 12px;
                font-weight: root.node.is-container ? 600 : 400;
                color: (root.node.is-container || root.node.available)
                    ? Theme.foreground
                    : Theme.foreground.with-alpha(0.4);
                vertical-alignment: center;
                overflow: elide;
                width: parent.width;
            }
        }
    }
}


// "Favorites" panel: header (title + actions) + scrollable flattened tree.
export component FavPanel inherits Rectangle {
    in property <[FavNode]> nodes;
    in property <Strings> strings;
    in property <string> selected-id;
    in property <bool> drag-active;
    in property <int> drag-target-index;
    in property <int> drag-zone;
    in property <int> section-code: 2;
    in property <bool> reorder-drag-active: false;
    in property <int> reorder-drag-source: -1;
    in property <bool> location-drag-active: false;
    callback section-drag-started(int, length, length);
    callback section-drag-moved(int, length, length);
    callback section-drag-dropped(int, length, length);
    // Target of a tab or file drag over a favorites folder.
    // ABSOLUTE (window-relative) cursor position, propagated by MainWindow based on
    // the ONGOING drag (tab OR file — mutually exclusive). Used to know
    // which favorites folder is hovered, to drop the target there.
    in property <bool> tab-drag-active: false;
    in property <length> tab-drag-abs-x: 0px;
    in property <length> tab-drag-abs-y: 0px;
    in property <bool> file-drag-active: false;
    in property <length> file-drag-abs-x: 0px;
    in property <length> file-drag-abs-y: 0px;
    // Is a drag (tab OR file) in progress? + its current position.
    property <bool> drag-on: root.tab-drag-active || root.file-drag-active;
    property <length> drag-ax: root.tab-drag-active ? root.tab-drag-abs-x : root.file-drag-abs-x;
    property <length> drag-ay: root.tab-drag-active ? root.tab-drag-abs-y : root.file-drag-abs-y;
    // Absolute cursor Y captured continuously during an INTERNAL reorder drag
    // (a file/tab drag carries its own `drag-ay`). Feeds the edge auto-scroll so
    // an off-screen target row can be reached without releasing the drag.
    property <length> reorder-cursor-x;
    property <length> reorder-cursor-y;
    // Internal reorder feedback belongs to the visible favorites frame only.
    // Keep the logical target alive outside it so releasing over a tab gap can
    // still turn a favorite into a tab, without flashing a clamped reorder bar.
    property <bool> reorder-in-x:
        !(root.drag-active && root.shown && !root.section-collapsed) ? false
        : (root.reorder-cursor-x >= fav-scroll.absolute-position.x
            && root.reorder-cursor-x <= fav-scroll.absolute-position.x + fav-scroll.width);
    property <bool> reorder-in-frame:
        !root.reorder-in-x ? false
        : (root.reorder-cursor-y >= fav-scroll.absolute-position.y
            && root.reorder-cursor-y <= fav-scroll.absolute-position.y + fav-scroll.height);
    // Exposes the exact reorder commit area so the global drag indicator uses
    // the same target decision as the release handler.
    out property <bool> reorder-hover-panel: root.reorder-in-frame;
    out property <length> reorder-drag-abs-x: root.reorder-cursor-x;
    out property <length> reorder-drag-abs-y: root.reorder-cursor-y;
    // Index of the row hovered by the drag (uniform pitch 30 + 1px = 31px), or
    // -1. CRITICAL (→): every `absolute-position` read is CONFINED
    // to the "drag active" branch of the ternary → never evaluated outside a drag (the
    // ternary only evaluates the taken branch). We read the UNSCROLLED frame of the
    // ScrollView (`fav-scroll.absolute-position`, like the PanelComponent's
    // `list-area`) + its `viewport-y` — NEVER the absolute-position of the
    // scrolled content, which used to trigger "Recursion detected". Truncation to
    // `int` = floor for a gap ≥ 0 (guarded by the threshold).
    /// Is the side column on screen at all?
    ///
    /// GEOMETRY CANNOT ANSWER THIS, and that is the whole point of the flag.
    /// The column is always instantiated so that the drop target stays
    /// referenceable, and collapsing it sets its width to zero — but the grid
    /// inside keeps the minimum width of its sections and simply OVERFLOWS the
    /// zero-width parent, while `visible: false` hides the drawing without
    /// touching the layout. The tree therefore keeps, off screen, exactly the
    /// frame it would have when open, and a containment test on that frame
    /// answers yes for a drag that can reach nothing.
    ///
    /// Defaulted to false on purpose: an instantiation that forgot to wire it
    /// would make drops inoperative, which gets reported, rather than silently
    /// reopening a target the user cannot see.
    in property <bool> shown: false;
    /// Is the drag cursor within the tree's X span, the column being on screen?
    property <bool> drag-in-x:
        !(root.drag-on && root.shown) ? false
        : (root.drag-ax >= fav-scroll.absolute-position.x
            && root.drag-ax <= fav-scroll.absolute-position.x + fav-scroll.width);
    /// … and within its Y span as well, so the cursor is really over the tree.
    property <bool> drag-in-frame:
        !root.drag-in-x ? false
        : (root.drag-ay >= fav-scroll.absolute-position.y
            && root.drag-ay <= fav-scroll.absolute-position.y + fav-scroll.height);
    property <int> hover-row:
        !root.drag-in-frame ? -1
        : (root.drag-ay
                >= fav-scroll.absolute-position.y + fav-scroll.viewport-y + 6px)
            ? (root.drag-ay - fav-scroll.absolute-position.y - fav-scroll.viewport-y - 6px) / 31px
            : -1;
    // Id of the hovered CONTAINER (only containers accept a drop), or "".
    // Read by MainWindow (pull-based) on drop → drop target (robust even on a
    // cross-instance drop whose async hover lags behind).
    out property <string> hover-container:
        (root.hover-row >= 0 && root.hover-row < root.nodes.length
            && root.nodes[root.hover-row].is-container)
        ? root.nodes[root.hover-row].id
        : "";
    // Is the cursor OVER the favorites area (scroll) during a
    // drag? Used as a fallback: a drop outside a container ("no favorites" area,
    // or dead zone when there are only root-level favorites) adds AT THE ROOT.
    out property <bool> hover-panel: root.drag-in-frame;
    // Id of the hovered container if it is COLLAPSED and NOT EMPTY → candidate for
    // auto-expansion during a tab/file drag, like the internal reorder
    // drag. "" otherwise.
    out property <string> hover-collapsed-container:
        (root.hover-row >= 0 && root.hover-row < root.nodes.length
            && root.nodes[root.hover-row].is-container
            && root.nodes[root.hover-row].has-children
            && !root.nodes[root.hover-row].expanded)
        ? root.nodes[root.hover-row].id
        : "";
    // The whole SECTION is collapsed and a drag hovers its (only visible)
    // header → candidate for auto-expanding the section, so the target can be
    // reached. Anchored to the HEADER element itself (always laid out, fixed
    // 30px) rather than the component root, whose height depends on the grid's
    // stretch/max-height juggling and proved unreliable while collapsed. Absolute
    // read confined to a live drag (like `hover-panel`).
    out property <bool> hover-collapsed-section:
        root.section-collapsed && root.drag-on && root.shown
        && root.drag-ax >= sec-header.absolute-position.x
        && root.drag-ax <= sec-header.absolute-position.x + sec-header.width
        && root.drag-ay >= sec-header.absolute-position.y
        && root.drag-ay <= sec-header.absolute-position.y + sec-header.height;
    callback row-activate(string);
    callback row-middle(string);
    callback row-context(string, bool, string, length, length);   // id, is-container, label, x, y
    callback row-drag-move(int, length, length, length); // row, abs-x, cur-y, row-top
    callback row-drag-drop(int, length, length, length, bool); // final bool: in visible tree
    callback new-container();
    callback collapse-all();
    callback expand-all();
    in property <bool> can-collapse;                       // >=1 expanded container
    // Collapse of the Favorites SECTION: hides the tree (the header stays). State
    // carried by MainWindow (which also adjusts this panel's vertical-stretch).
    in property <bool> section-collapsed: false;
    callback toggle-section();
    background: Theme.toolbar;
    opacity: root.reorder-drag-active && root.reorder-drag-source == root.section-code ? 0.55 : 1.0;
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        sec-header := SidebarSectionHeader {
            section-code: root.section-code;
            label: root.strings.fav-title;
            collapsed: root.section-collapsed;
            favorite-actions: true;
            can-collapse: root.can-collapse;
            new-container-tooltip: root.strings.fav-new-container;
            collapse-tooltip: root.can-collapse
                ? root.strings.fav-collapse-all
                : root.strings.fav-expand-all;
            reorder-drag-active: root.reorder-drag-active;
            toggled => { root.toggle-section(); }
            new-container => { root.new-container(); }
            collapse-all => {
                if (root.can-collapse) { root.collapse-all(); } else { root.expand-all(); }
            }
            drag-started(section, x, y) => { root.section-drag-started(section, x, y); }
            drag-moved(section, x, y) => { root.section-drag-moved(section, x, y); }
            drag-dropped(section, x, y) => { root.section-drag-dropped(section, x, y); }
        }
        // List or empty state, always instantiated for the drag's hit-test. When
        // the section is collapsed, it becomes invisible with zero height
        // rather than using a conditional element.
        fav-scroll := ScrollView {
            vertical-stretch: 1;
            visible: !root.section-collapsed;
            // `min-height: 0` neutralizes the ScrollView's minimum height so that
            // FavPanel can shrink down to just its header when collapsed.
            min-height: 0px;
            max-height: root.section-collapsed ? 0px : 100000px;
            // The content height, stated rather than inferred. `content-rect`
            // is a plain Rectangle pinned to the visible height, so nothing
            // would tell the view its rows go further down: the tree simply got
            // clipped at the bottom edge, with no scrollbar and no way to
            // reach the last favourites. Same approach as the file list, and
            // the same geometry the hit-test below already assumes: row 30px +
            // 1px gap = 31, list padding 11, empty state 132.
            viewport-height: max(
                self.height,
                root.nodes.length == 0 ? 132px : 11px + root.nodes.length * 31px);
            // Container filled to AT LEAST the visible height → the "dead"
            // area below the list stays clickable (left click = closes menus).
            content-rect := Rectangle {
                min-height: parent.visible-height;
                // Background TouchArea (declared BEFORE the rows → behind): a
                // left click on empty space closes menus. The New folder,
                // Expand all, and Collapse all actions live in the header.
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            Dismiss.serial += 1;
                        }
                    }
                }
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if root.nodes.length == 0 : Rectangle {
                    height: 120px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Image {
                            source: @image-url("../../assets/icons/bookmark.svg");
                            width: 28px;
                            height: 28px;
                            colorize: Theme.foreground.with-alpha(0.25);
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.strings.fav-empty;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.45);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                for n[i] in root.nodes : FavRow {
                    node: n;
                    selected: n.id == root.selected-id;
                    row-index: i;
                    drag-active: root.drag-active;
                    location-drag-active: root.location-drag-active;
                    reorder-feedback-visible: root.reorder-in-frame;
                    drag-target-index: root.drag-target-index;
                    drag-zone: root.drag-zone;
                    // Highlighted if THIS container is the row targeted by a drag
                    // (tab OR file).
                    drop-hover: root.drag-on && i == root.hover-row && n.is-container;
                    activate => { root.row-activate(n.id); }
                    middle-clicked => { root.row-middle(n.id); }
                    right-clicked(x, y) => { root.row-context(n.id, n.is-container, n.label, x, y); }
                    drag-move(ri, cx, cy, rt) => {
                        root.reorder-cursor-x = cx;
                        root.reorder-cursor-y = cy;
                        root.row-drag-move(ri, cx, cy, rt);
                    }
                    drag-drop(ri, cx, cy, rt) => {
                        root.reorder-cursor-x = cx;
                        root.reorder-cursor-y = cy;
                        root.row-drag-drop(ri, cx, cy, rt, root.reorder-in-frame);
                    }
                }
            }
            }   // closes content-rect
        }
    }

    // Edge auto-scroll while a drag hovers the tree: an internal reorder (its
    // cursor Y flows through `reorder-cursor-y`) or a tab/file drag (`drag-ay`,
    // gated to the tree's X span so a drag over the file view never scrolls it).
    // The pastille (`hover-row`) is reactive to `viewport-y`, so it follows the
    // scroll onto the newly revealed containers. Frame reads target the ScrollView
    // itself (unscrolled), the same safe read as `hover-row`.
    DragEdgeScroller {
        // Never while collapsed: the tree has no height to scroll, and driving
        // its `viewport-y` would leave it scrolled past the content (empty on
        // re-expand). The component guards this too, belt and suspenders.
        active: !root.section-collapsed
            && ((root.drag-active && root.reorder-in-x) || root.drag-in-x);
        cursor-y: root.drag-active ? root.reorder-cursor-y : root.drag-ay;
        frame-y: fav-scroll.absolute-position.y;
        frame-h: fav-scroll.height;
        min-vy: fav-scroll.viewport-height > fav-scroll.height
            ? -(fav-scroll.viewport-height - fav-scroll.height)
            : 0px;
        viewport-y <=> fav-scroll.viewport-y;
    }
}


// Activity rail button: centered 16px icon + tooltip on the RIGHT (the rail
// is at the far left) + optional active state (sidebar toggle).
// Modeled on WsIconBtn, tooltip repositioned.
export component RailBtn inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> active: false;
    width: 36px;
    height: 34px;
    border-radius: Tokens.radius-row;
    background: root.active
        ? Theme.accent-background.with-alpha(0.18)
        : (touch.has-hover ? Theme.alternate-background : transparent);
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.accent-background.with-alpha(0.5) : transparent;
    animate background { duration: 110ms; easing: ease-out; }
    // A shortcut customization can change the text while the
    // mouse is still on the button: also keeps the global Tip synchronized.
    changed tooltip => {
        if (touch.has-hover) { Tip.text = root.tooltip; }
    }
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: root.active
            ? Theme.accent-background
            : (touch.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.7));
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { Dismiss.serial += 1; root.clicked(); }
        // Tooltip toward the RIGHT (rail at the far left). Sets/clears the
        // global Tip, rendered at the window level → never hidden by a panel.
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tip.text = root.tooltip;
                Tip.x = self.absolute-position.x + root.width + 6px;
                Tip.y = self.absolute-position.y + (root.height - 22px) / 2;
            } else if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}


// Always-visible vertical activity rail: "Places" panel toggle
// at the top and system actions (Workspaces, Settings) at the bottom.
export component ActivityRail inherits Rectangle {
    // Left panel: 0 collapsed · 1 open (Places + Favorites unified).
    in property <int> left-panel;
    in property <Strings> strings;
    in property <MenuShortcuts> shortcuts;
    callback toggle-places();
    callback open-workspaces();
    callback open-settings();
    width: 48px;
    background: Theme.toolbar;
    // Right thread only when NO panel is open (otherwise visual
    // continuity with the panel that shares the same background).
    if root.left-panel == 0 : Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tokens.hairline;
    }
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 6px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        // Toggle for the unified side panel (Places + Favorites). Re-click = collapses.
        RailBtn {
            icon: @image-url("../../assets/icons/sidebar.svg");
            tooltip: root.strings.sidebar-tooltip;
            active: root.left-panel == 1;
            clicked => { root.toggle-places(); }
        }
        // Thin separator between the panel toggle and the system actions.
        Rectangle {
            height: 9px;
            Rectangle { y: 4px; height: 1px; background: Tokens.hairline; }
        }
        RailBtn {
            icon: @image-url("../../assets/icons/workspaces.svg");
            tooltip: root.strings.ws-tooltip
                + (root.shortcuts.open-workspaces != ""
                    ? "  (" + root.shortcuts.open-workspaces + ")" : "");
            clicked => { root.open-workspaces(); }
        }
        RailBtn {
            icon: @image-url("../../assets/icons/gear.svg");
            tooltip: root.strings.settings-tooltip
                + (root.shortcuts.open-settings != ""
                    ? "  (" + root.shortcuts.open-settings + ")" : "");
            clicked => { root.open-settings(); }
        }
        // Spacer: takes up the bottom of the rail (buttons grouped at the top).
        Rectangle { vertical-stretch: 1; }
    }
}

// ---------- Main window ----------

