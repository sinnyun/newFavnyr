// Small input widgets: text fields, filter bar, links and settings buttons.

import { Theme, Tokens } from "../theme.slint";
import { LineEdit } from "std-widgets.slint";

// Shared deferred focus for LineEdits created inside a conditional popup.
// The one-iteration delay lets Slint finish building the widget and
// avoids the cycles observed with a direct focus() in `changed *-open`.
// Text field with EDITING shortcuts wired explicitly.
//
// Slint normally handles Ctrl+A/C/X/V in its `TextInput`… but only if
// the backend delivers the LETTER (`text == "a"`): its shortcut resolution
// only compares letters, and an earlier check rejects CONTROL characters
// before even getting there. Depending on the keyboard layer, Ctrl+A can arrive
// as `"\u{1}"` (SOH) rather than `"a"` — the editing shortcuts then become
// silently inert, including in our popups.
//
// `TextInput` calls this `key-pressed` callback BEFORE its own handling: we
// therefore cover both encodings, once and for all, for every
// field (this component is used in place of `LineEdit`).
export component EditTextInput inherits TextInput {
    /// Applies Ctrl+A/C/X/V and returns `true` if the key was consumed.
    /// Public: fields that already have their own `key-pressed` (Escape…)
    /// call it instead of duplicating the logic.
    public function edit-shortcut(ev: KeyEvent) -> bool {
        if (ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta
                && !ev.modifiers.shift) {
            if (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}") {
                self.select-all();
                return true;
            }
            if (ev.text == "c" || ev.text == "C" || ev.text == "\u{3}") {
                self.copy();
                return true;
            }
            // Cut/paste make no sense on a read-only field.
            if (!self.read-only && (ev.text == "x" || ev.text == "X" || ev.text == "\u{18}")) {
                self.cut();
                return true;
            }
            if (!self.read-only && (ev.text == "v" || ev.text == "V" || ev.text == "\u{16}")) {
                self.paste();
                return true;
            }
        }
        return false;
    }
    key-pressed(ev) => {
        return self.edit-shortcut(ev) ? accept : reject;
    }
}

export component EditLineEdit inherits LineEdit {
    key-pressed(ev) => {
        // Alt/Meta excluded: those are other combinations (e.g. Alt+Enter).
        if (ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta) {
            // Shift+Ctrl+letter is left to the rest of the application.
            if (!ev.modifiers.shift) {
                if (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}") {
                    self.select-all();
                    return accept;
                }
                if (ev.text == "c" || ev.text == "C" || ev.text == "\u{3}") {
                    self.copy();
                    return accept;
                }
                if (ev.text == "x" || ev.text == "X" || ev.text == "\u{18}") {
                    self.cut();
                    return accept;
                }
                if (ev.text == "v" || ev.text == "V" || ev.text == "\u{16}") {
                    self.paste();
                    return accept;
                }
            }
        }
        return reject;
    }
}


// Search input shared by filterable lists. The standard LineEdit owns text
// editing and its single clear action; callers only provide the filter callback.
export component SearchField inherits Rectangle {
    in property <string> placeholder-text;
    in-out property <string> text;
    callback edited(string);

    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 6px;
        Image {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../../../assets/icons/search.svg");
            colorize: Theme.foreground.with-alpha(0.5);
        }
        search-input := EditLineEdit {
            placeholder-text: root.placeholder-text;
            horizontal-stretch: 1;
            text <=> root.text;
            edited(value) => { root.edited(value); }
        }
    }
}

// Compact affordance bound to an input FIELD rather than to a dialog: it acts
// on the text and never closes anything. Drawn as a link — muted label over a
// 1px rule, accent on hover — so it cannot be taken for one more action button,
// and so it costs a fraction of a button's width in every language. A button
// here would not fit: four of them overflow the card in every language but
// English.
export component FieldLink inherits Rectangle {
    callback clicked();
    in property <string> text;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.text;
                font-size: 12px;
                color: fl-touch.has-hover
                    ? Theme.accent-background
                    : Theme.foreground.with-alpha(0.62);
            }
            // Slint's Text carries no underline property: the rule is a 1px
            // rectangle sized by the layout, so it always matches the label.
            Rectangle {
                height: 1px;
                background: fl-touch.has-hover
                    ? Theme.accent-background
                    : Theme.foreground.with-alpha(0.28);
            }
        }
    }
    fl-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


// View filter bar — SHARED between the by-name type-ahead filter and
// the by-extension filter. Both display the same emulated caret: input
// stays driven by the global FocusScope, but the bar is visually
// identifiable as editable. `close()` = close.
export component FilterBar inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> hint;   // shown greyed out when `text` is empty
    property <bool> caret-visible: true;
    changed text => { root.caret-visible = true; }
    callback close();
    height: 30px;
    border-radius: Tokens.radius-row;
    background: Theme.accent-background.with-alpha(0.13);
    border-width: 1px;
    border-color: Theme.accent-background.with-alpha(0.40);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 4px;
        spacing: 8px;
        // Icon (full-height slot → vertical centering).
        Rectangle {
            width: 15px;
            height: parent.height;
            Image {
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                colorize: Theme.accent-background;
            }
        }
        // Typed text, pale hint when nothing is entered, then a blinking caret
        // positioned after the preferred width of the actual text.
        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            value-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.text;
                font-size: 13px;
                color: Theme.foreground;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.text == "" : Text {
                x: 4px;
                width: parent.width - self.x;
                height: parent.height;
                text: root.hint;
                font-size: 13px;
                color: Theme.foreground.with-alpha(0.3);
                vertical-alignment: center;
                overflow: elide;
            }
            if root.caret-visible : Rectangle {
                x: min(parent.width - 1px,
                    root.text == "" ? 0px : value-text.preferred-width + 1px);
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 16px;
                background: Theme.foreground.with-alpha(0.85);
            }
        }
        // Close ("x") button (single) → closes the filter.
        Rectangle {
            width: 28px;
            height: parent.height;
            Rectangle {
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: fb-close.has-hover ? Tokens.danger.with-alpha(0.20) : transparent;
                Image {
                    width: 13px;
                    height: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../../assets/icons/close.svg");
                    colorize: fb-close.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                }
            }
            fb-close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
        }
    }
    Timer {
        interval: 520ms;
        running: true;
        triggered => { root.caret-visible = !root.caret-visible; }
    }
}


// Text field with a PALE hint (placeholder) overlaid: the
// native `LineEdit` placeholder is too light and gets confused with actual input.
export component HintEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> hint;
    callback edited(string);
    height: 32px;
    edit := EditLineEdit {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        edited(t) => { root.edited(t); }
    }
    // Overlaid hint, visible only when the field is empty. Not
    // interactive → clicks fall through to the LineEdit underneath.
    Text {
        x: 10px;
        width: parent.width - 16px;
        height: parent.height;
        visible: root.text == "";
        text: root.hint;
        font-size: 13px;
        color: Theme.foreground.with-alpha(0.3);
        vertical-alignment: center;
        overflow: elide;
    }
    // Puts the caret at the end and scrolls there. Text appended from outside
    // (the tag buttons) lands past the visible width on a long command, so
    // without this the click produces no visible change at all.
    public function focus-end() {
        edit.focus();
        edit.set-selection-offsets(99999, 99999);
    }
}


// Row made of a label, a selectable monospace path, and a button
// that opens the folder in the system's file manager.
// Inline action sitting at the right end of a settings row. Used where the
// action belongs to the row it labels rather than to the panel as a whole; the
// toolkit `Button` stays the shape for the footers of modal dialogs.
export component SettingsRowButton inherits Rectangle {
    callback clicked();
    in property <string> text;
    in property <bool> enabled: true;

    // Sized on the label: the floor keeps a short one from shrinking into a
    // cramped chip, and the text drives the rest so a longer translation is
    // never clipped.
    out property <length> natural-w: max(64px, label.preferred-width + 20px);
    min-width: root.natural-w;
    preferred-width: root.natural-w;
    height: 22px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 4px;
    background: root.enabled && touch.has-hover
        ? Theme.accent-background.with-alpha(0.15)
        : transparent;
    border-width: 1px;
    border-color: root.enabled && touch.has-hover
        ? Theme.accent-background
        : Theme.border;
    // Disabled reads as "not offered right now", not as a second style: the
    // whole chip fades rather than each of its colours being restated.
    opacity: root.enabled ? 1.0 : 0.45;

    label := Text {
        text: root.text;
        font-size: 11px;
        color: Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component PathRow inherits VerticalLayout {
    callback open-clicked();
    in property <string> label;
    in property <string> value;
    in property <string> open-text;
    spacing: 4px;

    // Row header — fixed-height parent Rectangle to allow absolute
    // vertical centering of the "Open" button (a HorizontalLayout without
    // an explicit height pushed the button toward the top).
    Rectangle {
        height: 22px;
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: root.label;
            font-size: 10px;
            font-weight: 600;
            color: Theme.foreground.with-alpha(0.55);
            letter-spacing: 0.3px;
        }
        SettingsRowButton {
            // Placed by hand rather than by a layout, so the natural width is
            // applied here: a `Rectangle` with no explicit width fills its
            // parent, and the chip would span the whole row.
            width: self.natural-w;
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            text: root.open-text;
            clicked => { root.open-clicked(); }
        }
    }
    EditTextInput {
        text: root.value;
        read-only: true;
        font-size: 12px;
        font-family: "monospace";
        color: Theme.foreground;
        single-line: false;
        wrap: word-wrap;
        selection-background-color: Theme.accent-background.with-alpha(0.5);
        selection-foreground-color: Theme.foreground;
    }
}
