    fav-save-alias <=> SidebarApi.fav-save-alias;
    fav-container-labels: SidebarApi.fav-container-labels;
    fav-container-index <=> SidebarApi.fav-container-index;
    fav-save-commit(alias, index) => { SidebarApi.fav-save-commit(alias, index); }
    fav-save-new-container(name, parent) => { SidebarApi.fav-save-new-container(name, parent); }
