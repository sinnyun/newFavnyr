    mark-menu-y <=> MenuApi.mark-menu-y;
    mark-parent-hover <=> PanelsApi.mark-parent-hover;
    menu-shortcuts: PanelsApi.menu-shortcuts;
    new-menu-open <=> MenuApi.new-menu-open;
    new-menu-x <=> MenuApi.new-menu-x;
    new-menu-y <=> MenuApi.new-menu-y;
    new-parent-hover <=> PanelsApi.new-parent-hover;
    ow-menu-open <=> MenuApi.ow-menu-open;
    ow-menu-x <=> MenuApi.ow-menu-x;
    ow-menu-y <=> MenuApi.ow-menu-y;
    ow-parent-hover <=> SettingsApi.ow-parent-hover;
    platform-windows: SettingsApi.platform-windows;
    strings: ApplicationApi.strings;
    equalize-available: PanelsApi.equalize-available;
    equalize-undone: PanelsApi.equalize-undone;
    equalize-views(p1) => { PanelsApi.equalize-views(p1); }
    panel-split(p1) => { PanelsApi.panel-split(p1); }
    split-menu-open <=> MenuApi.split-menu-open;
    split-menu-x: MenuApi.split-menu-x;
    split-menu-y: MenuApi.split-menu-y;
    set-tab-bar-mode(panel, mode) => { PanelsApi.set-tab-bar-mode(panel, mode); }
    tabbar-menu-mode: MenuApi.tabbar-menu-mode;
    tabbar-menu-open <=> MenuApi.tabbar-menu-open;
