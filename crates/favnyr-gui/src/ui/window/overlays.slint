export component WindowOverlays inherits Rectangle {
    width: 100%;
    height: 100%;
    in property <bool> file-drop-will-cancel;
    in property <bool> sidebar-item-drop-will-cancel;
    in property <bool> favorite-reorder-drop-will-cancel;
    in property <bool> view-drag-outside;
    in property <string> fav-hover-container;
    in property <bool> fav-hover-panel;
    in property <length> fav-reorder-drag-abs-x;
    in property <length> fav-reorder-drag-abs-y;
    in property <bool> fav-hover-collapsed-section;
    in property <string> fav-ext-collapsed;
    property <string> fav-drag-hover-container-watch: DragDropApi.fav-drag-hover-container;
    changed fav-drag-hover-container-watch => { fav-autoexp-timer.restart(); }
    property <string> fav-ext-collapsed-watch: root.fav-ext-collapsed;
    changed fav-ext-collapsed-watch => { fav-autoexp-ext-timer.restart(); }
    in-out property <bool> rename-focus-armed;
    in-out property <bool> comment-focus-armed;
    in-out property <bool> create-focus-armed;
    in property <bool> create-can-confirm;
    in-out property <bool> paste-conflict-focus-armed;
    callback return-focus();
    callback open-fav-name(bool, string, string);
    callback open-shortcut-menu(string, length, length);

// ===== File & panel context menus (ctx, split, view, tab-bar, URL, trash, drive) =====
// Extracted to overlays/menus.slint; the forwards below are the whole
// contract with it (state in, actions back out).
OverlayMenus {
    action-copy() => { OperationsApi.action-copy(); }
    action-copy-name() => { OperationsApi.action-copy-name(); }
    action-copy-path() => { OperationsApi.action-copy-path(); }
