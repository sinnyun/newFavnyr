    columns-menu-open <=> MenuApi.columns-menu-open;
    columns-menu-panel: MenuApi.columns-menu-panel;
    columns-menu-x: MenuApi.columns-menu-x;
    columns-menu-y: MenuApi.columns-menu-y;
    ext-filter-toggle(p1) => { PanelsApi.ext-filter-toggle(p1); }
    panels: PanelsApi.panels;
    set-group-mode(p1, p2) => { PanelsApi.set-group-mode(p1, p2); }
    return-focus() => { root.return-focus(); }
    file-drop-action(p1) => { DragDropApi.file-drop-action(p1); }
    file-drop-menu-open <=> DragDropApi.file-drop-menu-open;
    file-drop-menu-x: DragDropApi.file-drop-menu-x;
    file-drop-menu-y: DragDropApi.file-drop-menu-y;
}

// ===== Favorites popups and the container context menu =====
