// The New folder, Expand all, and Collapse all actions live
// in the Favorites section's header.

// ===== Tab bar, Columns and drop menus =====
// Extracted to overlays/panel_menus.slint; the forwards below are the
// whole contract with it (state in, actions back out).
OverlayPanelMenus {
    closed-tabs-available: PanelsApi.closed-tabs-available;
    fav-save-all-tabs(p1) => { SidebarApi.fav-save-all-tabs(p1); }
