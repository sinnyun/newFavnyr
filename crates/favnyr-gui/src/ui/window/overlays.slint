    action-open-parent() => { OperationsApi.action-open-parent(); }
    action-open-terminal() => { OperationsApi.action-open-terminal(); }
    action-paste() => { OperationsApi.action-paste(); }
    action-properties() => { OperationsApi.action-properties(); }
    action-rename() => { OperationsApi.action-rename(); }
    ctx-close() => { MenuApi.ctx-close(); }
    ctx-custom-entries: MenuApi.ctx-custom-entries;
    ctx-custom-run(id) => { MenuApi.ctx-custom-run(id); }
    ctx-menu-open: MenuApi.ctx-menu-open;
    ctx-menu-x: MenuApi.ctx-menu-x;
    ctx-menu-y: MenuApi.ctx-menu-y;
    ctx-on-empty: MenuApi.ctx-on-empty;
    ctx-selection-has-dir: MenuApi.ctx-selection-has-dir;
    ctx-selection-is-dir: MenuApi.ctx-selection-is-dir;
    ctx-selection-is-file: MenuApi.ctx-selection-is-file;
    ctx-selection-single: MenuApi.ctx-selection-single;
    ctx-shell-entries: MenuApi.ctx-shell-entries;
    ctx-shell-run(command) => { MenuApi.ctx-shell-run(command); }
    ctx-shell-sub-for <=> MenuApi.ctx-shell-sub-for;
    ctx-shell-sub-hover(sub) => { MenuApi.ctx-shell-sub-hover(sub); }
    ctx-shell-sub-open <=> MenuApi.ctx-shell-sub-open;
    ctx-shell-sub-parent-hover <=> MenuApi.ctx-shell-sub-parent-hover;
    ctx-shell-sub-x <=> MenuApi.ctx-shell-sub-x;
    ctx-shell-sub-y <=> MenuApi.ctx-shell-sub-y;
