    fav-menu-x <=> SidebarApi.fav-menu-x;
    fav-menu-y <=> SidebarApi.fav-menu-y;
    fav-menu-container <=> SidebarApi.fav-menu-container;
    fav-menu-confirm-delete <=> SidebarApi.fav-menu-confirm-delete;
    fav-menu-id: SidebarApi.fav-menu-id;
    fav-menu-name: SidebarApi.fav-menu-name;
    fav-open(id) => { SidebarApi.fav-open(id); }
    fav-open-all(id) => { SidebarApi.fav-open-all(id); }
    fav-delete(id) => { SidebarApi.fav-delete(id); }
    fav-copy-path(id) => { SidebarApi.fav-copy-path(id); }
