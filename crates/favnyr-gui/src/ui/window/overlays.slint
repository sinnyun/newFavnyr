    create-can-confirm: root.create-can-confirm;
    create-confirmed(kind, name, target) => { return OperationsApi.create-confirmed(kind, name, target); }
    create-browse-target() => { OperationsApi.create-browse-target(); }
    orphans-open <=> SettingsApi.orphans-open;
    orphan-rows: PanelsApi.orphan-rows;
    orphans-confirm-label: SettingsApi.orphans-confirm-label;
    orphans-checked: SettingsApi.orphans-checked;
    orphan-toggled(key, on) => { PanelsApi.orphan-toggled(key, on); }
    orphans-select-all(on) => { SettingsApi.orphans-select-all(on); }
    orphans-confirmed() => { SettingsApi.orphans-confirmed(); }
    filename-caret-offset(name, folder) => { return PanelsApi.filename-caret-offset(name, folder); }
}

// ===== Modal dialogs =====
// Extracted to overlays/dialogs.slint; the forwards below are the whole
// contract with it (state in, decisions back out).
OverlayDialogs {
    strings: ApplicationApi.strings;
    delete-warning-open <=> OperationsApi.delete-warning-open;
    delete-warning-permanent: OperationsApi.delete-warning-permanent;
    delete-warning-confirmed() => { OperationsApi.delete-warning-confirmed(); }
    open-many-open <=> OperationsApi.open-many-open;
    open-many-body: OperationsApi.open-many-body;
    open-many-confirmed() => { OperationsApi.open-many-confirmed(); }
    ws-dirty-warn-open <=> WorkspacesApi.ws-dirty-warn-open;
    ws-dirty-title-text: WorkspacesApi.ws-dirty-title-text;
    ws-dirty-body-text: WorkspacesApi.ws-dirty-body-text;
    ws-dirty-target-id: WorkspacesApi.ws-dirty-target-id;
    ws-dirty-reset: WorkspacesApi.ws-dirty-reset;
    workspaces-open <=> WorkspacesApi.workspaces-open;
    ws-reset() => { WorkspacesApi.ws-reset(); }
    ws-load(id) => { WorkspacesApi.ws-load(id); }
    ws-save-and-load() => { WorkspacesApi.ws-save-and-load(); }
    paste-conflict-open <=> OperationsApi.paste-conflict-open;
    paste-conflict-name <=> OperationsApi.paste-conflict-name;
    paste-conflict-original: OperationsApi.paste-conflict-original;
    paste-conflict-is-dir: OperationsApi.paste-conflict-is-dir;
    paste-conflict-name-taken: OperationsApi.paste-conflict-name-taken;
    paste-conflict-rename-only: OperationsApi.paste-conflict-rename-only;
    paste-conflict-focus-armed <=> root.paste-conflict-focus-armed;
    filename-caret-offset(name, folder) => { return PanelsApi.filename-caret-offset(name, folder); }
    paste-conflict-check(t) => { OperationsApi.paste-conflict-check(t); }
    paste-conflict-confirm(t) => { OperationsApi.paste-conflict-confirm(t); }
    paste-conflict-skip() => { OperationsApi.paste-conflict-skip(); }
    paste-conflict-replace() => { OperationsApi.paste-conflict-replace(); }
    paste-conflict-replace-all() => { OperationsApi.paste-conflict-replace-all(); }
    paste-conflict-skip-all() => { OperationsApi.paste-conflict-skip-all(); }
    paste-conflict-cancel() => { OperationsApi.paste-conflict-cancel(); }
}

// ===== Progress toasts, drag pills and the global notice =====
// Extracted to overlays/toasts.slint; the forwards below are the
// whole contract with it (state in, dismissals back out).
OverlayToasts {
    strings: ApplicationApi.strings;
    ops: OperationsApi.ops;
    ops-more-text: OperationsApi.ops-more-text;
    op-cancel(id) => { OperationsApi.op-cancel(id); }
    op-dismiss(id) => { OperationsApi.op-dismiss(id); }
    drag-active: DragDropApi.drag-active;
    drag-abs-x: DragDropApi.drag-abs-x;
    drag-abs-y: DragDropApi.drag-abs-y;
    file-drag-active: DragDropApi.file-drag-active;
    file-drag-abs-x: DragDropApi.file-drag-abs-x;
    file-drag-abs-y: DragDropApi.file-drag-abs-y;
    file-drag-target-exec: DragDropApi.file-drag-target-exec;
    file-drag-copy: DragDropApi.file-drag-copy;
    file-drop-will-cancel: root.file-drop-will-cancel;
    sidebar-item-drop-will-cancel: root.sidebar-item-drop-will-cancel;
    favorite-reorder-drop-will-cancel: root.favorite-reorder-drop-will-cancel;
    fav-hover-panel: root.fav-hover-panel;
    fav-reorder-drag-abs-x: root.fav-reorder-drag-abs-x;
    fav-reorder-drag-abs-y: root.fav-reorder-drag-abs-y;
    view-drag-active: DragDropApi.view-drag-active;
    view-drag-abs-x: DragDropApi.view-drag-abs-x;
    view-drag-abs-y: DragDropApi.view-drag-abs-y;
    view-drag-target: DragDropApi.view-drag-target;
    view-drag-outside: root.view-drag-outside;
    notice-text <=> PanelsApi.notice-text;
    notice-tone: PanelsApi.notice-tone;
    notice-icon: PanelsApi.notice-icon;
    notice-duration: PanelsApi.notice-duration;
}
// Auto-expand: a collapsed container hovered during a drag
// expands after a short delay (in-place insertion on the bridge side → the ongoing
// drag survives). The countdown restarts on every change of
// hovered container.
fav-autoexp-timer := Timer {
    interval: 650ms;
    running: DragDropApi.fav-drag-active && DragDropApi.fav-drag-hover-container != "";
    triggered => { SidebarApi.fav-expand(DragDropApi.fav-drag-hover-container); }
}
// Also auto-expands during a TAB or FILE drag over a
// collapsed container — makes the gesture consistent with internal drag.
// `root.fav-ext-collapsed` (declared at the root) tracks
// `sidebar-column.hover-collapsed-container`; its `changed` (at the root) restarts
// this countdown.
fav-autoexp-ext-timer := Timer {
    interval: 650ms;
    running: (DragDropApi.drag-active || DragDropApi.file-drag-active)
        && root.fav-ext-collapsed != "";
    triggered => { SidebarApi.fav-expand(root.fav-ext-collapsed); }
}
// Auto-expands the whole COLLAPSED favorites section when a tab/file drag
// dwells on its header → the tree appears so the drop can land, instead of
// the gesture doing nothing over a folded section. Purely declarative (no
// imperative restart): it arms only while the drag actually hovers the
// header, fires once after 650ms, and expanding flips
// `hover-collapsed-section` false so `running` drops — it cannot re-fire
// or loop, and leaves no pending fire to re-expand a section the user
// later collapses.
Timer {
    interval: 650ms;
    running: (DragDropApi.drag-active || DragDropApi.file-drag-active)
        && root.fav-hover-collapsed-section;
    triggered => {
        SidebarApi.fav-section-collapsed = false;
        SidebarApi.sidebar-section-state-changed(2, false);
    }
}
Timer {
    interval: 50ms;
    running: DragDropApi.file-drag-refresh-pending && !DragDropApi.file-drag-active
        && !DragDropApi.file-drop-menu-open && !OperationsApi.op-busy;
    triggered => {
        DragDropApi.file-drag-refresh-pending = false;
        PanelsApi.refresh();
    }
}
// Drive change detection: subst, USB, 
// Drive change detection: subst, USB, net use,
// mount… don't always emit a system event. We probe the
// signature only while the "Locations" panel is open;
// the bridge only rebuilds the sidebar if it changed (near-zero cost).
Timer {
    interval: 1500ms;
    running: SidebarApi.left-panel == 1;
    triggered => { SidebarApi.poll-drives(); }
}
// Cross-instance IPC init: shortly after startup (the window
// exists → HWND available for tagging + subclassing). RETRIES as long
// as the bridge returns `false` (window not found yet).
ipc-init-timer := Timer {
    interval: 250ms;
    running: true;
    triggered => { if (SidebarApi.init-ipc()) { ipc-init-timer.running = false; } }
}
// Re-checking unavailable tabs: active ONLY as long
// as at least one panel is; the bridge only tests `is_dir` if a
// drive/mount changed (non-blocking otherwise).
Timer {
    interval: 2s;
    running: SidebarApi.any-unavailable;
    triggered => { SidebarApi.recheck-unavailable(); }
}
// Closes the "Open with", "New", and Windows shell sub-menu cascade
// flyouts when neither the parent entry nor the flyout is hovered
// (small delay → tolerates passing through the gap between them).
FlyoutCloseTimer {
    open <=> MenuApi.mark-menu-open;
    parent-hover: PanelsApi.mark-parent-hover;
    flyout-hover: PanelsApi.mark-flyout-hover;
}
FlyoutCloseTimer {
    open <=> MenuApi.ow-menu-open;
    parent-hover: SettingsApi.ow-parent-hover;
    flyout-hover: SettingsApi.ow-flyout-hover;
}
FlyoutCloseTimer {
    open <=> MenuApi.new-menu-open;
    parent-hover: PanelsApi.new-parent-hover;
    flyout-hover: PanelsApi.new-flyout-hover;
}
FlyoutCloseTimer {
    open <=> MenuApi.ctx-shell-sub-open;
    parent-hover: MenuApi.ctx-shell-sub-parent-hover;
    flyout-hover: MenuApi.ctx-shell-sub-flyout-hover;
}

// ===== "Custom command" popup — rendered LAST =====
// Extracted to overlays/custom_command.slint; the forwards below are
// the whole contract with it (the form is two-way, the rest is read).
OverlayCustomCommand {
    strings: ApplicationApi.strings;
    platform-windows: SettingsApi.platform-windows;
    ow-popup-open <=> SettingsApi.ow-popup-open;
    ow-popup-focus-armed <=> SettingsApi.ow-popup-focus-armed;
    ow-popup-name <=> SettingsApi.ow-popup-name;
    ow-popup-program <=> SettingsApi.ow-popup-program;
    ow-popup-args <=> SettingsApi.ow-popup-args;
    ow-popup-elevated <=> SettingsApi.ow-popup-elevated;
    ow-popup-ctx-file <=> SettingsApi.ow-popup-ctx-file;
    ow-popup-ctx-dir <=> SettingsApi.ow-popup-ctx-dir;
    ow-popup-ctx-bg <=> SettingsApi.ow-popup-ctx-bg;
    ow-popup-ctx-ext <=> SettingsApi.ow-popup-ctx-ext;
    ow-popup-default-ext <=> SettingsApi.ow-popup-default-ext;
    ow-popup-used-ext <=> SettingsApi.ow-popup-used-ext;
    ow-popup-is-store: SettingsApi.ow-popup-is-store;
    ow-popup-preview: SettingsApi.ow-popup-preview;
    ow-popup-runs: SettingsApi.ow-popup-runs;
    ow-popup-valid: SettingsApi.ow-popup-valid;
    ow-popup-changed() => { SettingsApi.ow-popup-changed(); }
    ow-popup-commit() => { SettingsApi.ow-popup-commit(); }
    ow-browse() => { SettingsApi.ow-browse(); }
}

// ===== The note attached to an entry =====
// Extracted to overlays/notes.slint; it reads the `Note` global, so
// there is nothing to forward.
OverlayNoteBubble { }

// ===== GLOBAL tooltip — rendered VERY LAST → above
// everything (panels, popups). Position set by the hovered button (global Tip).
if Tip.text != "" : Rectangle {
    x: clamp(Tip.x, 4px, max(4px, parent.width - self.width - 4px));
    y: clamp(Tip.y, 4px, max(4px, parent.height - self.height - 4px));
    width: gtip.preferred-width + 14px;
    height: 24px;
    background: #1a1a1a;
    border-radius: 4px;
    drop-shadow-blur: 6px;
    drop-shadow-color: #00000066;
    gtip := Text {
        text: Tip.text;
        font-size: 11px;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

}
