    tab-empty-menu-panel: PanelsApi.tab-empty-menu-panel;
    tab-empty-menu-x: PanelsApi.tab-empty-menu-x;
    tab-empty-menu-y: PanelsApi.tab-empty-menu-y;
    duplicate-tab(p1, p2) => { PanelsApi.duplicate-tab(p1, p2); }
    fav-save-tab(p1, p2) => { SidebarApi.fav-save-tab(p1, p2); }
    tab-menu-open <=> PanelsApi.tab-menu-open;
    tab-menu-panel: PanelsApi.tab-menu-panel;
    tab-menu-tab: PanelsApi.tab-menu-tab;
    tab-menu-x: PanelsApi.tab-menu-x;
    tab-menu-y: PanelsApi.tab-menu-y;
